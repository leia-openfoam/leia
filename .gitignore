#
# git-ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.

# Editor and misc backup files - anywhere
*~
.*~
.*.swp
*.bak
*.bak[0-9][0-9]
\#*\#

# File-browser settings - anywhere
.directory

# Backup/recovery versions - anywhere
.#*

# Objects and archives - anywhere
*.[oa]
*.la
*.so

# Derived files
lex.yy.c

# Core dumps
core

# Dependency files - anywhere
*.dep

# lnInclude (symlink) directories - anywhere
lnInclude

# Build directories - anywhere
linux*Clang*/
linux*Gcc*/
linux*Icc*/
solaris*Gcc*/
SunOS*Gcc*/
platforms/

# Top-level build directories
build/
/platforms/

# Reinstate wmake rules that might look like build directories
!/wmake/rules/*/

# Doxygen generated (API docs live in docs/api now)
docs/api/html
docs/api/latex
docs/api/man
docs/api/DTAGS
docs/api/Doxygen.warnings

# Generated files in the main directory
/*.html

# Untracked configuration/preferences files
/etc/prefs.csh
/etc/prefs.sh
/etc/config.csh/prefs.*
/etc/config.sh/prefs.*
/wmake/rules/General/mplibUSER*

# Source packages - anywhere
*.tar.bz2
*.tar.gz
*.tar.xz
*.tar
*.tgz
*.gtgz

# Ignore tags or project files in the main directory
/.cproject
/.dir-locals.el
/.project
/.tags

# Ignore the test directory
/tutorialsTest

*polyMesh/
VTK/
[0-9].[0-9]*
[0-9]/
*.png
*.ogv
*.avi
PyFoam*
*.obj

.ipynb_checkpoints/
*.database
*_000*/
log.analyzed/
log
*.vtp
*.vtk
*.vtm
*.pdf
*.zip
*.csv
!cases/**/reference/*.csv
# editor / tool backups
*.backp
*.orig
*.bak
*~
processor*/
dynamicCode/
mpirun.schema
.ipynb_checkpoints/
*.hpcstruct
hpctoolkit-*measurements*/
hpctoolkit-*database*/
postProcessing/
dynamicCode/
processor*/

# vscode
.vscode/
.ccls-cache

# python
__pycache__

# leia Snakemake workflow: generated study outputs + local snakemake state
studies/
.snakemake/
.venv*/

# --- docs/<theme>/ thematic tree: TRACK the single data source, IGNORE built artifacts ---
# Each theme's results (figures + CSV tables) live in <theme>-article/data/ and ARE
# tracked so the deck + paper build WITHOUT re-running the studies -- re-include them
# past the global *.png / *.csv ignores above:
!docs/**/data/figures/*.png
!docs/**/data/figures/*.svg
!docs/**/data/tables/*.csv
# Compact per-step time series behind the divergence-mechanism figure (small,
# committed so sl_droplet_mechanism.png is reproducible without the heavy probe run):
!docs/**/data/mechanism/*.csv
# The built decks (self-contained *.html, several MB) and the compiled article PDFs
# regenerate in seconds from data/, so they are NOT tracked (keeps the repo small);
# the editable *.template.html sources stay tracked:
docs/**/*.html
!docs/**/*.template.html
# LaTeX build litter:
docs/**/*.aux
docs/**/*.log
docs/**/*.bbl
docs/**/*.blg
docs/**/*.out
docs/**/*.toc
docs/**/*.synctex.gz
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.spl


# Diagnostic study runs (kept in-repo for convenience, never committed)
/runs/

# Scratch area for throwaway gate/plot experiments
/tmp/

# Solver run logs. The bare "log" pattern above only catches a file called
# exactly "log"; OpenFOAM writes log.<application>, and the Allrun scripts of the
# variant-comparison cases write log.<application>.<variant>:
log.*

# ParaView case stubs and per-variant run output inside cases/ -- both are
# regenerated by the case's Allrun script, so they are outputs, not inputs:
*.foam
cases/**/results.variants/
cases/**/psi.redistanced.*

# Windows alternate-data-stream copy artifacts (appear when files are copied
# from Windows into WSL as "<name>:Zone.Identifier")
*:Zone.Identifier
