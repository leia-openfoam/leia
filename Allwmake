#!/usr/bin/env bash

# Every clone builds into its own <clone>/platforms/ (etc/leia-env.sh); the
# OpenFOAM etc/bashrc must already be sourced (WM_OPTIONS set).
. "$(cd "$(dirname "$0")" && pwd)/etc/leia-env.sh" || exit 1
# A stale monolithic library from before the split would be loaded next to the
# new ones; remove it wherever this build installs (no-op until the split lands).
echo "leia: installing into $WM_PROJECT_USER_DIR/platforms/$WM_OPTIONS"

g++ --version | head -n 1

WITH_BEAR=""
if bear --version; then
	WITH_BEAR="-with-bear"
fi

wmake $WITH_BEAR $1 src/levelSetImplicitSurfaces 
wmake $WITH_BEAR $1 src/functionObjects
"$(cd "$(dirname "$0")" && pwd)/etc/leia-stamp.sh" src/leiaLevelSet leiaLevelSet || exit 1
wmake $WITH_BEAR $1 src/leiaLevelSet
wmake $WITH_BEAR $1 src/finiteVolume

wmake $WITH_BEAR $1 all applications


