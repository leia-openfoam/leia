# =============================================================================
# leia level-set test-suite — KISS Snakemake workflow
#
#   generate_case  (local, python)  ->  one materialized OpenFOAM case / variation
#   mesh           (shell)          ->  blockMesh | pMesh | blockMesh+leiaPerturbMesh
#   decompose      (shell, ||-only) ->  decomposePar -force  (np from config)
#   solve          (shell)          ->  [mpi] leiaSetFields ; [init_End] ; [mpi] leiaLevelSetFoam
#   aggregate      (local, python)  ->  <study>_database.csv  (forces every case)
#
# mesh/decompose/solve share group "case" so the slurm executor submits exactly
# one sbatch per case. Switch backends with --workflow-profile only.
# =============================================================================
import os
import sys

REPO = os.path.abspath(os.path.join(workflow.basedir, ".."))
sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
import foam_param
import materialize
import aggregate
import plots
import export_html
import export_pdf
import paths   # thematic docs layout: theme -> data/figures, data/tables, presentation dir

configfile: os.path.join(REPO, "config", "config.yaml")

CASES_DIR   = os.path.join(REPO, "cases")
CASE        = config["case"]
MESH        = config["mesh"]
MODE        = config["mode"]
NP          = int(config["np"])
STUDY       = config["study_name"]
# The per-case application run after leiaSetFields; its CSV (<SOLVER>.csv) is the
# solve rule's output. Default: the advection solver. Alternative apps (e.g. the
# static extension verification leiaTestVelocityExtension) plug in per study.
SOLVER      = config.get("solver", "leiaLevelSetFoam")
# Which research line this study belongs to -> where its results are agglomerated.
# Explicit `theme:` in the config wins; otherwise inferred from the solver.
THEME       = paths.theme_of(SOLVER, config.get("theme"))
STUDIES_DIR = os.path.abspath(config.get("studies_dir", os.path.join(REPO, "studies")))
MPI         = config.get("mpi_launcher", "mpirun -np {np}")
PREAMBLE    = (config.get("env_preamble") or "").strip()
# Extra leiaSetFields arguments (e.g. "-alphaName alpha.water" for the two-phase
# mixture field, whose name is not the leiaSetFields default "alpha").
SETFIELDS_ARGS = (config.get("setfields_args") or "").strip()

assert MESH in ("hex", "perturbed", "poly"), f"bad mesh: {MESH}"
assert MODE in ("serial", "parallel"), f"bad mode: {MODE}"
PARALLEL = MODE == "parallel"
DIMS = 1 if CASE.startswith("1D") else (2 if CASE.startswith("2D") else 3)

if MESH == "poly":
    assert DIMS == 3, "poly mesh is only available for 3D cases"
    PARAM_FILE = os.path.join(CASES_DIR, f"{CASE}_poly.parameter")
else:
    PARAM_FILE = os.path.join(CASES_DIR, f"{CASE}.parameter")
BASE_CASE     = os.path.join(CASES_DIR, CASE)
DEFAULT_PARAM = os.path.join(CASES_DIR, "default.parameter")

AXES, CONSTANTS, IGNORED = foam_param.build_token_grid(
    PARAM_FILE, DEFAULT_PARAM, BASE_CASE,
    axes_override=config.get("axes_override"),
    collapse_other_axes=config.get("collapse_other_axes", False),
)
VARIATIONS = foam_param.expand(AXES, CONSTANTS)
IDX = [f"{i:05d}" for i in range(len(VARIATIONS))]

# Decomposition is scotch (graph-based): numberOfSubdomains = np, no coeffs and
# no factorisation constraint, so any np works for 2D or 3D meshes.
assert NP >= 1, "np must be >= 1"

STUDY_DIR = os.path.join(STUDIES_DIR, STUDY)
CASE_DIR  = os.path.join(STUDY_DIR, CASE + "_{idx}")
DATABASE  = os.path.join(STUDY_DIR, f"{STUDY}_database.csv")

# Results agglomeration (thematic single source): a study's figures + curated CSV
# tables land in ITS theme's data/ folder (docs/<theme>/<slug>-article/data/), which
# BOTH the reveal deck and the Elsevier article of that theme consume. The deck is
# rebuilt into ONE self-contained *.html next to its *.template.html.
PRES_DIR    = paths.presentation_dir(THEME)   # docs/<theme>/<slug>-presentation
FIGS_DIR    = paths.figs_dir(THEME)           # docs/<theme>/<slug>-article/data/figures
TABLES_DIR  = paths.tables_dir(THEME)         # docs/<theme>/<slug>-article/data/tables
DECK_TPL    = paths.deck_template(THEME)      # quadratic-semi-lagrangian-level-set.template.html | velocity-extension.template.html
REPORT      = os.path.join(STUDY_DIR, "figures", ".report.done")

wildcard_constraints:
    idx=r"\d{5}",

localrules: all, generate_case, aggregate, report, utilities, paraview_stub


def case_path(w):
    return os.path.join(STUDY_DIR, f"{CASE}_{w.idx}")


def sh(*lines):
    """Shell body: source OpenFOAM (lenient), then run the commands strictly."""
    pre = (PREAMBLE + "\n") if PREAMBLE else ""
    return "set +eu\n" + pre + "set -e\n" + "\n".join(lines)


# --- per-mesh command (chosen once per study) --------------------------------
if MESH == "hex":
    MESH_CMD = "blockMesh"
elif MESH == "poly":
    MESH_CMD = "pMesh"
else:  # perturbed
    MESH_CMD = "blockMesh\nleiaPerturbMesh\ncp -r 0/polyMesh/ constant/\nrm -rf 0/polyMesh"

# --- solve command (serial/parallel, perturbed flux, 3Dtranslation init_End) -
PAR        = "-parallel" if PARALLEL else ""
# MPI may contain a {np} placeholder (e.g. "mpirun -np {np}"); srun needs none
# because the slurm allocation already carries --ntasks (resources.tasks).
MPI_PREFIX = (MPI.format(np=NP) + " ") if PARALLEL else ""
FLUX       = " -fluxCorrection" if MESH == "perturbed" else ""
INIT_END   = f"./system/init_End/init_End.{MODE}" if CASE == "3Dtranslation" else ""

# The gradPsiErrorCSV / leiaSetFields function objects APPEND to their CSVs: a
# re-run of an interrupted case would otherwise stack a second time series onto
# the stale one (TIME jumps backward, plots and half-time extraction break).
# PREPROCESSING IS SERIAL, and runs BEFORE decomposePar -- the standard OpenFOAM
# order (blockMesh -> setFields -> decomposePar -> solver -> reconstructPar).
# Only the CFD solve is an MPI job; see the rule comments below.
_preprocess = ["cd {params.d}",
               "rm -f gradPsiError.csv leiaSetFields.csv leiaLevelSetFoam.csv"
               " leiaRedistancedLevelSetFoam.csv leiaTestRedistance.csv"
               " leiaTestFaceCurvature.csv leiaTestCurvatureNoiseGain.csv",
               " ".join(filter(None, ["leiaSetFields", SETFIELDS_ARGS]))]

_solve = ["cd {params.d}", f"rm -f {SOLVER}.csv .leia_solver_failed"]
if INIT_END:
    _solve.append(INIT_END)
# The curvature test app reads the SAME -alphaName flag as leiaSetFields (its
# default alpha.water fits the droplet cases; the 3D cases name the field
# "alpha") -- forward the study's setfields_args to it.
_solver_args = SETFIELDS_ARGS if SOLVER == "leiaTestMeanCurvature" else ""
_solver_cmd = " ".join(
    filter(None, [f"{MPI_PREFIX}{SOLVER}".strip(), _solver_args, PAR, FLUX.strip()]))
# A DIVERGED RUN IS A RESULT, NOT A WORKFLOW ERROR.
#
# `beta` (f_nl = beta - |grad psi|) relaxes towards g* = beta - a, which is the
# wrong target wherever the interface strains -- it is EXPECTED to blow up on
# the reversed vortex, and config/sdplsStability.yaml says so ("Divergent rows
# are RESULTS ... --keep-going"). But `aggregate` needs every case's CSV, so a
# single divergent arm used to leave the study with NO curated table at all.
#
# So: run the solver with its output captured per case, and on a non-zero exit
# record the code and ensure the output file exists. Nothing is swallowed --
# the exit code lands in .leia_solver_failed, the tail is echoed into the job
# log, the full log stays in the case directory, and aggregate.py emits a
# `solverFailed` column. An EMPTY csv is treated as absent by the aggregator,
# so the row appears with blank metrics instead of vanishing.
_solve += [
    "set +e",
    f"{_solver_cmd} > log.{SOLVER} 2>&1",
    "rc=$?",
    "set -e",
    # DISCRIMINATE: a launch failure is NOT a result.
    #
    # A diverged solver runs and then dies; a job that could not start its MPI
    # step never ran at all. Recording the latter as `solverFailed` would dress
    # an infrastructure fault as physics -- which is exactly what happened when
    # SLURM spread an np=8 allocation over two nodes and this branch logged six
    # "divergences" that were nothing of the kind. So: if the log carries a
    # launcher error, FAIL THE RULE LOUDLY (no marker, no touched output) and
    # let snakemake report it; otherwise record the exit code as a result.
    f"if [ $rc -ne 0 ]; then "
    f"if grep -qE 'Unable to create step|not enough slots|srun: error|mpirun.*(error|Error)' log.{SOLVER}; then "
    f"echo \"[leia] LAUNCH FAILURE (rc=$rc) -- the solver never ran; NOT recorded as a result:\"; "
    f"tail -15 log.{SOLVER}; exit $rc; "
    f"else "
    f"echo $rc > .leia_solver_failed; touch {SOLVER}.csv; "
    f"echo \"[leia] SOLVER EXITED $rc (diverged or crashed) -- recorded; tail of log.{SOLVER}:\"; "
    f"tail -15 log.{SOLVER}; fi; fi",
]
# The static gate measures kappa_f ACCURACY on an exact signed distance field.
# In the coupled solve psi is never exact, and MEASURED (plan sec. 10) accuracy
# does not predict coupled stability -- the two orders are inverted. The second
# number that does track the instability's growth rate is the GAIN, how far
# kappa_f moves per unit perturbation of psi, so the gate runs both apps on the
# same case and publishes both columns.
if SOLVER == "leiaTestMeanCurvature":
    _solve.append(
        " ".join(filter(None, ["leiaTestCurvatureNoiseGain", _solver_args])))
# Parallel runs write decomposed fields into processor*/; reconstruct them so the
# post-processing (foamlib montage) can read alpha at the case root. -withZero
# also reconstructs time 0 (default skips it), overwriting the uniform 0.org copy
# with the leiaSetFields-initialised field so the montage's initial contour is right.
# reconstructPar is SERIAL post-processing -> its own rule (see `reconstruct`).


onstart:
    print(f"[leia] study={STUDY} case={CASE} mesh={MESH} mode={MODE} np={NP}")
    print(f"[leia] axes={ {k: len(v) for k, v in AXES.items()} } -> {len(VARIATIONS)} variations")
    if IGNORED:
        print(f"[leia] ignored params (not in templates): {IGNORED}")


rule all:
    input:
        DATABASE,
        REPORT,
        expand(os.path.join(CASE_DIR, CASE + "_{idx}.foam"), idx=IDX),


rule generate_case:
    output:
        os.path.join(CASE_DIR, "case_params.json"),
    run:
        materialize.materialize(
            BASE_CASE, VARIATIONS[int(wildcards.idx)],
            os.path.dirname(output[0]),
            NP, MESH, MODE, DIMS, CASE, wildcards.idx,
        )


rule mesh:
    input:
        os.path.join(CASE_DIR, "case_params.json"),
    output:
        os.path.join(CASE_DIR, "constant", "polyMesh", "owner"),
    params:
        d=case_path,
    resources:
        tasks=1,
    group:
        "case_pre"
    shell:
        sh("cd {params.d}",
           "rm -rf 0 && cp -r 0.org 0",
           "find 0 -name '*.template' -delete 2>/dev/null || true",
           MESH_CMD)


# Field initialisation: SERIAL, on the undecomposed case. Running it before
# decomposePar (rather than as an MPI step afterwards) is both the standard
# OpenFOAM order and free of parallel artefacts -- the signed distance and the
# narrow band are built without any processor-boundary exchange.
rule preprocess:
    input:
        os.path.join(CASE_DIR, "constant", "polyMesh", "owner"),
    output:
        touch(os.path.join(CASE_DIR, ".leia_preprocessed")),
    params:
        d=case_path,
    resources:
        tasks=1,
    group:
        "case_pre"
    shell:
        sh(*_preprocess)


if PARALLEL:

    # Domain decomposition: SERIAL. Distributes the already-initialised fields.
    rule decompose:
        input:
            os.path.join(CASE_DIR, ".leia_preprocessed"),
        output:
            os.path.join(CASE_DIR, "processor0", "constant", "polyMesh", "owner"),
        params:
            d=case_path,
        resources:
            tasks=1,
        group:
            "case_pre"
        shell:
            sh("cd {params.d}", "decomposePar -force")


# THE ONLY PARALLEL RULE, and deliberately UNGROUPED.
#
# Grouping it with the serial steps made snakemake submit one sbatch for the
# whole group, whose allocation did not reliably carry the solve's tasks={np}:
# the inner jobstep then failed with "srun: error: Unable to create step ...
# More processors requested than permitted" (or, with mpirun, "not enough
# slots"). Ungrouped, the solve is its own sbatch with --ntasks={np}, so the
# launcher always has exactly the ranks it asks for.
rule solve:
    input:
        (os.path.join(CASE_DIR, "processor0", "constant", "polyMesh", "owner")
         if PARALLEL else
         os.path.join(CASE_DIR, ".leia_preprocessed")),
    output:
        os.path.join(CASE_DIR, f"{SOLVER}.csv"),
    params:
        d=case_path,
    resources:
        tasks=(NP if PARALLEL else 1),
        # ONE NODE. SLURM was satisfying --ntasks=8 across TWO nodes, leaving the
        # batch step with only 7 CPUs, so `srun --ntasks=8` inside it failed with
        # "Unable to create step ...: More processors requested than permitted".
        # Measured allocations before this: 8, 7, 6, 5 and 4 CPUs for the same
        # np=8 rule. The ranks must share a node for the jobstep to be creatable.
        #
        # This MUST be the plugin's own `nodes` resource, not slurm_extra: the
        # executor rejects --nodes there outright ("The --number-of-nodes option
        # is not allowed in the 'slurm_extra' parameter"), and the rejection is a
        # submission-time exception, so no solve job is created at all.
        **({"nodes": 1} if PARALLEL else {}),
    shell:
        sh(*_solve)


if PARALLEL:

    # Field reconstruction: SERIAL post-processing. -withZero also reconstructs
    # time 0 (default skips it), overwriting the uniform 0.org copy with the
    # leiaSetFields-initialised field so a montage's initial contour is right.
    rule reconstruct:
        input:
            os.path.join(CASE_DIR, f"{SOLVER}.csv"),
        output:
            touch(os.path.join(CASE_DIR, ".leia_reconstructed")),
        params:
            d=case_path,
        resources:
            tasks=1,
        group:
            "case_post"
        shell:
            sh("cd {params.d}", "reconstructPar -withZero")


# ParaView case marker, named after the CASE FOLDER so tabs are identifiable
# across a study's variations (2Dvortex_00009.foam, not 2Dvortex.foam).
# Depends on the solver CSV: the stub appears once the case has results.
# materialize.py writes the same stub at generation time for new cases; this
# rule backfills studies materialised before that and is a no-op otherwise.
rule paraview_stub:
    input:
        os.path.join(CASE_DIR, f"{SOLVER}.csv"),
    output:
        os.path.join(CASE_DIR, CASE + "_{idx}.foam"),
    resources:
        tasks=1,
    group:
        "case_post"
    shell:
        "touch {output}"


rule aggregate:
    input:
        expand(os.path.join(CASE_DIR, f"{SOLVER}.csv"), idx=IDX),
        # Reconstruction must finish before `report` reads the cases: report
        # depends on DATABASE, so the dependency belongs here.
        *([expand(os.path.join(CASE_DIR, ".leia_reconstructed"), idx=IDX)]
          if PARALLEL else []),
    output:
        DATABASE,
    run:
        case_dirs = [os.path.join(STUDY_DIR, f"{CASE}_{i}") for i in IDX]
        aggregate.build_database(case_dirs, output[0])


# --- agglomerate results into the theme's data/ + rebuild the theme deck --------
#   A study's results are collected into ITS theme's single data source:
#     - curated error table   -> data/tables/<study>_errors.csv
#     - figures (montages,     -> data/figures/  (foamlib reads the cases; matplotlib
#       convergence, iso-surf)     writes the PNGs the deck + article both consume)
#   then the theme's self-contained deck is rebuilt (figures inlined). export_slides
#   is honoured for secondary comparison studies (figures stay in the study dir only).
rule report:
    input:
        DATABASE,
    output:
        touch(REPORT),
    run:
        import glob as _glob, shutil as _shutil, subprocess as _sp
        _scripts = os.path.join(workflow.basedir, "scripts")
        # RUN THE FIGURE/TABLE SCRIPTS ON SNAKEMAKE'S OWN INTERPRETER, not on
        # whatever `python3` PATH happens to resolve to. On Lichtenberg there
        # are three: the module python snakemake itself runs on (numpy,
        # matplotlib, foamlib -- but no vtk), ~/miniconda3 (none of them, and
        # FIRST on PATH in a login shell), and /usr/bin/python3 (numpy only).
        # `env_preamble` does `module purge`, so inside a job a bare "python3"
        # picked an interpreter without numpy and every figure script died on
        # ImportError -- silently, because these calls pass check=False.
        _PY = sys.executable
        def _run(args, what):
            """Run a helper script and SAY SO when it fails. A silent no-op here
            is how the SDPLS theme ended up with an empty figures directory."""
            rc = _sp.run(args, check=False).returncode
            if rc != 0:
                print(f"[report] {what} FAILED (rc={rc}); "
                      f"figures/tables from it were NOT produced", file=sys.stderr)
            return rc
        # 1. curated error table -> theme data/tables. The generic advection
        # error table is meaningless for the static curvature test app (every
        # metric column blank, solver misattributed by the fallback label) --
        # its studies publish their own face_curvature_orders/curvature_error
        # tables instead.
        if SOLVER != "leiaTestMeanCurvature":
            for _csv in _glob.glob(os.path.join(STUDY_DIR, f"{STUDY}_errors.csv")):
                _shutil.copy(_csv, TABLES_DIR)
        # 1b. The SDPLS convergence + order tables are a DATA product that
        # docs/sdpls-level-set/.../sdplsLevelSet.tex \input{}s, not a slide, so
        # they must not sit behind `export_slides` -- 89 of 117 study configs set
        # that to false (it means "this is a secondary study, do not publish its
        # figures"), which is exactly why phase 2 had to build these tables by
        # hand and why `make studies-sdpls` did not reproduce them.
        # make_convergence_table.py refuses to overwrite the published tables
        # from an incomplete study set, so running it after every SDPLS study is
        # safe: it is a no-op until the whole suite is on disk.
        if THEME in ("sdpls-level-set", "method-comparison") \
                and SOLVER != "leiaTestMeanCurvature":
            _run([_PY, os.path.join(_scripts, "make_convergence_table.py"),
                     "--method", "sdpls"], "make_convergence_table.py")
        # The two semi-Lagrangian METHOD LINES are independent methods sharing the
        # kinematic figure scripts: each line has its own theme, study set and
        # figure prefix (sl_* / lsl_*), selected via --method / --theme.
        _SL_THEMES = {"semi-lagrangian-level-set": "quadratic",
                      "linear-semi-lagrangian-level-set": "linear"}
        if config.get("export_slides", True):
            # 2. theme-specific figures -> theme data/figures
            if THEME in _SL_THEMES:
                _method = _SL_THEMES[THEME]
                if SOLVER == "leiaSemiLagrangianLevelSetTwoPhaseFoam":
                    if config.get("study_kind") == "dropletFields":
                        # field-visualisation job: velocity-glyph-over-alpha + curvature
                        # montages across resolution (mesh drawn on every panel).
                        _run([_PY, os.path.join(_scripts, "make_droplet_fields_fig.py"),
                                 STUDY_DIR], "make_droplet_fields_fig.py")
                    else:
                        # parasitic-current CONVERGENCE study: table + log-log figure.
                        _run([_PY, os.path.join(_scripts, "make_droplet_table.py"),
                                 STUDY_DIR], "make_droplet_table.py")
                elif SOLVER == "leiaTestMeanCurvature":
                    # curvature-accuracy study: band L1/L2 error table + log-log figure.
                    _run([_PY, os.path.join(_scripts, "make_curvature_table.py"),
                             STUDY_DIR], "make_curvature_table.py")
                else:
                    # cross-study convergence triptychs + all-errors diagnostics +
                    # curated tables for THIS method line (idempotent, skip-missing),
                    # + per-study psi=0 iso-surface montage (3D cases) and the
                    # volume-fraction field montage (2D vortex).
                    for _s in ("make_sl_3d_fig.py", "make_convergence_table.py"):
                        _run([_PY, os.path.join(_scripts, _s),
                              "--method", _method], _s)
                    if CASE in ("3Dshear", "3Ddeformation"):
                        _run([_PY, os.path.join(_scripts, "make_isosurface_fig.py"),
                                 STUDY_DIR, "--theme", THEME], "make_isosurface_fig.py")
                    if CASE == "2Dvortex":
                        _run([_PY, os.path.join(_scripts, "make_alpha_field_fig.py"),
                                 STUDY_DIR, "--theme", THEME], "make_alpha_field_fig.py")
            elif THEME == "geometrically-redistanced-levelset":
                if SOLVER == "leiaTestRedistance":
                    # STATIC redistancing gates: convergence table + log-log
                    # figure from the study database; the idempotency gate
                    # (exact-SDF input) additionally renders per-model FIELD
                    # plots (zero sets + |psi_out - psi_in| maps).
                    _run([_PY, os.path.join(_scripts, "make_redistance_table.py"),
                             STUDY_DIR], "make_redistance_table.py")
                    if config.get("study_kind") == "staticIdempotency":
                        _run([_PY,
                              os.path.join(_scripts, "make_redistance_fields_fig.py"),
                              STUDY_DIR], "make_redistance_fields_fig.py")
                else:
                    # advection studies: per-redistancer convergence figures +
                    # curated order tables from the theme's *_errors.csv.
                    _run([_PY, os.path.join(_scripts, "make_grl_fig.py")], "make_grl_fig.py")
                    if CASE in ("3Dshear", "3Ddeformation"):
                        _run([_PY, os.path.join(_scripts, "make_isosurface_fig.py"),
                                 STUDY_DIR], "make_isosurface_fig.py")
            elif THEME in ("sdpls-level-set", "method-comparison"):
                if SOLVER == "leiaTestMeanCurvature":
                    # FACE-CENTERED curvature convergence (static circle): the
                    # kappa_f the CSF force applies, all models, with/without
                    # the stabilized foot point -> figure + order table.
                    _run([_PY, os.path.join(_scripts, "make_face_curvature_fig.py"),
                             STUDY_DIR], "make_face_curvature_fig.py")
                    # ... and the companion GAIN table: d kappa_f / d psi on the
                    # same faces, the number that tracks the coupled growth rate.
                    _run([_PY, os.path.join(_scripts, "make_curvature_gain_table.py"),
                             STUDY_DIR], "make_curvature_gain_table.py")
                else:
                    # method-decision benchmark: cross-study comparison panels,
                    # cost-vs-accuracy, decision table + per-method field atlases.
                    # make_method_comparison.py globs the benchVortex* studies
                    # and publishes into the method-comparison theme, so it must
                    # NOT be driven from an sdpls-level-set study -- that would
                    # rewrite another theme's figures from whatever subset of
                    # benchVortex* happens to be on this machine.
                    if THEME == "method-comparison":
                        _run([_PY, os.path.join(_scripts, "make_method_comparison.py")], "make_method_comparison.py")
                    # Same scoping rule for the field atlases: pass the study
                    # glob for THIS theme so an sdpls run cannot rewrite the
                    # method-comparison atlases (and vice versa) from a partial
                    # set of the other theme's studies.
                    _atlas_glob = os.path.join(
                        STUDIES_DIR,
                        "sdplsBetaSweep" if THEME == "sdpls-level-set" else "benchVortex*")
                    _run([_PY, os.path.join(_scripts, "make_bench_fields_fig.py"),
                             _atlas_glob], "make_bench_fields_fig.py")
                    # 3D SDPLS studies had NO field figure at all. One psi=0
                    # iso-surface montage per method arm, so the 3D interface is
                    # inspectable the way the 2D atlases make the 2D one.
                    if CASE in ("3Dshear", "3Ddeformation"):
                        _run([_PY, os.path.join(_scripts, "make_isosurface_fig.py"),
                                 STUDY_DIR, "--theme", THEME], "make_isosurface_fig.py")
            else:
                # velocity-extension: field montages + convergence figures.
                plots.main(STUDY_DIR, FIGS_DIR)
            # 3. dual-copy: mirror the article data/ into the presentation data/
            # (dual-copy themes only), so slides + article stay consistent.
            paths.propagate(THEME)
            # 4. rebuild THIS theme's self-contained deck (figures inlined from data/)
            export_html.export(PRES_DIR, DECK_TPL)
        else:
            plots.main(STUDY_DIR, "")
            # keep the presentation-side data mirror current even when the deck
            # rebuild is skipped (the errors.csv above landed in the article data/).
            paths.propagate(THEME)


# --- optional: non-parametric utility tests (1D/2D), run on demand -----------
#   snakemake --workflow-profile profiles/local utilities
# (needs the leiaTestRedistance / leiaTestGradScheme apps built by ./Allwmake)
UTILITY = {"1DredistanceTest": "leiaTestRedistance", "2DgradTest": "leiaTestGradScheme"}

rule utilities:
    input:
        [os.path.join(STUDIES_DIR, "utility", u, f"{u}.ok") for u in UTILITY]

rule utility:
    output:
        os.path.join(STUDIES_DIR, "utility", "{ucase}", "{ucase}.ok"),
    wildcard_constraints:
        ucase="|".join(UTILITY),
    params:
        src=lambda w: os.path.join(CASES_DIR, w.ucase),
        d=lambda w: os.path.join(STUDIES_DIR, "utility", w.ucase),
        tool=lambda w: UTILITY[w.ucase],
    shell:
        sh("rm -rf {params.d} && mkdir -p {params.d}",
           "cp -r {params.src}/. {params.d}/",
           "cd {params.d}",
           "rm -rf 0 && cp -r 0.org 0",
           "blockMesh",
           "leiaSetFields",
           "{params.tool}",
           "touch {wildcards.ucase}.ok")
