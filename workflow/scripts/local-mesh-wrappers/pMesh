#!/usr/bin/env bash
# jemalloc-preloading wrapper for cfMesh's pMesh -- LOCAL WORKAROUND, scoped.
#
# WHY: on this laptop (Ubuntu 24.04, glibc 2.39) cfMesh aborts on EVERY input
# with `free(): invalid pointer`; under a preloaded jemalloc it runs to
# completion and the meshes check out (max non-orthogonality ~60 deg, avg 4.2).
#
# WHY A WRAPPER AND NOT env_preamble: the preamble is study-global, so exporting
# LD_PRELOAD there also injects jemalloc into the MPI SOLVER, which SEGFAULTS it
# instantly (measured 2026-08-27: rc 139, empty solver log, no FOAM banner --
# a failure that reads exactly like a diverged run but is a launch failure).
# Scoping the preload to the mesher is what lets one `snakemake` invocation both
# mesh and solve. Put this directory FIRST in PATH:
#
#   env_preamble: "source $HOME/OpenFOAM/OpenFOAM-v2512/etc/bashrc; \
#                  export PATH=$PWD/workflow/scripts/local-mesh-wrappers:$PATH"
#
# (the Snakefile runs the preamble with cwd = repo root, before cd-ing into the
# case, so $PWD resolves correctly).
#
# SUPERSEDED 2026-09-01 -- READ THIS BEFORE USING THIS WRAPPER.
#
# On 2026-08-31 this file was edited to say the preload IS needed on the cluster.
# That edit was itself based on a wrong diagnosis and is now superseded: the
# abort is an UPSTREAM BUG IN CFMESH MASTER, not a platform property.
#
# Located: gdb put the abort in meshSurfaceMapper::preMapVertices; valgrind
# showed a free of a pointer 8 bytes INSIDE a block allocated by
# List<labelledPointScalar> -- the post-cookie pointer of an array new[]. It
# reaches only pMesh because preMapVertices uses DynList<scalar,6> and only
# Voronoi faces exceed six vertices; Cartesian quads never take the heap path,
# which is why cartesianMesh was always fine.
#
# THE FIX IS THE FIXED SOURCE. cfMesh `development` (b7d96fb) compiles clean and
# runs the identical case UNWRAPPED -- rc 0, no abort, mesh produced -- on both
# glibc 2.34 (cluster) and the laptop. Build that branch and this wrapper is
# unnecessary everywhere. On Lichtenberg it is installed at
# $HOME/OpenFOAM/cfmesh and linked into the session tree; profiles/slurm no
# longer references this wrapper at all.
#
# KEEP THIS FILE only for a laptop still running a cfMesh MASTER build. jemalloc
# does not fix the bug; it tolerates it. Prefer upgrading cfMesh.

set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve the REAL pMesh, with this wrapper's directory removed from PATH.
real="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd:)" \
        command -v pMesh)"
if [ -z "${real:-}" ]; then
    echo "pMesh wrapper: no real pMesh on PATH" >&2
    exit 127
fi
jem="${LEIA_JEMALLOC:-$HOME/miniconda3/lib/libjemalloc.so.2}"
if [ ! -f "$jem" ]; then
    echo "pMesh wrapper: jemalloc not found at $jem; running unwrapped" >&2
    exec "$real" "$@"
fi
exec env LD_PRELOAD="$jem" "$real" "$@"
