FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Present for completeness only: leiaTestSdplsSource never calls solve().
    // The assembled system is diagonal (ddt + a cellwise source), so the
    // update is read directly as source/diag -- which keeps the assertion on
    // the DISCRETIZATION rather than on a linear solver tolerance.
    psi
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
}

// The test constructs sdplsR / sdplsBeta directly with an in-code dictionary,
// so it is independent of this sub-dictionary. It is kept here so the case is
// a valid leia level-set case and can be reused for manual experiments.
levelSet
{
    sdplsSource
    {
        type            R;
        beta            1.3;
        discretization  simpleLinearImplicit;
    }
}

