FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // Euler, NOT CrankNicolson: leiaTestSdplsSource asserts the exact
    // one-step implicit-Euler update against a closed form.
    default         Euler;
}

gradSchemes
{
    // The SDPLS source path. leastSquares is linear-exact, so on the affine
    // test fields grad(psi) and grad(U) carry no truncation error and the
    // measured source coefficient is exactly n.(grad U).n.
    gradPsiSdpls    leastSquares;
    gradUSdpls      leastSquares;
    gradPsiMetric   leastSquares;
    default         leastSquares;
}

divSchemes
{
    // The unit test assembles ddt + source only; there is no advective term.
    default         none;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

