values
{
    PHASE_INDICATOR ( detrixheAslam geometric );

    solver (leiaLevelSetFoam);

    CFL ( 0.5 );

    N_CELLS
    (
        32 64 128
    );

    // Interface-normal velocity extension used to advect psi.
    VELOCITY_EXTENSION
    (
        none
        anisotropicDiffusion
        pseudoTime
    );

    SOURCE_SCHEME
    (
        explicit
        simpleLinearImplicit
        strictNegativeSpLinearImplicit
    );

    SDPLS_SOURCE
    (
        noSource
        R
        beta
    );

    BC
    (
        zeroGradient
    );

    DIV
    (
        linear
        $LinearUpwind
        vanLeer
        $Gamma1
        MUSCL
        Minmod
        OSPRE
        SFCD
        SuperBee
        UMIST
        vanAlbada
        upwind
    );

    TANH_LIMIT
    (
        0.1
    );

    PROFILE
    (
        signedDistance
        tanh
    );

    // The interface (problem data, 2026-11-14): implicitSphere (radius SURFACE_R) or
    // signedDistanceEllipse (semi-axes SURFACE_A, SURFACE_B). Default = the historical circle.
    SURFACE_TYPE ( implicitSphere );
    SURFACE_X0 ( 0.5 );
    SURFACE_Y0 ( 0.75 );
    SURFACE_R ( 0.15 );
    SURFACE_A ( 0.15 );
    SURFACE_B ( 0.15 );
}
