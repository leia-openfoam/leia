FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Multi-word scheme aliases (UpwindUext, LinearUpwindUext, ...) selected by
// single-word study tokens (UEXT_DIV).
#include "aliasDict"

ddtSchemes
{
    default         CrankNicolson 1;
}

gradSchemes
{
    default         Gauss linear;
    grad(p)         Gauss linear;
    // Cell-limited least-squares gradient used by the linearUpwind advection of
    // psi below (deferred second-order correction). Fallbacks if it mislimits on
    // the coarse vortex: "faceLimited leastSquares 1" or "cellLimited Gauss linear 1".
    grad(psi)       cellLimited leastSquares 1;
    // Reconstruction gradient for the linearUpwind steady velocity extension.
    grad(Uext)      leastSquares;
    // Pure least-squares gradient for the Aslam cascade's normal derivative
    // V = n.grad(U) (steadyUpwindLinear).
    velExtLSGrad    leastSquares;
    // Semi-Lagrangian reconstruction (leiaSemiLagrangeLevelSetFoam): dedicated
    // gradient keys so the sub-steps are unambiguous and never share the
    // grad(psi) advection scheme. pointCellsLeastSquares = the cell-point-cell
    // (point-neighbour) LSQ gradient, linear-exact on arbitrary stencils
    // (nested => quadratic-exact => O(h^2)); parallel- and 2D-safe.
    gradPsi         pointCellsLeastSquares;   // g_c = grad(psi^n)
    gradGradPsi     pointCellsLeastSquares;   // H_c = grad(g_c) (nestedLSQ)
    gradU           Gauss linear;   // grad(u^{n+1}) for the SL foot (Gauss linear: no run-long LSQ cache)
}

divSchemes
{
    default         none;
    // Second-order linear-upwind advection of the level set; the deferred
    // correction (linearUpwind - upwind) is converged by the nDefCorr loop in
    // leiaLevelSetFoam.C. (phiExt is named "phi", so this key covers it.)
    div(phi,psi)    Gauss linearUpwind grad(psi);
    // Steady velocity extension (steadyUpwind family). The study token
    // UEXT_DIV selects UpwindUext (first order, O(h) extension) or
    // LinearUpwindUext (deferred second-order correction converged by the
    // nDefCorrExt loop, O(h^2) extension) via the aliasDict expansion.
    div(velExtPhiW,Uext) Gauss $@!UEXT_DIV!@;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

fluxRequired
{
    p;
}

// ************************************************************************* //
