FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    psi
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0;
    }

    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0.;
    }

    // Velocity-extension solve: PER-MODEL solver settings, selected through the
    // materialized VELOCITY_EXTENSION token + OpenFOAM dictionary expansion
    // (same $-alias mechanism as fvSchemes). One size does not fit both:
    //  * anisotropicDiffusion: SYMMETRIC near-rank-1 Laplacian D = n(x)n+eps*I.
    //    The key is the per-step RELATIVE tolerance (previous Uext = initial
    //    guess): demanding 1e-9 absolute needed ~430 DIC iterations/solve and
    //    multigrid stalls/overheads made it worse (standalone GAMG hits the
    //    iteration cap; a GAMG preconditioner rebuilds its coarse hierarchy
    //    every solve). Cheap DIC iterations to relTol 1e-4 reproduce the fully
    //    converged errors to 4 digits at ~300 iterations max (A/B validated).
    //  * pseudoTime: ASYMMETRIC, diagonally dominant (Sp(rDtau) + upwind) ->
    //    DILU converges in ~3 iterations with zero setup.
    anisotropicDiffusionUext
    {
        solver          PBiCGStab;
        preconditioner  DIC;    // symmetric matrix -> symmetric preconditioner
        tolerance       1e-09;
        relTol          1e-4;
        maxIter         2000;
    }

    pseudoTimeUext
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-3;
    }

    // Steady normal-transport solve (steadyUpwind family): near-triangular
    // upwind matrix along the acyclic characteristic graph -> DILU/BiCGStab
    // converges in a handful of iterations; per-pass relTol (defect-correction
    // loop re-solves with the improved deferred correction).
    steadyUpwindUext
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-4;
        maxIter         500;
    }

    steadyUpwindLinearUext { $steadyUpwindUext }
    closestPointUext       { $steadyUpwindUext }   // fallback fill solve
    meshWaveUext           { $steadyUpwindUext }   // never solved (wave only)
    noneUext               { $pseudoTimeUext }     // identity model: never solved

    "Uext.*" { $@!VELOCITY_EXTENSION!@Uext; }

    // anchoredEikonal redistancer fill solve (leiaRedistancedLevelSetFoam):
    // ASYMMETRIC advection-diffusion linearization -> PBiCGStab/DILU
    // (never PCG/DIC).
    "psiDist.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-4;
        maxIter         500;
    }
}

PISO
{
    nCorrectors     -1; // Disables p-v coupling.
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

// Classical single (shear) vortex. oscillation on: reversed by cos(pi t / tau),
// tau defaults to endTime so the interface returns to its initial shape at
// t = endTime. oscillation off: STEADY vortex -- sustained strain, no error
// cancellation on the way back (the non-reversing stress test).
velocityModel
{
    type shear2D;
    oscillation @!OSCILLATION!@;
}

levelSet
{
    // Advection method: how psi^n becomes psi^{n+1} (unified solver).
    reportAtWriteTimesOnly @!REPORT_WRITE_ONLY!@;

    advection
    {
        type @!ADVECTION!@;   // eulerian | semiLagrangian
    }

    narrowBand
    {
      type  signChange;
    }


    profile
    {
      type  @!PROFILE!@;
      limit  @!TANH_LIMIT!@;  // tanh profile ONLY -- signedDistance ignores it
    }


    // Bulk interface: circle of radius 0.15 centred at (0.5, 0.75).
    implicitSurface
    {
        type implicitSphere;
        center (0.5 0.75 0);
        radius 0.15;
    }

    phaseIndicator
    {
        type @!PHASE_INDICATOR!@;
    }

    redistancer
    {
        type                @!REDISTANCER!@;
        trigger             @!REDIST_TRIGGER!@;
        threshold           @!REDIST_THRESHOLD!@;
        redistanceInterval  @!REDIST_INTERVAL!@;
        gradBound           @!REDIST_GRADBOUND!@;
        bandViolationFraction @!REDIST_VIOLFRAC!@;
        criterionRegion     @!REDIST_REGION!@;
        freezeBand          @!REDIST_FREEZE!@;
        anchorLayers        @!REDIST_ANCHOR_LAYERS!@;
        // PDE baseline (ignored by the geometric models): mesh-relative
        // pseudo-time step -- the explicit reinit equation is CFL-limited
        // by h, a fixed deltaT stable on one mesh diverges on finer ones
        // (measured: deltaT 0.1 at h = 1/64 -> band error 7.5e6). 30 steps
        // of 0.5h reinitialize the trigger's 6h band.
        deltaTCoeff 0.5;
        hamiltonian @!REDIST_HAMILTONIAN!@;
        niterations @!REDIST_NITER!@;
        write       false;
        // anchoredEikonal fill budget: the frozen-direction Tucker
        // iteration plateaus if stopped early (measured: maxIter 10 left
        // the band WORSE than pre-event).
        epsilon     0.1;
        tolerance   1e-4;
        maxIter     100;
    }

    sdplsSource
    {
        type @!SDPLS_SOURCE!@;
        beta            @!SDPLS_BETA!@;  // sdplsBeta only: f_nl = beta - |grad psi|
        discretization @!SOURCE_SCHEME!@;

        // Cut-off (mollifier) that forces f_nl to zero away from the interface.
        // This is eq. (24) of the SDPLS preprint (arXiv:2208.01269): G is unity
        // on |psi| <= w1, decays as exp(-ln(1000) (|psi|-w1)^2/(w2-w1)^2) beyond
        // it, and is EVEN in psi. Both properties matter:
        //   - even, and flat at psi = 0, so the cut-off adds no variation of the
        //     effective source coefficient ACROSS the interface cell. That
        //     variation is what displaces the discrete zero crossing, so a
        //     taper with a kink at psi = 0 would introduce interface motion the
        //     source is specifically designed not to have.
        //   - w1, w2 are PHYSICAL lengths, not multiples of h. Scaling them
        //     with the mesh would make the modified PDE mesh-dependent, and a
        //     convergence order over such a ladder is not the order of anything.
        //
        // Without it the source acts wherever psi is large and the strain does
        // not cancel, and amplifies psi in proportion to itself: measured on the
        // 2D steady vortex, global max ||grad psi|-1| reaches 119.6 at N=256 and
        // GROWS under refinement (order -1.44) while the band stays controlled.
        // `none` reproduces every study run before 2026-08.
        mollifier
        {
          type    @!MOLLIFIER!@;
          w1      @!SDPLS_W1!@;
          w2      @!SDPLS_W2!@;
        }
    }

    // Runtime-selectable interface-normal velocity extension used to advect psi.
    //   none | anisotropicDiffusion | pseudoTime
    velocityExtension
    {
        type        @!VELOCITY_EXTENSION!@;
        nLayers     3;
        // Foot-point + pin this many additional cell layers around the
        // interface layer (Dirichlet anchors; 0 = interface layer only).
        nAnchorLayers @!ANCHOR_LAYERS!@;
        // anisotropicDiffusion regularization: eps_c = epsilon*cellSize_c
        // (min face-neighbour centre distance -- NOT cbrt(V), which
        // mis-scales on 2D meshes; epsilonModel cellSize -> O(h)-consistent;
        // a FIXED eps imposes an h-independent error floor -- 'fixed' keeps
        // the legacy behaviour).
        epsilon      1.0;
        epsilonModel cellSize;
        nIterations 10;        // pseudoTime
        deltaTau    0.2;       // pseudoTime
        nDefCorrExt 5;         // steadyUpwind family: relaxed defect-correction passes
        // closestPoint parallel halo (zoneDistribute): Taylor data from the
        // one-layer CPC halo is trusted within cpHaloReach*cellSize of the
        // exit cell; foot points beyond it fall back to the steadyUpwind fill.
        cpHaloReach 1.5;
        // NO Helmholtz projection: projecting phiExt to div-free would destroy
        // the interface-normal constancy (n.grad)Uext = 0 that preserves
        // |grad psi| = 1 near Sigma. The psi equation is instead solved in its
        // ADVECTIVE form (ddt + div(phiExt,psi) - psi*div(phiExt)), which is
        // exact for non-solenoidal extension velocities (leiaLevelSetFoam.C).
        projectFlux false;
        maxScale    5;         // clip |Uext| <= maxScale*max|U| in the band (runaway guard)
    }

    // ===================================================================== //
    // Semi-Lagrangian advection (leiaSemiLagrangeLevelSetFoam only; ignored by
    // leiaLevelSetFoam). psi^{n+1}(x_c) = psi^n(x_d): a fixed Taylor backward
    // foot x_d, a runtime-selectable reconstruction of psi^n at x_d, applied by
    // a runtime-selectable correction strategy. All selectable options and their
    // controls are listed below; unset keys fall back to the defaults shown.
    // ===================================================================== //
    semiLagrangian
    {
        // ---- reconstruction of psi^n at the foot (RTS slReconstruction) ----
        // 2x2 taxonomy: {linear, quadratic} x {Taylor = field-diff, WLSQ = value-fit}.
        //   linearTaylor                      : psi_c + grad_c.(x-x_c), grad_c=fvc::grad(psi).
        //                                       O(h) baseline; |grad psi| drifts (field
        //                                       differentiation injects a gradient).
        //   quadraticTaylor  (was nestedLSQ)  : psi_c + grad_c.d + 1/2 d.H.d, grad_c and
        //                                       H=fvc::grad(grad_c) from field differentiation.
        //                                       O(h^2) but CONDITIONALLY stable: the grad-of-grad
        //                                       Hessian amplifies 2h-mode noise -> |grad psi|
        //                                       runaway on fine meshes unless clipToStencilBounds.
        //   linearWeightedLeastSquares        : IDW-weighted LINEAR VALUE fit over the stencil.
        //                                       O(h), STABLE BY CONSTRUCTION (no field diff, the
        //                                       fit is bounded by the stencil data range), no clip
        //                                       needed, CFL-independent. NO curvature (H==0) -> a
        //                                       two-phase run must take curvature from the FVM path.
        //   quadraticWeightedLeastSquares     : IDW-weighted quadratic VALUE fit. O(h^2..3),
        //                                       STABLE. PRODUCTION. Memory-bound (caches a
        //                                       per-cell pseudo-inverse).
        //   uncachedQuadraticWeightedLeastSquares : the SAME fit as quad (identical accuracy
        //                                       + stability, verified cell-for-cell) but
        //                                       recomputes the small normal-equations Cholesky
        //                                       per step -> CPU-bound, O(1) memory/cell, no
        //                                       large-N memory ceiling, better strong scaling.
        //   bandQuadraticWeightedLeastSquares : quadratic in the narrow band, linear far
        //                                       field. O(band) memory.
        //   defectCorrectedIDW                : IDW + iterated gradient/defect correction.
        //                                       Cheap/CPU-bound but UNSTABLE here (gradient
        //                                       injection amplifies |grad psi|). Research.
        scheme              @!SL_SCHEME!@;
        // normalProjected only (inert for pointValue/fluxForm):
        renormalization     @!SL_RENORMALIZATION!@;   // geometric | strain | none
        offsetEngine        @!SL_OFFSET_ENGINE!@;     // rayRoot | footPoint
        slopeLimiter        @!SL_LIMITER!@;
        venkK               @!SL_VENKK!@;
        fit                 @!SL_FIT!@;
        reconstruction      @!SL_RECONSTRUCTION!@;

        // ---- correction strategy (RTS slCorrector) ----
        //   direct             : one reconstruction pass. Use with the stable value-fitting
        //                        reconstructions (quadraticWeightedLeastSquares). DEFAULT.
        //   deferredCorrection : fixed-point iteration, rebuilding the reconstruction from
        //                        the current iterate (self-consistent gradient). Only
        //                        stabilises a CONTRACTING operator; DIVERGES for
        //                        defectCorrectedIDW (spectral radius > 1). Research seam.
        correction          @!SL_CORRECTION!@;

        CFLmax              @!CFL!@;   // foot-radius guard: warn if the foot leaves the
                                       // point-neighbour stencil hull (operational CFL<=1)
        analyticVelocity    true;      // prescribed U is the analytic cell-centre velocity

        // ---- reconstruction safeguards (slReconstruction base; every reconstruction) ----
        limitSlope          false;     // Barth-Jespersen limiter on the increment. MEASURED
                                       // to cost convergence order -> off; the always-on
                                       // value cap in the corrector handles overflow.
        clipToStencilBounds @!SL_CLIP!@;  // monotone clip of the reconstructed value to the
                                       // stencil [min,max]; forbids the overshoot that drives
                                       // the quadraticTaylor steepening instability (not needed
                                       // by the value-fitting reconstructions, which are bounded).

        // ---- uncachedQuadraticWeightedLeastSquares control ----
        ridgeEps            0;         // Tikhonov ridge on the normal-equations diagonal
                                       // (0 = off; raise if Cholesky reports near-degenerate
                                       // stencils on distorted/polyhedral meshes)

        // ---- bandQuadraticWeightedLeastSquares controls ----
        nLayersBand         3;         // quadratic where |psi| <= (nLayersBand+bandGuard)*h
        bandGuard           2;         // guard so band cells' stencils stay inside the band

        // ---- defectCorrectedIDW controls (iterative nodal-defect correction) ----
        idwPower            2;         // final-blend weight = |x_d - x_C|^{-idwPower}
        dcIters             3;         // Gauss-Seidel nodal-defect sweeps
        dcMaxIters          10;        // hard cap on sweeps
        dcTol               1e-3;      // range-relative residual early-out
        dcRelax             0.8;       // under-relaxation of the sweep (<= 1)
        dcRegEps            0.1;       // nugget for the regularised blend weight
                                       // wreg = (h^2/(|r|^2 + dcRegEps^2 h^2))^(idwPower/2)

        // ---- deferredCorrection controls (correction = deferredCorrection) ----
        nDefCorr            3;         // deferred-correction passes
        nDefCorrMax         10;        // hard cap on passes
        defCorrRelax        1.0;       // under-relaxation of the fixed-point update (<= 1)
        defCorrTol          0.0;       // range-relative early-out (0 = run all passes)
    }
}


