FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     leiaLevelSetFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         @!END_TIME!@;

maxCo           @!CFL!@;

deltaT          1e-6;

adjustTimeStep  yes;

writeControl    adjustableRunTime;

// Write at t = 0, T/2 (maximum deformation) and T (reversed) so the automated
// field atlas (alpha, |grad psi|-1) can show the full init -> half -> reversed
// evolution. adjustableRunTime nudges deltaT to land exactly on the write times.
writeInterval   @!HALF_END_TIME!@;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// Defect-correction passes for the deferred second-order (linearUpwind) psi
// advection; ~2-3 converge to formal second order.
nDefCorr        @!N_DEF_CORR!@;

libs ("libleiafiniteVolume.so");

#include "fobjects";
// ************************************************************************* //
