FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

// The rotation (sphereRotation3D) has inflow and outflow on every patch. The
// token TPF_ALPHA_BC (2026-10-29): zeroGradient (the first runs; an inflow
// face carries the wall cell's own value back in, and the curved loop's
// wisps of 1e-10 at the walls entered the mass balance at 1e-10 per step)
// or inletOutlet (zero on the inflow faces, zero gradient on the outflow
// faces; the inletValue and value entries are read by inletOutlet only).
boundaryField
{
    inlet
    {
        type            @!TPF_ALPHA_BC!@;
        inletValue      uniform 0;
        value           uniform 0;
    }
    outlet
    {
        type            @!TPF_ALPHA_BC!@;
        inletValue      uniform 0;
        value           uniform 0;
    }
    walls
    {
        type            @!TPF_ALPHA_BC!@;
        inletValue      uniform 0;
        value           uniform 0;
    }
}

