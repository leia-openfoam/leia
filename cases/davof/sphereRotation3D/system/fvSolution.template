FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        advectionScheme      isoAdvection;
        // The row TPF_ROW (workflow/scripts/tpf_rows.py): the reconstruction
        // scheme (davof | plicRDF | isoAlpha) and, for davof, the normal
        // model; the comparators ignore the davof keys below.
        reconstructionScheme @!TPF_RECON_SCHEME!@;
        // davof: interface cell |m_c| > wispTol V^(2/3)
        wispTol         @!TPF_WISP_TOL!@;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        // plicRDF's initial guess (the helper inside davof and the comparator alike):
        // true = the previous normals shifted back by U dt (the library's default),
        // false = the alpha gradient every time (the hexInterp diagnostic)
        interpolateNormal @!TPF_INTERPOLATE_NORMAL!@;
        // davof: the normal model (davofNormalModel.H) and where it replaces
        // m_c (applyTo all, or check: the slivers |m_c| < sliverTol h^2 and
        // the cells deviating by more than maxAngle degrees); exactNormal
        // is the translated sphere of the exact control
        normalModel     @!TPF_NORMAL_MODEL!@;
        applyTo         @!TPF_APPLY_TO!@;
        sliverTol       @!TPF_SLIVER_TOL!@;
        maxAngle        @!TPF_MAX_ANGLE!@;
        noNormalFallback @!TPF_NO_NORMAL_FALLBACK!@;
        // davof: the face-clipping model of the face update (fork
        // davofFaceClipping.H, 2026-10-15): plane (the plane clipping of the
        // moved PLIC plane, the default) or planeSagitta (plus the
        // second-order sagitta correction from the ring curvature tensor);
        // the sub-keys at the fork's defaults, read by planeSagitta only
        faceClipping    @!TPF_FACE_CLIPPING!@;
        sagittaMinCos   0.2;
        sagittaMinChord 0.05;
        sagittaMaxFraction 0.25;
        sagittaForm     full;
        tensorSource    ring;
        // davof: write the ring curvature tensor and the vertex offset the
        // sagitta correction uses (curvatureTensorDavof, curvatureOffsetDavof)
        // at the field writes (the diagnostic of 2026-10-16; false: not written)
        writeCurvatureTensor @!TPF_WRITE_TENSOR!@;
        // planeSagitta: the signed correction dA/|S_f| per face written as the
        // surface field sagittaCorrection.water (the same diagnostic switch)
        writeSagittaCorrection @!TPF_WRITE_TENSOR!@;
        // davof: the curved clipping surface of the dual advection (fork
        // isoAdvectionCurved.C, 2026-10-23), derived from TPF_ROW: none (the
        // plane sweep, today's loop), exactSphere (the exact sphere of the
        // exactNormal block for the volume flux AND the face update: the
        // machinery gate) or paraboloid (the six-coefficient paraboloid of
        // every interface cell fitted to its own face fractions with the ring
        // tensor as prior, with its own volume flux); the sub-keys at the
        // fork's defaults (the prism quadrature's relative tolerance and
        // depth, the fit's prior weight, tolerance and iteration cap, the
        // refinement levels of the surface-defect volume)
        clippingSurface @!TPF_CLIPPING_SURFACE!@;
        curvedTolRel    @!TPF_CURVED_TOL_REL!@;
        curvedMaxDepth  @!TPF_CURVED_MAX_DEPTH!@;
        // the rule for the cell volume, the prism volume and the face fraction
        // under a surface: splitQuadrature (the reference) | kromerBothe (the
        // face-based method of Kromer and Bothe 2023 for the paraboloid) |
        // exactSphere (Strobl, Formella, Poeschel 2016 for the sphere)
        volumeRule      @!TPF_VOLUME_RULE!@;
        volumeRuleDebug @!TPF_CURVED_DEBUG!@;
        // the Kromer-Bothe rule's checks: the least number of sub-arcs per
        // trace arc and the fan triangulation of the planar faces
        kromerBotheMinSplit @!TPF_KB_MIN_SPLIT!@;
        kromerBotheFan  @!TPF_KB_FAN!@;
        // warped faces (fork branch davof-warped, 2026-10-25): the face state
        // scalar (alphaf alone) | vector (the wetted area vector
        // wettedAreaDavof next to alphaf, m_c and the face moment from it;
        // initDavofFields writes it with the same token), the centroids of
        // the ring tensor fit cut | anchored (re-anchored by the volume
        // rule), the fan apex of a warped flux prism vertexMean | faceCentre;
        // the defaults are the build's behaviour before the keys
        faceState       @!TPF_FACE_STATE!@;
        tensorCentroid  @!TPF_TENSOR_CENTROID!@;
        kromerBothePrismApex @!TPF_KB_PRISM_APEX!@;
        fitPriorWeight  1e-2;
        fitTol          1e-10;
        fitMaxIter      50;
        // faces: the surface interpolates the face fractions; volume: the offset
        // shifted after the fit so that the volume under the surface is alpha_k V
        fitAnchor       @!TPF_FIT_ANCHOR!@;
        // six: all six coefficients from the face fractions; one: the offset alone
        // from the total wetted area; none: the frame and the ring tensor only
        fitDof          @!TPF_FIT_DOF!@;
        // the volume anchor's tolerance (of the cell volume) and the period of the
        // surface-defect diagnostic in steps
        anchorTolRel    1e-11;
        // the anchor's root finder (fork branch davof-perf): illinois | newton
        // (ignored by the builds before it)
        anchorMethod    @!TPF_ANCHOR_METHOD!@;
        // the volume flux of a face (fork branch davof-fluxint): prism (the
        // prism volume) | trapezoidal | simpson (a quadrature in time of the
        // face fractions; ignored by the builds before it)
        fluxIntegration @!TPF_FLUX_INTEGRATION!@;
        // the pre-image classification diagnostic of the fork branch
        // davof-swept (2026-10-29): per step the swept faces by the class of
        // the cells their pre-image reaches, the first unbounded cell with
        // its faces' fluxes, the mass through the bounding; false: inert
        sweptClassify   @!TPF_SWEPT_CLASSIFY!@;
        // the kinematic consistency of the swept fluxes (fork davof-swept,
        // 2026-10-29): the liquid volume of the swept volume scaled by
        // phi_f dt / V_swept, so that a wholly wet swept volume gives the
        // upwind flux of a full cell; false: the geometric volume as it is
        sweptScaleToPhi @!TPF_SWEPT_SCALE!@;
        // sweptFaceCells: the surface of a wisp's pieces (a cell without a
        // surface and with 1e-8 < alpha < 1 - 1e-8): none (0/1 by alpha, the
        // fork's default) | neighbour (the plane of its closest face neighbour
        // with a surface); fork davof-swept 2026-11-02, builds before it ignore it
        sweptWispSurface @!TPF_SWEPT_WISP_SURFACE!@;
        // the band of the wisp class (2026-11-03): full for alpha >= 1 - tol, empty
        // for alpha <= tol (1e-8 the fork's default; 0: every partial cell)
        sweptWispTol @!TPF_SWEPT_WISP_TOL!@;
        // sweptFaceCells: the face update from the pieces (the same clip as
        // the flux) or from the donor's plane alone (fork davof-swept,
        // 2026-10-29)
        sweptCellsFaceUpdate @!TPF_SWEPT_FACE_UPDATE!@;
        // the rule for a part of the pre-image lying in a cell plane:
        // donorSide (the fork's default) | both (counted in both cells, the
        // defect of the first ladder); the one-step face dump (fork
        // davof-swept, 2026-10-29)
        sweptCoplanar   @!TPF_SWEPT_COPLANAR!@;
        sweptFaceDump   @!TPF_SWEPT_DUMP!@;
        // clippingSurface plane: anchor (the plane of the used normal
        // positioned by the volume anchor) | exact (the tangent plane of the
        // exact sphere per interface cell, a control without the anchor;
        // fork davof-swept 2026-11-01)
        planeSource     @!TPF_PLANE_SOURCE!@;
        // the per-face log of the swept fluxes, per step and rank
        // (postProcessing/sweptFaceLog; fork davof-swept-par, 2026-10-30;
        // builds before it ignore the key)
        sweptFaceLog    @!TPF_SWEPT_FACE_LOG!@;
        // the cap set of a piece: final (the planes that produced an edge of
        // the final clipped polygons, contacts dropped; fork davof-swept
        // 2026-11-02, the default) | crossing (the earlier order-dependent
        // rule, for the comparison); builds before it ignore the key
        sweptCapSet     @!TPF_SWEPT_CAP_SET!@;
        // the consistency under oblique travel (fork davof-swept c635611,
        // 2026-11-02; builds before it ignore the keys): the serial
        // diagnostic (postProcessing/sweptConsistency, field sweptResidue)
        // and the consistent variant of sweptFaceCells
        sweptConsistencyLog @!TPF_SWEPT_CONSISTENCY_LOG!@;
        sweptConsistent @!TPF_SWEPT_CONSISTENT!@;
        defectEvery     10;
        curvedDebug     @!TPF_CURVED_DEBUG!@;
        defectLevels    3;
        writeCurvedFields @!TPF_WRITE_TENSOR!@;
        // the exact body of the exact normal model and of clippingSurface
        // exactSphere: the sphere carried by U0 (zero on the rotation arm)
        // and turned about the axis through axisPoint with the angular
        // velocity omega (fork davofOrbit.H, 2026-10-28); the sign of omega
        // follows setFlow's rotation below, U = omega_vec x (x - axisPoint)
        // with omega_vec = (0 -omega 0)
        exactNormal
        {
            functionType sphere;
            origin      (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
            radius      @!TPF_SPHERE_RADIUS!@;
            U0          (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
            omega       (0 -@!TPF_OMEGA!@ 0);
            axisPoint   (@!TPF_AXIS_X!@ @!TPF_SPHERE_CY!@ @!TPF_AXIS_Z!@);
        }
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         0;
        nAlphaBounds    3;
        clip            false;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

// The velocity: advectorVoF constructs OpenFOAM's functionObjects::setFlow
// from this block (apps/benchmark/advectorVoF/createFields.H) and calls it
// before the first step and at the half time of every step; mode rotation
// sets U = (-omega (z - origin_z), 0, omega (x - origin_x)) on the cells and
// the patches and phi = fvc::flux(U), i.e. the solid-body rotation about the
// axis parallel to y through origin with the angular velocity vector
// (0 -omega 0) (setFlow.C: the global x and z components, refDir (1 0 0)
// and axis (0 1 0) make its frame the identity). The linear interpolation of
// a linear velocity is exact at the face centres of the hexahedra, so the
// discrete divergence of phi is round-off.
//
// mode function (TPF_SETFLOW_MODE function, 2026-11-01): the circular
// translation WITHOUT spin. setFlow.C (v2606) assigns the spatially uniform
// U == velocity(t) to the cells AND every patch (operator==, which also
// overrides the fixedValue patches) and phi = fvc::flux(U), i.e. U(t).S_f on
// every face; the keys omega/origin/refDir/axis are read in mode rotation
// only, velocity in mode function only. velocity(t) is the velocity of the
// centre c(t) of the sphere turned about the axis through axisPoint
// a = (TPF_AXIS_X . TPF_AXIS_Z) with omega_vec = omega k, k = (0 -1 0):
// with d0 = c0 - a and Rodrigues' formula (O. Rodrigues, Des lois
// geometriques qui regissent les deplacements d'un systeme solide dans
// l'espace, J. Math. Pures Appl. 5 (1840) 380-440, no DOI; as in the fork's
// davofOrbit.H), d(t) = d0 cos(wt) + (k x d0) sin(wt) (k.d0 = 0), and
//     U(t) = d'(t) = s [ sin(wt) w (-d0) + cos(wt) w (k x d0) ],
//     w (-d0)     = w (a_x - c_x, 0, a_z - c_z)   (the sine's scale),
//     w (k x d0)  = w (a_z - c_z, 0, c_x - a_x)   (the cosine's scale),
// as OpenFOAM's Function1 sine (value = amplitude sin(2 pi f t) scale +
// level) whose level is a Function1 cosine of the same form. setFlow is
// evaluated at the half time t_m = t_n + dt/2, so the centre moves by
// U(t_m) dt per step; with theta = w dt and the identities
// cos A - cos B = -2 sin((A+B)/2) sin((A-B)/2), sin A - sin B =
// 2 cos((A+B)/2) sin((A-B)/2) (M. Abramowitz, I. A. Stegun (eds.), Handbook
// of Mathematical Functions, National Bureau of Standards Applied
// Mathematics Series 55 (1964), Section 4.3, no DOI) the exact step is
// d(t_n+1) - d(t_n) = 2 sin(theta/2) [ sin(w t_m) (-d0) + cos(w t_m) (k x d0) ],
// the chord, while U(t_m) dt with s = 1 is theta [ ... ], the arc. The
// amplitude s = sin(theta/2)/(theta/2) of the fixed step (MAX_DELTA_T) makes
// U(t_m) dt the chord, so that every step end lies on the exact circle at
// the exact angle w t_n+1 (without it the centre would lead by theta^2/24
// of the step per step). The sphere's exact state (davofOrbit.H, a sphere is
// invariant under the spin) is then the rotation case's at every step end.
// The inner level is the uniform velocity of the arm (TPF_UX/UY/UZ, zero on
// the rotation arm, so the orbit is unchanged; 2026-11-02): with the axis
// through the sphere's centre (TPF_AXIS_X/Z = TPF_SPHERE_CX/CZ) both scales
// vanish and mode function gives the straight translation at that constant
// velocity (arms lineDiagXZ, lineX), for which the exact body's U0 is the
// same arm velocity and its omega a spin about its own centre.
setFlow
{
    mode        @!TPF_SETFLOW_MODE!@;
    omega       constant @!TPF_OMEGA!@;
    origin      (@!TPF_AXIS_X!@ @!TPF_SPHERE_CY!@ @!TPF_AXIS_Z!@);
    refDir      (1 0 0);
    axis        (0 1 0);
    scale       constant 1;
    velocity
    {
        type        sine;
        frequency   #eval{ @!TPF_OMEGA!@/(2*pi()) };
        amplitude   #eval{ sin(0.5*@!TPF_OMEGA!@*@!MAX_DELTA_T!@)/(0.5*@!TPF_OMEGA!@*@!MAX_DELTA_T!@) };
        scale       #eval{ vector(@!TPF_OMEGA!@*(@!TPF_AXIS_X!@ - @!TPF_SPHERE_CX!@), 0, @!TPF_OMEGA!@*(@!TPF_AXIS_Z!@ - @!TPF_SPHERE_CZ!@)) };
        level
        {
            type        cosine;
            frequency   #eval{ @!TPF_OMEGA!@/(2*pi()) };
            amplitude   #eval{ sin(0.5*@!TPF_OMEGA!@*@!MAX_DELTA_T!@)/(0.5*@!TPF_OMEGA!@*@!MAX_DELTA_T!@) };
            scale       #eval{ vector(@!TPF_OMEGA!@*(@!TPF_AXIS_Z!@ - @!TPF_SPHERE_CZ!@), 0, @!TPF_OMEGA!@*(@!TPF_SPHERE_CX!@ - @!TPF_AXIS_X!@)) };
            level       (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        }
    }
}

// advectorVoF reads period/reverseTime/spirallingFlow here (none) and the
// abort guard (fork commit a5901fd, 2026-10-13): the run
// ends with "advectorVoF: ABORT at step ..." and the normal "End" when alpha
// leaves [abortMinAlpha, abortMaxAlpha] or the interface-cell count exceeds
// abortInterfaceCellFactor times its count at the first step; the leia
// converter tpf_advection_metrics.py records the row as status diverged.
isoAdvector
{
    abortEnabled    true;
    abortMinAlpha   -0.5;
    abortMaxAlpha   1.5;
    abortInterfaceCellFactor 10;
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

