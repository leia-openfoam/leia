FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      initAlphaFieldDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// initDavofFields: the DAVOF state (alpha and the face fractions alphaf) of the
// disc (the cylinder along y through the one-cell-thick mesh, exactCylinder);
// every row starts from the same fields
field   "alpha.water";
type    cylinder;
radius  @!TPF_SPHERE_RADIUS!@;
origin  (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
direction (0 1 0);
davofMethod @!TPF_DAVOF_METHOD!@;
wispTol     @!TPF_WISP_TOL!@;

// ************************************************************************* //
