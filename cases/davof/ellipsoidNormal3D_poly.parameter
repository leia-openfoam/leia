// DAVOF static gate 2 on a POLYHEDRAL mesh (mesh: poly -> cfMesh pMesh,
// 2026-10-12). This file REPLACES ellipsoidNormal3D.parameter for mesh: poly
// studies (workflow/Snakefile PARAM_FILE), so it carries the hex values plus
// the surface of the cfMesh box (SURFACE_FILE, system/meshDict.template).
//
// The same triaxial ellipsoid (half-axes 1.0/0.8/0.6 mm, centre the sphere
// gate's literal) in the same 4 mm box as the hexahedral ladder; N_CELLS is
// the SAME ladder: cfMesh is asked for maxCellSize = h/2^(-1/3), h =
// DOMAIN_LENGTH/N_CELLS (the derived token CFMESH_CELL_SIZE), because its dual
// cells at the interface measure 2^(-1/3) maxCellSize (the pin of workflow/
// README.md): the interface resolution is the hex ladder's h = 200/100/50/25
// um; the mean over all cells (DELTA_X) is smaller.
// Two alpha sources, quadraticFaces (q = 2) and detrixheAslam (q = 1); the
// two curvature models of the hex ladder (normalsOnly the headline, hermite
// the comparison arm); the geometricVoF cross-check on the identical alpha.
// Serial; cfMesh needs jemalloc preloaded on the laptop (LEIA_PMESH_PRELOAD,
// workflow/README.md), not on Lichtenberg.
values
{
    solver (leiaTestDavofNormal);

    N_CELLS ( 20 40 80 160 );

    DOMAIN_LENGTH ( 0.004 );

    SURFACE_FILE ( box4mm-faces.stl );

    DAVOF_ALPHA_SOURCE ( quadraticFaces detrixheAslam );

    DAVOF_CURV_MODEL_1 ( normalsOnly );

    DAVOF_CURV_MODEL_2 ( hermite );

    DAVOF_CROSS_CHECK ( geometricVoF );

    DAVOF_REGEN_ARM ( none );

    DAVOF_REGEN_ITER ( 1 );

    DAVOF_REGEN_FEEDBACK ( own );

    DAVOF_REGEN_REFIT ( true );

    DAVOF_REGEN_ORIGIN ( volume );
}
