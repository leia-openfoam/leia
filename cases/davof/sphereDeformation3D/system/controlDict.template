FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The 3D deformation benchmark of the DAVOF swept-face advection
// (2026-11-06): the dictionaries of the rotation benchmark with the values
// from the study tokens (cases/davof/sphereDeformation3D.parameter); the
// velocity comes from the setFlow block of fvSolution.

// the application token TPF_APPLICATION (the fork's advectorVoF; the leia
// app of the port takes its place through the same token, next to the
// config's solver entry that the workflow launches)
application     @!TPF_APPLICATION!@;

// repetition @!TPF_REPEAT!@ of a timing study (the token is an axis that changes nothing in the case)

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         @!END_TIME!@;

// Fixed time step generated by workflow/scripts/materialize.py.
//   mode=@!TIME_STEP_CONTROL!@
//   target advective Co=@!TARGET_ADVECTIVE_CO!@
//   reference domain length=@!DOMAIN_LENGTH!@ m
//   reference speed=@!REFERENCE_SPEED!@ m/s
// dt = Co h / REFERENCE_SPEED with h = DOMAIN_LENGTH/N_CELLS and
// REFERENCE_SPEED 2.5, just above the maximum over the cells of
// 0.5 sum_f |U(x_f) . n_f| of the deformation field at t = 0 (2.46 .. 2.48),
// so that Co is OpenFOAM's Courant number to within 1.6 %; END_TIME 3 = T is
// 3 N 2.5 / Co steps (240 at N = 32 and Co 1), a multiple of four.
deltaT          @!MAX_DELTA_T!@;

// the field writes at T/4, T/2, 3T/4 and T (every one lands on a step)
writeControl    adjustableRunTime;
writeInterval   @!TPF_WRITE_INTERVAL!@;

purgeWrite      0;

writeFormat     ascii;
writePrecision  @!TPF_WRITE_PRECISION!@;
writeCompression off;

timeFormat      general;
timePrecision   10;

graphFormat     raw;

runTimeModifiable no;

// The step is fixed above; the Courant limits are required by the solver and inert.
adjustTimeStep  no;
maxCo           1e6;
maxAlphaCo      1e6;
maxDeltaT       1e6;

profiling
{
    active          @!TPF_PROFILING!@;
}

functions
{
    // The transported face fractions against the EXACT DAVOF state
    // (exactSphere) of the sphere AT REST (U0 = 0, omega = 0: the exact
    // state at t = T is the initial sphere; at the intermediate writes the
    // sheet is compared with the sphere, which is not an error) and the
    // reconstruction error of the scheme (normal, centre) at every write
    // (TPF_RECON_ERROR_EVERY_STEP true): postProcessing/areaFractionError/0/
    // areaFractionError.dat and postProcessing/reconstructionError/0/
    // error.dat. The write control is the field writes' (the timing rule:
    // diagnostics at the write times only, both methods alike).
    areaFractionError
    {
        type            areaFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    sphere;
        origin          (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        radius          @!TPF_SPHERE_RADIUS!@;
        U0              (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        omega           (0 0 0);
        axisPoint       (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        davofMethod     @!TPF_REF_METHOD!@;
        wispTol         @!TPF_WISP_TOL!@;
        consistency     @!TPF_AFE_CONSISTENCY!@;
        reconstructionError true;
        reconstructionErrorEveryStep @!TPF_RECON_ERROR_EVERY_STEP!@;
        writeFaceError  @!TPF_AFE_WRITE_FACE_ERROR!@;
        faceErrorCsv    @!TPF_AFE_FACE_CSV!@;
        writeControl    @!TPF_AFE_WRITE_CONTROL!@;
        writeInterval   @!TPF_AFE_WRITE_INTERVAL!@;
        writePrecision  @!TPF_WRITE_PRECISION!@;
    }
    // Eshape = sum |alpha - alpha_exact| V against the sphere at rest (the
    // shape error at t = T; the symmetric difference of the two volumes for
    // sharp fields), Emass and Ebound at the write times:
    // postProcessing/volumeFractionError/0/volumeFractionError.dat. The
    // per-step mass and bounds come from advectorVoF's own log line.
    volumeFractionError
    {
        type            volumeFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    sphere;
        origin          (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        radius          @!TPF_SPHERE_RADIUS!@;
        U0              (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        omega           (0 0 0);
        axisPoint       (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        writeControl    @!TPF_VFE_WRITE_CONTROL!@;
        writeInterval   @!TPF_VFE_WRITE_INTERVAL!@;
        writePrecision  @!TPF_WRITE_PRECISION!@;
    }
}

