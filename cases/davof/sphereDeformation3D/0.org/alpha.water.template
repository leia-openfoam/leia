FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

// The deformation field vanishes on the six faces of the unit cube, so the
// boundary flux is zero and the condition never enters the mass balance;
// TPF_ALPHA_BC zeroGradient (the inletValue and value entries are read by
// inletOutlet only).
boundaryField
{
    walls
    {
        type            @!TPF_ALPHA_BC!@;
        inletValue      uniform 0;
        value           uniform 0;
    }
}

