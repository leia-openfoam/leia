// The sphere-translation benchmark of the DAVOF face update, driven through
// the TwoPhaseFlow fork's advectorVoF (branch davof; the dictionaries of
// run/benchmark/advection/sphereTranslation3D there, 2026-10-13).
//
// A sphere of radius 0.15 at (0.5 0.5 0.5) in the 2 x 1 x 1 box, carried by
// the uniform velocity (1 0 0) (arm axial, |U| = 1 = REFERENCE_SPEED) to
// x = 1.5 in END_TIME 1 (3.3 diameters; one diameter every 0.3). N_CELLS cells
// across the unit height (DOMAIN_LENGTH 1, h = 1/N: R/h = 4.8, 9.6, 19.2),
// 2 N along x. The fixed step is dt = Co h (materialize, TIME_STEP_CONTROL
// advective): N / Co steps (160 at N = 32, Co 0.2).
//
// The state is the quadraticFaces construction of initDavofFields (the
// proposal's second-order face fractions); the seven rows of
// workflow/scripts/tpf_rows.py (TPF_ROW) run the davof scheme with its
// normal models and the two comparators on the same initial alpha.
// areaFractionError (against the exact state of the translated sphere) and
// volumeFractionError every step, the reconstruction error at the end time
// (controlDict.template); tpf_advection_metrics.py joins them with the
// solver log into advectorVoF.csv.
values
{
    solver (advectorVoF);

    N_CELLS ( 32 64 128 );

    TARGET_ADVECTIVE_CO ( 0.1 0.2 0.5 );

    TPF_ROW ( davof-cellLocal davof-ringArea davof-ringFit davof-exact davof-plicRDFnormal plicRDF isoAlpha );

    TPF_VELOCITY_ARM ( axial );

    TPF_DAVOF_METHOD ( quadraticFaces );

    // the reference state of areaFractionError: the exact sphere fractions on
    // axis-aligned hexahedra; quadraticFaces on perturbed meshes (exactSphere FatalErrors there)
    TPF_REF_METHOD ( exactSphere );

    DOMAIN_LENGTH ( 1 );

    END_TIME ( 1 );

    TIME_STEP_CONTROL ( advective );

    REFERENCE_SPEED ( 1 );

    TPF_WISP_TOL ( 1e-3 );

    // plicRDF's interpolateNormal switch (true = the library's default)
    TPF_INTERPOLATE_NORMAL ( true );

    TPF_SPHERE_RADIUS ( 0.15 );

    TPF_SPHERE_CX ( 0.5 );
    TPF_SPHERE_CY ( 0.5 );
    TPF_SPHERE_CZ ( 0.5 );

    // controlDict writeInterval [s] (adjustableRunTime): four field writes
    TPF_WRITE_INTERVAL ( 0.25 );
}
