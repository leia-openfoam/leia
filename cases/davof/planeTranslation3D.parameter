// The plane-translation test of the DAVOF face update, driven through the
// TwoPhaseFlow fork's advectorVoF (branch davof; the dictionaries of
// run/benchmark/advection/planeTranslation3D there, 2026-10-13).
//
// The plane of the static test (normal (0.3 0.5 0.8124), unit) positioned in
// the (L, L, L) corner of the 4 mm box (origin (0.8 L, 0.9 L, 0.7878 L),
// n.x = 1.33 L): it meets only the x = L, y = L and z = L boundaries, so no cut
// cell has an inflow boundary face. The arm TPF_VELOCITY_ARM moves it along
// its normal (normal, U = n: the sliver-amplifying arm) or along x (oblique,
// U = (1 0 0)); |U| = 1 for both, REFERENCE_SPEED 1. The fixed step is
// dt = Co h (materialize, TIME_STEP_CONTROL advective); END_TIME 8e-4 s is a
// travel of 0.2 L = 0.2 N / Co steps (20 at N = 20, Co 0.2; 640 at N = 160,
// Co 0.05), the plane staying inside the corner (n.x <= 1.53 L < 1.6124 L).
//
// The state is the Detrixhe-Aslam construction of initDavofFields (exact on
// a plane); the seven rows of workflow/scripts/tpf_rows.py (TPF_ROW) run the
// davof scheme with its normal models and the two comparators on the same
// initial alpha. areaFractionError and volumeFractionError every step, the
// reconstruction error every step (controlDict.template);
// tpf_advection_metrics.py joins them with the solver log into advectorVoF.csv.
values
{
    solver (advectorVoF);

    N_CELLS ( 20 40 80 160 );

    TARGET_ADVECTIVE_CO ( 0.05 0.1 0.2 0.5 );

    TPF_ROW ( davof-cellLocal davof-ringArea davof-ringFit davof-exact davof-plicRDFnormal plicRDF isoAlpha );

    // the face-clipping model (plane | planeSagitta, 2026-10-15) is DERIVED
    // from TPF_ROW by tpf_rows.row_tokens (the sagitta rows select
    // planeSagitta); the value here documents the default, the row decides
    TPF_FACE_CLIPPING ( plane );

    // the curved clipping surface of the dual advection (none | exactSphere |
    // paraboloid, 2026-10-23) is DERIVED from TPF_ROW as well; the value here
    // documents the default
    TPF_CLIPPING_SURFACE ( none );
    // the anchor of the paraboloid fit (faces | volume), derived from TPF_ROW too
    TPF_FIT_ANCHOR ( faces );
    // the degrees of freedom the face fractions set in the fit (six | one | none), derived too
    TPF_FIT_DOF ( six );
    // the fork's quadrature diagnostic (the worst anchor residual's cell printed)
    TPF_CURVED_DEBUG ( false );
    // the volume rule of the curved flux (2026-10-24): splitQuadrature (the
    // reference), kromerBothe (Kromer and Bothe, J. Comput. Phys. 475 (2023)
    // 111840, doi:10.1016/j.jcp.2022.111840; the paraboloid), exactSphere
    // (Strobl, Formella, Poeschel, J. Comput. Phys. 311 (2016) 158-172,
    // doi:10.1016/j.jcp.2016.02.003; the exact-sphere control)
    TPF_VOLUME_RULE ( splitQuadrature );
    // the volume anchor's root finder (fork branch davof-perf, 2026-10-25):
    // ccs (Consecutive Cubic Spline positioning on the exact volumes and
    // slopes, the fork's default) | newton | illinois (the bracket and the
    // Illinois rule, the method until 2026-10-25) | compare (illinois and
    // ccs, the run continues with ccs); builds before it ignore the key
    TPF_ANCHOR_METHOD ( ccs );
    // the volume flux of a face (fork branch davof-fluxint, 2026-10-25): prism
    // (the liquid volume of the prism between the pre-image and the face) |
    // trapezoidal (phi_f dt times the mean of the face fractions at t^n and
    // t^{n+1}) | simpson (with the half-step pre-image's fraction) |
    // simpsonSplit (Simpson's rule between the vertex passages of the trace);
    // builds before it ignore the key
    TPF_FLUX_INTEGRATION ( prism );
    // warped faces (fork branch davof-warped, 2026-10-25): the face state
    // (scalar | vector: the wetted area vector per face, the sum over the fan
    // triangles of the wetted area vectors), the centroids of the ring tensor
    // fit (cut | anchored) and the fan apex of a warped flux prism
    // (vertexMean | faceCentre); the defaults reproduce the build before
    TPF_FACE_STATE ( scalar );
    TPF_TENSOR_CENTROID ( cut );
    TPF_KB_PRISM_APEX ( vertexMean );

    // the prism quadrature of the curved flux: relative tolerance of the flux
    // volume per face and step, and the refinement depth (the first smoke at
    // 1e-10 / 12 cost 6.7e7 leaves and 9 s per step at N = 32; the needed
    // accuracy is of the order h^2 of the flux)
    TPF_CURVED_TOL_REL ( 1e-11 );
    TPF_CURVED_MAX_DEPTH ( 9 );

    TPF_VELOCITY_ARM ( normal oblique );

    TPF_DAVOF_METHOD ( detrixheAslam );

    DOMAIN_LENGTH ( 0.004 );

    END_TIME ( 8e-4 );

    TIME_STEP_CONTROL ( advective );

    REFERENCE_SPEED ( 1 );

    TPF_WISP_TOL ( 1e-3 );

    // repetition index of a timing study (a comment in controlDict; an axis only)
    TPF_REPEAT ( 1 );

    // plicRDF's interpolateNormal switch (true = the library's default)
    TPF_INTERPOLATE_NORMAL ( true );

    TPF_PLANE_PX ( 0.0032 );
    TPF_PLANE_PY ( 0.0036 );
    TPF_PLANE_PZ ( 0.0031512 );

    TPF_PLANE_NX ( 0.3 );
    TPF_PLANE_NY ( 0.5 );
    TPF_PLANE_NZ ( 0.8124 );

    // the fork's tilt diagnostic of the curved loop on the translated plane
    // (fork branch davof-tiltdiag, isoAdvectionTiltDiagnostics.C, 2026-10-26):
    // per step and interface cell the measured turn of the own normal
    // against the linearised prediction from the surfaces that set the
    // cell's faces, written to postProcessing/tiltDiagnostics/; serial only;
    // builds before it ignore the key. Study: planeTranslation3D_hexParaboloidTiltDiag.
    TPF_TILT_DIAGNOSTICS ( false );

    // controlDict writeInterval in steps (timeStep write control): the end
    // time only with this default; 1 writes every step
    TPF_WRITE_STEPS ( 1000000 );

    // The diagnostics' write controls and the profiling (2026-10-15; the
    // defaults render the study as before, plus the inert profiling block;
    // the keys as in sphereTranslation3D.parameter). The reconstruction
    // error every step is the plane test's default.
    TPF_AFE_WRITE_CONTROL ( timeStep );
    TPF_AFE_WRITE_INTERVAL ( 1 );
    TPF_AFE_CONSISTENCY ( true );
    TPF_RECON_ERROR_EVERY_STEP ( true );
    TPF_VFE_WRITE_CONTROL ( timeStep );
    TPF_VFE_WRITE_INTERVAL ( 1 );
    TPF_PROFILING ( false );
}
