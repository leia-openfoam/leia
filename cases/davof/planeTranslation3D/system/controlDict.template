FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The plane-translation test of the DAVOF face update: the dictionaries of
// TwoPhaseFlow run/benchmark/advection/planeTranslation3D with the values
// from the study tokens (cases/davof/planeTranslation3D.parameter).

application     advectorVoF;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         @!END_TIME!@;

// Fixed time step generated by workflow/scripts/materialize.py.
//   mode=@!TIME_STEP_CONTROL!@
//   target advective Co=@!TARGET_ADVECTIVE_CO!@
//   reference domain length=@!DOMAIN_LENGTH!@ m
//   reference speed=@!REFERENCE_SPEED!@ m/s
// dt = Co h / |U| with h = DOMAIN_LENGTH/N_CELLS and |U| = REFERENCE_SPEED = 1
// for every velocity arm; END_TIME = 0.2 DOMAIN_LENGTH / |U| is 0.2 N / Co steps.
deltaT          @!MAX_DELTA_T!@;

// Field output every TPF_WRITE_STEPS steps (the default 1e6: the end time only).
writeControl    timeStep;
writeInterval   @!TPF_WRITE_STEPS!@;

purgeWrite      0;

writeFormat     ascii;
writePrecision  16;
writeCompression off;

timeFormat      general;
timePrecision   10;

graphFormat     raw;

runTimeModifiable no;

// The step is fixed above; the Courant limits are required by the solver and inert.
adjustTimeStep  no;
maxCo           1e6;
maxAlphaCo      1e6;
maxDeltaT       1e6;

// OpenFOAM's built-in profiling (TPF_PROFILING, default false: the block is
// inert); see the sphere case's controlDict.template.
profiling
{
    active          @!TPF_PROFILING!@;
}

functions
{
    // The transported face fractions against the exact DAVOF state of the
    // plane translated by U0 t (the davof rows; -1 for the comparators),
    // with the reconstruction error (normal, centre) every write
    // (TPF_RECON_ERROR_EVERY_STEP, default true here):
    // postProcessing/areaFractionError/0/areaFractionError.dat and
    // postProcessing/reconstructionError/0/error.dat. The write control
    // (TPF_AFE_WRITE_CONTROL timeStep with TPF_AFE_WRITE_INTERVAL 1: every
    // step, the defaults; onEnd: the end step only) and the consistency
    // column (TPF_AFE_CONSISTENCY, default true: one extra reconstruction
    // per write; false writes -1) as in the sphere case's template.
    areaFractionError
    {
        type            areaFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    plane;
        origin          (@!TPF_PLANE_PX!@ @!TPF_PLANE_PY!@ @!TPF_PLANE_PZ!@);
        normal          (@!TPF_PLANE_NX!@ @!TPF_PLANE_NY!@ @!TPF_PLANE_NZ!@);
        U0              (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        davofMethod     @!TPF_DAVOF_METHOD!@;
        wispTol         @!TPF_WISP_TOL!@;
        consistency     @!TPF_AFE_CONSISTENCY!@;
        reconstructionError true;
        reconstructionErrorEveryStep @!TPF_RECON_ERROR_EVERY_STEP!@;
        writeControl    @!TPF_AFE_WRITE_CONTROL!@;
        writeInterval   @!TPF_AFE_WRITE_INTERVAL!@;
        writePrecision  16;
    }
    // Eshape = sum |alpha - alpha_exact| V against the translated plane, the
    // mass error and the boundedness error, every step (TPF_VFE_WRITE_CONTROL
    // timeStep, TPF_VFE_WRITE_INTERVAL 1, the defaults):
    // postProcessing/volumeFractionError/0/volumeFractionError.dat.
    volumeFractionError
    {
        type            volumeFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    plane;
        origin          (@!TPF_PLANE_PX!@ @!TPF_PLANE_PY!@ @!TPF_PLANE_PZ!@);
        normal          (@!TPF_PLANE_NX!@ @!TPF_PLANE_NY!@ @!TPF_PLANE_NZ!@);
        writeControl    @!TPF_VFE_WRITE_CONTROL!@;
        writeInterval   @!TPF_VFE_WRITE_INTERVAL!@;
        writePrecision  16;
    }
}

