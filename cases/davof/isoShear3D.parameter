// The 3D shear flow of the isoAdvector package's verification (fork branch
// davof-isoAdvector, 2026-11-06): the sphere of radius 0.15 at (0.5 0.75 0.25)
// in the 1 x 1 x 2 box carried by
//     u =  sin(2 pi y) sin^2(pi x) cos(pi t / T),
//     v = -sin(2 pi x) sin^2(pi y) cos(pi t / T),
//     w =  umax (1 - r/R)^2 cos(pi t / T),  r = sqrt((x - 1/2)^2 + (y - 1/2)^2),
// umax = 1, R = 1/2, T = TPF_PERIOD = 3: the shear test of P. Liovic, M. Rudman,
// J.-L. Liow, D. Lakehal, D. Kothe, A 3D unsplit-advection volume tracking
// algorithm with planarity-preserving interface reconstruction, Comput. Fluids 35
// (2006) 1011-1032, doi:10.1016/j.compfluid.2005.09.003, in the form of eq. (4.5)
// of T. Maric, H. Marschall, D. Bothe, voFoam - A geometrical Volume of Fluid
// algorithm on arbitrary unstructured meshes with local dynamic adaptive mesh
// refinement using OpenFOAM, arXiv:1305.3417 (2013), and the field of the fork's
// own testsuite test-deformationSphere (generateUDeform.C, J. Roenby; the
// isoAdvector deformation test of Roenby, Bredmose, Jasak 2016): the fields U and
// phi at t = 0 are written by the fork's initShearFlow3D (phi = U(x_f) . S_f on
// the face centres) and scaled by advectorVoF as cos(pi (t + dt/2) / T)
// (spirallingFlow T), so the flow reverses at T/2 and the exact state at t = T is
// the initial sphere. The sphere leaves the box through no face (the shear keeps
// it inside; the testsuite's box). The fixed step is dt = Co h / REFERENCE_SPEED
// with REFERENCE_SPEED 1.5, the maximum over the cells of 0.5 sum_f |U(x_f) . n_f| h
// at t = 0 to within a few per cent (measured from the log's Courant number, which
// the table reports); END_TIME 3. The exact body of the function objects is the
// sphere at rest (U0 = 0): only the values at t = T are errors of the transport.
values
{
    solver (advectorVoF);
    TPF_APPLICATION ( advectorVoF );
    N_CELLS ( 32 64 128 );
    TARGET_ADVECTIVE_CO ( 0.2 0.5 1 );
    // the rows of the verification (tpf_rows.py): plicRDF (vofCutCell, the
    // classical setting), plicRDF-ccs, davof-ringArea (ccs), davof-ringArea-vofCutCell,
    // isoAlpha (the third reference)
    TPF_ROW ( plicRDF plicRDF-ccs davof-ringArea davof-ringArea-vofCutCell isoAlpha );
    TPF_POSITIONING_TOL ( 1e-14 );
    TPF_POSITIONING_MAX_ITER ( 30 );
    TPF_INTERPOLATE_NORMAL ( true );
    TPF_WISP_TOL ( 1e-3 );
    TPF_N_ALPHA_BOUNDS ( 3 );
    TPF_SNAP_TOL ( 0 );
    TPF_CLIP ( false );
    TPF_DAVOF_METHOD ( exactSphere );
    TPF_REF_METHOD ( exactSphere );
    TPF_SPHERE_RADIUS ( 0.15 );
    DOMAIN_LENGTH ( 1 );
    TIME_STEP_CONTROL ( advective );
    // 17: the fields, the function objects and the log at full double precision
    TPF_WRITE_PRECISION ( 17 );
    TPF_RECON_ERROR_EVERY_STEP ( false );
    TPF_PROFILING ( false );
    TPF_AFE_WRITE_CONTROL ( adjustableRunTime );
    TPF_VFE_WRITE_CONTROL ( adjustableRunTime );
    TPF_VELOCITY_ARM ( deformation3D );
    TPF_PERIOD ( 3 );
    TPF_SPHERE_CX ( 0.5 );
    TPF_SPHERE_CY ( 0.75 );
    TPF_SPHERE_CZ ( 0.25 );
    END_TIME ( 3 );
    REFERENCE_SPEED ( 1.5 );
    TPF_ALPHA_BC ( inletOutlet );
    TPF_ABORT_INTERFACE_FACTOR ( 100 );
    TPF_WRITE_INTERVAL ( 0.75 );
    TPF_AFE_WRITE_INTERVAL ( 0.75 );
    TPF_VFE_WRITE_INTERVAL ( 0.75 );
}
