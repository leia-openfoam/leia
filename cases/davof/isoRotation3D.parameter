// The solid-body rotation of the isoAdvector package's verification (fork
// branch davof-isoAdvector fab3805, 2026-11-06): the sphere of radius 0.15 at
// (0.5 0.5 0.5) in the 2 x 1 x 1 box turns once about the axis parallel to y
// through (0.75 . 0.5) on the circle of radius 0.25 in the x-z plane,
// U = (-omega (z - 0.5), 0, omega (x - 0.75)), omega = 2 pi, set every step by
// the fork's setFlow block (mode rotation) at the half time of the step;
// END_TIME 1 is one turn (cases/davof/sphereRotation3D, 2026-10-28, without the
// keys of the swept-face advection). The fixed step is dt = Co h /
// REFERENCE_SPEED with REFERENCE_SPEED 2.5 (the speed of the sphere's far
// point): TARGET_ADVECTIVE_CO is the Courant number of the INTERFACE; OpenFOAM's
// Courant number (the maximum over the box, the far corner at 2 pi 1.3 = 8.2 m/s)
// is 4.32 times it: the targets 0.0463 / 0.1157 / 0.2315 give OF Co 0.2 / 0.5 / 1
// (the comparison studies of 2026-11-03, sphereRotation3D_hexCmp*). The state is
// the exactSphere construction of initDavofFields; the exact body of the function
// objects is the turned sphere (davofOrbit.H).
values
{
    solver (advectorVoF);
    // TPF_APPLICATION retired 2026-11-07: the application, the advection scheme and the
    // function-object library come from the config's solver (DAVOF_APP, DAVOF_ADVECTION_SCHEME,
    // DAVOF_FO_LIBS; materialize.py)
    N_CELLS ( 32 64 128 );
    TARGET_ADVECTIVE_CO ( 0.0463 0.1157 0.2315 );
    // the rows of the verification (tpf_rows.py): plicRDF (vofCutCell, the
    // classical setting), plicRDF-ccs, davof-ringArea (ccs), davof-ringArea-vofCutCell,
    // isoAlpha (the third reference)
    TPF_ROW ( plicRDF plicRDF-ccs davof-ringArea davof-ringArea-vofCutCell isoAlpha );
    TPF_POSITIONING_TOL ( 1e-14 );
    TPF_POSITIONING_MAX_ITER ( 30 );
    TPF_INTERPOLATE_NORMAL ( true );
    TPF_WISP_TOL ( 1e-3 );
    TPF_N_ALPHA_BOUNDS ( 3 );
    TPF_SNAP_TOL ( 0 );
    TPF_CLIP ( false );
    TPF_DAVOF_METHOD ( exactSphere );
    TPF_REF_METHOD ( exactSphere );
    TPF_SPHERE_RADIUS ( 0.15 );
    DOMAIN_LENGTH ( 1 );
    TIME_STEP_CONTROL ( advective );
    // 17: the fields, the function objects and the log at full double precision
    TPF_WRITE_PRECISION ( 17 );
    TPF_RECON_ERROR_EVERY_STEP ( false );
    TPF_PROFILING ( false );
    TPF_AFE_WRITE_CONTROL ( adjustableRunTime );
    TPF_VFE_WRITE_CONTROL ( adjustableRunTime );
    TPF_VELOCITY_ARM ( rotation );
    TPF_OMEGA ( 6.283185307179586 );
    TPF_AXIS_X ( 0.75 );
    TPF_AXIS_Z ( 0.5 );
    TPF_SPHERE_CX ( 0.5 );
    TPF_SPHERE_CY ( 0.5 );
    TPF_SPHERE_CZ ( 0.5 );
    END_TIME ( 1 );
    REFERENCE_SPEED ( 2.5 );
    TPF_ALPHA_BC ( zeroGradient );
    TPF_ABORT_INTERFACE_FACTOR ( 10 );
    TPF_WRITE_INTERVAL ( 0.25 );
    TPF_AFE_WRITE_INTERVAL ( 0.25 );
    TPF_VFE_WRITE_INTERVAL ( 0.25 );
    // The swept-face advection of leia's davofSwept scheme (the leia route's DAVOF
    // rows; the fork route's isoAdvection does not read them), 2026-11-07: the
    // reference setting of fork davof-swept 407f969 (cases/davof/sphereDeformation3D)
    // with the four round-4 keys on; the tokens TPF_FACE_CLIPPING, TPF_CLIPPING_SURFACE,
    // TPF_FIT_ANCHOR, TPF_FIT_DOF and TPF_POSITIONING come from the row (tpf_rows.py)
    TPF_CURVED_DEBUG ( false );
    TPF_VOLUME_RULE ( kromerBothe );
    TPF_KB_MIN_SPLIT ( 1 );
    TPF_KB_FAN ( auto );
    TPF_ANCHOR_METHOD ( ccs );
    // the grazing-cut rule of the cell cut (PORT-DESIGN 1.2 item 1; Tomislav's policy of
    // 2026-11-07): fork wherever a number is reproduced against the fork's record (the
    // standing matrix's DAVOF rows against the fork track), openfoam otherwise
    TPF_GRAZING_CUT ( openfoam );
    TPF_ANCHOR_SKIP_CONVERGED ( true );
    TPF_SWEPT_PRE_TEST ( touching );
    TPF_SWEPT_STATE_SHORTCUT ( false );
    TPF_SWEPT_TRACE_CACHE ( true );
    TPF_FLUX_INTEGRATION ( sweptFaceCells );
    TPF_SWEPT_CLASSIFY ( false );
    TPF_SWEPT_SCALE ( true );
    TPF_SWEPT_VOLUME_CORRECTION ( pyramid );
    TPF_SWEPT_WISP_SURFACE ( matched );
    TPF_SWEPT_WISP_TOL ( 0 );
    TPF_SWEPT_WISP_MATCH_TOL ( 1e-9 );
    TPF_SWEPT_FACE_UPDATE ( pieces );
    TPF_SWEPT_COPLANAR ( donorSide );
    TPF_SWEPT_DUMP ( false );
    TPF_PLANE_SOURCE ( anchor );
    TPF_SWEPT_FACE_LOG ( false );
    TPF_SWEPT_CAP_SET ( final );
    TPF_SWEPT_CONSISTENCY_LOG ( false );
    TPF_SWEPT_CONSISTENT ( true );
    TPF_SWEPT_AXIS_PLANES ( true );
    TPF_SWEPT_TET_CACHE ( true );
    TPF_SWEPT_POINT_VELOCITY_LAZY ( true );
    TPF_SWEPT_PRE_TEST_COPLANAR_SIDE ( true );
    TPF_FACE_STATE ( scalar );
    TPF_TENSOR_CENTROID ( cut );
    TPF_KB_PRISM_APEX ( vertexMean );
    TPF_CURVED_TOL_REL ( 1e-11 );
    TPF_CURVED_MAX_DEPTH ( 9 );
    TPF_WRITE_TENSOR ( false );
    // the timed repetitions of the standing matrix (config/davof/standing): identical
    // runs numbered 1, 2, 3 (a comment line of controlDict carries the number, so every
    // repetition is its own case with its own stamp); 1 for a study without them
    TPF_REPETITION ( 1 );
    // the setting of the Enright agent's decisions 1-3 (tpf_rows.ENRIGHT_SETTINGS,
    // 2026-11-07): reference = closure, no bounded face fractions, normalOnly
    TPF_ENRIGHT_SETTING ( reference );
    // the iterative face-fraction corrector of the davof reconstruction (leia
    // davof-iter, 2026-11-09; davof.H): none renders no key (the dictionaries of
    // every earlier study stay byte for byte); mean renders faceFractionCorrector,
    // correctorIterations, correctorTolerance, correctorLog (materialize.py,
    // TPF_CORRECTOR_KEYS). TPF_ADVECTION_SCHEME auto = the route's scheme
    // (davofSwept for the davof rows, isoAdvector for the comparators);
    // isoAdvector = the DAVOF reconstruction under OpenFOAM's isoAdvection
    // (the leia route only)
    TPF_FACE_FRACTION_CORRECTOR ( none );
    TPF_CORRECTOR_ITERATIONS ( 1 );
    TPF_CORRECTOR_TOLERANCE ( 1e-12 );
    TPF_CORRECTOR_LOG ( true );
    TPF_ADVECTION_SCHEME ( auto );
    // the normal-order study (leia davof-normal-order, 2026-11-12; materialize.py):
    // true renders sweptExactFluxError (the per-step flux error against the exact
    // flux of the translated sphere); a scheme other than none renders
    // youngsGradScheme (the Youngs model's gradient; Gauss_linear -> "Gauss linear")
    TPF_EXACT_FLUX_ERROR ( false );
    TPF_YOUNGS_GRAD_SCHEME ( none );
    // the bias test (2026-11-13; materialize.py): tilt of the ringTilt model, its mode,
    // and the position diagnostic of the davof reconstruction
    TPF_TILT_C ( none );
    TPF_TILT_MODE ( biased );
    TPF_POSITION_DIAG ( false );
}
