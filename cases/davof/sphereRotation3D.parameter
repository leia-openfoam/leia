// The solid-body rotation benchmark of the DAVOF face update (2026-10-28,
// fork branch davof-swept), driven through the TwoPhaseFlow fork's
// advectorVoF: the value test of the semi-Lagrangian swept-face flux
// (TPF_FLUX_INTEGRATION sweptFace) against the prism flux, whose pre-image
// is the face translated by the displacement of its centre.
//
// A sphere of radius 0.15 at (0.5 0.5 0.5) in the 2 x 1 x 1 box turns once
// about the axis parallel to y through (TPF_AXIS_X . TPF_AXIS_Z) =
// (0.75 . 0.5), i.e. on the circle of radius 0.25 in the x-z plane (the
// sphere stays inside x in [0.35, 1.15], z in [0.1, 0.9]). The velocity
// U = (-omega (z - 0.5), 0, omega (x - 0.75)), omega = TPF_OMEGA = 2 pi
// rad/s, is set every step by the fork's setFlow block of fvSolution
// (OpenFOAM's functionObjects::setFlow, mode rotation, refDir (1 0 0), axis
// (0 1 0): the rotation about the global y axis with the angular velocity
// vector (0 -omega 0)); END_TIME 1 is one full turn, after which the sphere
// is back at its start. The arm TPF_VELOCITY_ARM rotation renders
// TPF_UX/UY/UZ = 0 (the exact body's U0); the exact normal model and
// areaFractionError take the turn from omega and axisPoint (fork
// davofOrbit.H). The fixed step is dt = Co h / REFERENCE_SPEED with
// REFERENCE_SPEED 2.5, the speed of the sphere's far point
// (omega (0.25 + 0.15) = 2.51): the interface runs at Co 0.2, the far corner
// of the box (pure gas) at 0.68; 400 steps per turn at N = 32, 800 at N = 64.
//
// The state is the exactSphere construction of initDavofFields (the study
// sets TPF_DAVOF_METHOD); areaFractionError against the exact state of the
// turned sphere every step; volumeFractionError's Eshape is against the
// INITIAL sphere, so only its end value (one full turn) is a shape error,
// Emass and Ebound hold at every step.
values
{
    solver (advectorVoF);

    N_CELLS ( 32 64 );

    TARGET_ADVECTIVE_CO ( 0.2 );

    TPF_ROW ( davof-planeSurf-exact davof-planeSurf-ringArea );

    // the face-clipping model (plane | planeSagitta) is DERIVED from TPF_ROW
    // by tpf_rows.row_tokens; the value here documents the default
    TPF_FACE_CLIPPING ( plane );

    // the clipping surface of the dual advection (none | exactSphere |
    // paraboloid | plane), DERIVED from TPF_ROW as well
    TPF_CLIPPING_SURFACE ( none );
    TPF_FIT_ANCHOR ( faces );
    TPF_FIT_DOF ( six );
    TPF_CURVED_DEBUG ( false );
    TPF_VOLUME_RULE ( kromerBothe );
    TPF_KB_MIN_SPLIT ( 1 );
    TPF_KB_FAN ( auto );
    TPF_ANCHOR_METHOD ( ccs );
    // the plane positioning of the davof reconstruction (fork davof-swept
    // 2026-11-04): vofCutCell (the fork's default) | ccs; its tolerance of V;
    // and the anchor skip of planes ccs left within anchorTolRel (opt-in)
    // The defaults of the ten tokens positioning, anchorSkipConverged, sweptPreTest,
    // sweptTraceCache, sweptVolumeCorrection, sweptWispSurface, sweptWispTol,
    // sweptWispMatchTol and sweptConsistent are the fork's reference setting
    // (davof-swept 407f969, 2026-11-04; fork etc/README-davof.md "The reference
    // setting"); a study that wants the path before it pins the old values
    // (vofCutCell, false, none, false, auto, none, 1e-8, 1e-11, false).
    TPF_POSITIONING ( ccs );
    TPF_POSITIONING_TOL ( 1e-14 );
    TPF_GRAZING_CUT ( openfoam );
    TPF_ANCHOR_SKIP_CONVERGED ( true );
    // the pre-test and the state shortcut of sweptFaceCells (fork 3aaf49d):
    // none / false = the path of 720cfc6 (the fork's own defaults since
    // 3aaf49d are touching / true)
    TPF_SWEPT_PRE_TEST ( touching );
    TPF_SWEPT_STATE_SHORTCUT ( false );
    TPF_SWEPT_TRACE_CACHE ( true );
    // the four bit-for-bit keys of round 4 and the two round-off opt-ins of the
    // swept-face flux (fork davof-swept c5c00c5, 2026-11-05; the fork's defaults)
    TPF_SWEPT_AXIS_PLANES ( false );
    TPF_SWEPT_TET_CACHE ( false );
    TPF_SWEPT_POINT_VELOCITY_LAZY ( false );
    TPF_SWEPT_PRE_TEST_COPLANAR_SIDE ( false );
    TPF_SWEPT_FACE_UPDATE_FROM_VOLUME ( false );
    TPF_SWEPT_SLIVER_CLOSED_FORM ( false );
    // the volume flux of a face: prism | trapezoidal | simpson | simpsonSplit |
    // simpsonSplitS | gaussSplit | sweptFace (the swept-face flux, fork branch
    // davof-swept, 2026-10-28; planes only)
    TPF_FLUX_INTEGRATION ( prism );
    // the pre-image classification diagnostic (fork davof-swept, 2026-10-29;
    // builds before it ignore the key): false inert, true the per-step class
    // counts, the first unbounded cell and the mass through the bounding
    TPF_SWEPT_CLASSIFY ( false );
    // the kinematic consistency of the swept fluxes (fork davof-swept,
    // 2026-10-29; builds before it ignore the key): true scales the swept
    // liquid volume by phi_f dt / V_swept (a wholly wet swept volume gives
    // the upwind flux of a full cell), false keeps the geometric volume
    TPF_SWEPT_SCALE ( false );
    // the volume correction of the swept fluxes, the fork's default
    TPF_SWEPT_VOLUME_CORRECTION ( pyramid );
    // the bounding of isoAdvection (2026-11-03), the template's values before
    TPF_N_ALPHA_BOUNDS ( 3 );
    TPF_SNAP_TOL ( 0 );
    TPF_CLIP ( false );
    // the surface of a wisp's pieces in sweptFaceCells (2026-11-02): none,
    // the fork's default | neighbour
    TPF_SWEPT_WISP_SURFACE ( matched );
    // the band of the wisp class (2026-11-03), the fork's default
    TPF_SWEPT_WISP_TOL ( 0 );
    // the match tolerance of sweptWispSurface matched, the fork's default
    TPF_SWEPT_WISP_MATCH_TOL ( 1e-9 );
    // the alpha boundary condition of the three patches (2026-10-29):
    // zeroGradient (the runs until the ladder) | inletOutlet (zero on the
    // inflow faces; the boundary term of the mass balance vanishes)
    TPF_ALPHA_BC ( zeroGradient );
    // sweptFaceCells: the face update pieces (the same clip as the flux) |
    // donor (the donor's plane alone, as sweptFace); fork davof-swept,
    // 2026-10-29; builds before it ignore the key
    TPF_SWEPT_FACE_UPDATE ( pieces );
    // sweptFaceCells, the face update: a pre-image part lying in a cell
    // plane goes to the donor's side (donorSide, the fork's default since
    // 2026-10-29) or to both cells (both, the defect); the one-step face
    // dump postProcessing/sweptFaceDump/{faces,pieces}.csv (false: none)
    TPF_SWEPT_COPLANAR ( donorSide );
    TPF_SWEPT_DUMP ( false );
    // clippingSurface plane: anchor (the volume-anchored plane of the used
    // normal, the fork's default) | exact (the tangent plane of the exact
    // sphere, a diagnostic control without the anchor; 2026-11-01)
    TPF_PLANE_SOURCE ( anchor );
    // the per-face log of the swept fluxes per step and rank (fork
    // davof-swept-par, 2026-10-30; the decomposition comparison) and the
    // field write precision (12; 17 for that comparison)
    TPF_SWEPT_FACE_LOG ( false );
    TPF_WRITE_PRECISION ( 12 );
    // the cap set of a piece of sweptFaceCells (fork davof-swept 2026-11-02):
    // final (order-independent, the default) | crossing (the earlier rule)
    TPF_SWEPT_CAP_SET ( final );
    // the consistency of sweptFaceCells under oblique travel (fork
    // davof-swept c635611, 2026-11-02; builds before it ignore the keys):
    // the serial diagnostic of the algebraic faces, the wisp pieces and the
    // per-cell residue (postProcessing/sweptConsistency), and the consistent
    // variant (the candidates extended to the vertex ring of the active
    // cells, a piece without a surface alpha_c V_piece); false: inert
    TPF_SWEPT_CONSISTENCY_LOG ( false );
    TPF_SWEPT_CONSISTENT ( true );
    TPF_FACE_STATE ( scalar );
    TPF_TENSOR_CENTROID ( cut );
    TPF_KB_PRISM_APEX ( vertexMean );

    TPF_CURVED_TOL_REL ( 1e-11 );
    TPF_CURVED_MAX_DEPTH ( 9 );

    TPF_VELOCITY_ARM ( rotation );

    // the rotation: omega in rad/s (2 pi: one turn in END_TIME 1) and the
    // axis parallel to y through (TPF_AXIS_X, ., TPF_AXIS_Z)
    TPF_OMEGA ( 6.283185307179586 );
    TPF_AXIS_X ( 0.75 );
    TPF_AXIS_Z ( 0.5 );

    // the velocity field (2026-11-01): rotation (setFlow mode rotation, the
    // solid-body rotation above) | function (setFlow mode function, the
    // circular translation WITHOUT spin: the spatially uniform
    // U(t) = omega_vec x (c(t) - axisPoint), omega_vec = (0 -TPF_OMEGA 0),
    // c(t) the orbit of the sphere's centre, so that the centre runs on the
    // same circle in the same sense; for a sphere the exact state equals the
    // rotation's at every t; see the setFlow block of fvSolution)
    TPF_SETFLOW_MODE ( rotation );

    TPF_DAVOF_METHOD ( exactSphere );

    TPF_REF_METHOD ( exactSphere );

    DOMAIN_LENGTH ( 1 );

    END_TIME ( 1 );

    TIME_STEP_CONTROL ( advective );

    REFERENCE_SPEED ( 2.5 );

    TPF_WISP_TOL ( 1e-3 );

    TPF_REPEAT ( 1 );

    TPF_INTERPOLATE_NORMAL ( true );

    TPF_WRITE_TENSOR ( false );

    TPF_SPHERE_RADIUS ( 0.15 );

    TPF_SPHERE_CX ( 0.5 );
    TPF_SPHERE_CY ( 0.5 );
    TPF_SPHERE_CZ ( 0.5 );

    // controlDict writeInterval [s] (adjustableRunTime): four field writes
    TPF_WRITE_INTERVAL ( 0.25 );

    TPF_AFE_WRITE_CONTROL ( timeStep );
    TPF_AFE_WRITE_INTERVAL ( 1 );
    TPF_AFE_CONSISTENCY ( false );
    TPF_AFE_WRITE_FACE_ERROR ( false );
    // the counted faces per write as CSV (fork 2026-11-02, faceErrorCsv)
    TPF_AFE_FACE_CSV ( false );
    TPF_RECON_ERROR_EVERY_STEP ( false );
    TPF_VFE_WRITE_CONTROL ( timeStep );
    TPF_VFE_WRITE_INTERVAL ( 1 );
    TPF_PROFILING ( false );
    // the setting of the Enright agent's decisions 1-3 (tpf_rows.ENRIGHT_SETTINGS,
    // 2026-11-07): reference = closure, no bounded face fractions, normalOnly
    TPF_ENRIGHT_SETTING ( reference );
    // the iterative face-fraction corrector of the davof reconstruction (leia
    // davof-iter, 2026-11-09; davof.H): none renders no key (the dictionaries of
    // every earlier study stay byte for byte); mean renders faceFractionCorrector,
    // correctorIterations, correctorTolerance, correctorLog (materialize.py,
    // TPF_CORRECTOR_KEYS). TPF_ADVECTION_SCHEME auto = the route's scheme
    // (davofSwept for the davof rows, isoAdvector for the comparators);
    // isoAdvector = the DAVOF reconstruction under OpenFOAM's isoAdvection
    // (the leia route only)
    TPF_FACE_FRACTION_CORRECTOR ( none );
    TPF_CORRECTOR_ITERATIONS ( 1 );
    TPF_CORRECTOR_TOLERANCE ( 1e-12 );
    TPF_CORRECTOR_LOG ( true );
    TPF_ADVECTION_SCHEME ( auto );
    // the normal-order study (leia davof-normal-order, 2026-11-12; materialize.py):
    // true renders sweptExactFluxError (the per-step flux error against the exact
    // flux of the translated sphere); a scheme other than none renders
    // youngsGradScheme (the Youngs model's gradient; Gauss_linear -> "Gauss linear")
    TPF_EXACT_FLUX_ERROR ( false );
    TPF_YOUNGS_GRAD_SCHEME ( none );
}
