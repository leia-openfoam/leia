FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Read by leiaSetFields (psi = exact signed distance, alpha.water by the
// Detrixhe-Aslam plane indicator) and by leiaTestDavofNormal (the surface).
// The sphere centre is a literal in metres, shared bit-identically with the
// TwoPhaseFlow benchmark run/benchmark/reconstruction/sphereNormal3D: it sits
// off every mesh symmetry plane and off every grid line and cell centre of the
// N = 20/40/80/160 ladder on the 0.004 m box, so no rung is superconvergent by
// symmetry.
levelSet
{
    profile
    {
        type    signedDistance;
    }

    implicitSurface
    {
        type    implicitSphere;
        center  (@!DAVOF_SPHERE_CENTRE_X!@ @!DAVOF_SPHERE_CENTRE_Y!@ @!DAVOF_SPHERE_CENTRE_Z!@);
        radius  @!DROPLET_RADIUS!@;
    }

    narrowBand
    {
        type    signChange;
    }

    phaseIndicator
    {
        type            detrixheAslam;
        geometrySource  levelSetField;
    }
}

// The DAVOF state (libleiaDavof) and the norms of leiaTestDavofNormal.
//   alphaSource detrixheAslam      : exact signed distance at cell centre, face
//                                    centres and points, linear on the tets --
//                                    ONE C0 piecewise-linear surface, the
//                                    Gauss identity is exact for it.
//   alphaSource planePhaseIndicator: leia's production plane per band cell
//                                    (detrixheAslam) with the central face
//                                    average -- what the SL solver transports.
//   wispTol: a cell is an interface cell when |m_c| > wispTol V_c^(2/3).
//   crossCheck geometricVoF: OpenFOAM's plicRDF / gradAlpha / isoAlpha run on
//                                    the SAME alpha.davof, scored the same way.
davof
{
    alphaSource     @!DAVOF_ALPHA_SOURCE!@;
    wispTol         @!DAVOF_WISP_TOL!@;
    // Zero-step regeneration arm (davofRegeneration.H): none | plane |
    // paraboloidPlane | paraboloidFaces | paraboloidVolume; the paraboloid
    // arms take the ring tensor from the first curvature model.
    regenerate      @!DAVOF_REGEN_ARM!@;

    // Curvature of the DAVOF state (libleiaDavof curvature/), none by default
    // on the sphere gate; the regeneration study switches normalsOnly on.
    curvature
    {
        models      (@!DAVOF_CURV_MODEL_1!@ @!DAVOF_CURV_MODEL_2!@);   // none entries are skipped

        normalsOnly
        {
            type            quadricFit;
            positionWeight  0;
            weighting       area;
            minNeighbours   5;
            alignTol        0.2;
        }
        hermite
        {
            type            quadricFit;
            positionWeight  1;
            weighting       area;
            minNeighbours   5;
            alignTol        0.2;
        }
    }

    crossCheck
    {
        set         @!DAVOF_CROSS_CHECK!@;
        models      (plicRDF gradAlpha isoAlpha);

        // The DLR reconstruction benchmark's settings
        // (run/benchmark/surfaceTension/curvatureSphere/curvature3D/system/fvSolution).
        plicRDF
        {
            reconstructionScheme    plicRDF;
            iterations              10;
            interpolateNormal       false;
            tol                     1e-8;
            relTol                  0.1;
            surfCellTol             1e-8;
            isoFaceTol              1e-8;
        }
        gradAlpha
        {
            reconstructionScheme    gradAlpha;
            surfCellTol             1e-8;
            isoFaceTol              1e-8;
        }
        isoAlpha
        {
            reconstructionScheme    isoAlpha;
            surfCellTol             1e-8;
            isoFaceTol              1e-8;
        }
    }
}

