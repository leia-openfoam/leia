FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        // the route (DAVOF_SOLVER -> the Snakefile): isoAdvection on the fork
        // route; davofSwept (the davof rows) | isoAdvector (the comparators,
        // OpenFOAM's isoAdvection) on the leia route (materialize.py, 2026-11-06)
        advectionScheme      @!DAVOF_ADVECTION_SCHEME!@;
        // The row TPF_ROW (workflow/scripts/tpf_rows.py): the reconstruction
        // scheme (davof | plicRDF | isoAlpha) and, for davof, the normal
        // model; the comparators ignore the davof keys below.
        reconstructionScheme @!TPF_RECON_SCHEME!@;
        // davof: interface cell |m_c| > wispTol V^(2/3)
        wispTol         @!TPF_WISP_TOL!@;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        // the plane positioning of the reconstruction (fork davof-swept
        // 2026-11-04; builds before it ignore the keys): vofCutCell (the
        // fork's default, surfaceIteratorPLIC to isoFaceTol) | ccs (Consecutive
        // Cubic Spline on the same cut from the explicit position, to
        // positioningTol of V or the round-off floor)
        positioning     @!TPF_POSITIONING!@;
        positioningTol  @!TPF_POSITIONING_TOL!@;
        // the grazing-cut rule of the cell cut (leia 2026-11-06, PORT-DESIGN 1.2):
        // openfoam (v2606's cutCellPLIC, the default) | fork (the TwoPhaseFlow
        // threshold 10*SMALL, the opt-in copy); the fork's binary ignores the key
        grazingCut      @!TPF_GRAZING_CUT!@;
        // plicRDF's initial guess (the helper inside davof and the comparator alike):
        // true = the previous normals shifted back by U dt (the library's default),
        // false = the alpha gradient every time (the hexInterp diagnostic)
        interpolateNormal @!TPF_INTERPOLATE_NORMAL!@;
        // davof: the normal model (davofNormalModel.H) and where it replaces
        // m_c (applyTo all, or check: the slivers |m_c| < sliverTol h^2 and
        // the cells deviating by more than maxAngle degrees); exactNormal
        // is the translated sphere of the exact control
        normalModel     @!TPF_NORMAL_MODEL!@;
        applyTo         @!TPF_APPLY_TO!@;
        sliverTol       @!TPF_SLIVER_TOL!@;
        maxAngle        @!TPF_MAX_ANGLE!@;
        noNormalFallback @!TPF_NO_NORMAL_FALLBACK!@;
        // davof: the face-clipping model of the face update (fork
        // davofFaceClipping.H, 2026-10-15): plane (the plane clipping of the
        // moved PLIC plane, the default) or planeSagitta (plus the
        // second-order sagitta correction from the ring curvature tensor);
        // the sub-keys at the fork's defaults, read by planeSagitta only
        faceClipping    @!TPF_FACE_CLIPPING!@;
        sagittaMinCos   0.2;
        sagittaMinChord 0.05;
        sagittaMaxFraction 0.25;
        sagittaForm     full;
        tensorSource    ring;
        // davof: write the ring curvature tensor and the vertex offset the
        // sagitta correction uses (curvatureTensorDavof, curvatureOffsetDavof)
        // at the field writes (the diagnostic of 2026-10-16; false: not written)
        writeCurvatureTensor @!TPF_WRITE_TENSOR!@;
        // planeSagitta: the signed correction dA/|S_f| per face written as the
        // surface field sagittaCorrection.water (the same diagnostic switch)
        writeSagittaCorrection @!TPF_WRITE_TENSOR!@;
        // davof: the curved clipping surface of the dual advection (fork
        // isoAdvectionCurved.C, 2026-10-23), derived from TPF_ROW: none (the
        // plane sweep, today's loop), exactSphere (the exact sphere of the
        // exactNormal block for the volume flux AND the face update: the
        // machinery gate) or paraboloid (the six-coefficient paraboloid of
        // every interface cell fitted to its own face fractions with the ring
        // tensor as prior, with its own volume flux); the sub-keys at the
        // fork's defaults (the prism quadrature's relative tolerance and
        // depth, the fit's prior weight, tolerance and iteration cap, the
        // refinement levels of the surface-defect volume)
        clippingSurface @!TPF_CLIPPING_SURFACE!@;
        curvedTolRel    @!TPF_CURVED_TOL_REL!@;
        curvedMaxDepth  @!TPF_CURVED_MAX_DEPTH!@;
        // the rule for the cell volume, the prism volume and the face fraction
        // under a surface: splitQuadrature (the reference) | kromerBothe (the
        // face-based method of Kromer and Bothe 2023 for the paraboloid) |
        // exactSphere (Strobl, Formella, Poeschel 2016 for the sphere)
        volumeRule      @!TPF_VOLUME_RULE!@;
        volumeRuleDebug @!TPF_CURVED_DEBUG!@;
        // the Kromer-Bothe rule's checks: the least number of sub-arcs per
        // trace arc and the fan triangulation of the planar faces
        kromerBotheMinSplit @!TPF_KB_MIN_SPLIT!@;
        kromerBotheFan  @!TPF_KB_FAN!@;
        // warped faces (fork branch davof-warped, 2026-10-25): the face state
        // scalar (alphaf alone) | vector (the wetted area vector
        // wettedAreaDavof next to alphaf, m_c and the face moment from it;
        // initDavofFields writes it with the same token), the centroids of
        // the ring tensor fit cut | anchored (re-anchored by the volume
        // rule), the fan apex of a warped flux prism vertexMean | faceCentre;
        // the defaults are the build's behaviour before the keys
        faceState       @!TPF_FACE_STATE!@;
        tensorCentroid  @!TPF_TENSOR_CENTROID!@;
        kromerBothePrismApex @!TPF_KB_PRISM_APEX!@;
        fitPriorWeight  1e-2;
        fitTol          1e-10;
        fitMaxIter      50;
        // faces: the surface interpolates the face fractions; volume: the offset
        // shifted after the fit so that the volume under the surface is alpha_k V
        fitAnchor       @!TPF_FIT_ANCHOR!@;
        // six: all six coefficients from the face fractions; one: the offset alone
        // from the total wetted area; none: the frame and the ring tensor only
        fitDof          @!TPF_FIT_DOF!@;
        // the volume anchor's tolerance (of the cell volume) and the period of the
        // surface-defect diagnostic in steps
        anchorTolRel    1e-11;
        // the anchor's root finder (fork branch davof-perf): illinois | newton
        // (ignored by the builds before it)
        anchorMethod    @!TPF_ANCHOR_METHOD!@;
        // keep a plane that positioning ccs left within the anchor's tolerance
        // without the anchor (fork davof-swept 2026-11-04; opt-in, default false)
        anchorSkipConverged @!TPF_ANCHOR_SKIP_CONVERGED!@;
        // the pre-test of a ring cell before the clips and the state shortcut of
        // sweptFaceCells (fork davof-swept 3aaf49d, 2026-11-04, whose FORK
        // defaults are touching and true): none and false reproduce the path
        // of 720cfc6 (the comparison of 2026-11-03); builds before 3aaf49d
        // ignore the keys
        sweptPreTest    @!TPF_SWEPT_PRE_TEST!@;
        sweptStateShortcut @!TPF_SWEPT_STATE_SHORTCUT!@;
        // the per-step trace cache of the mesh points (fork davof-swept 557fab7,
        // 2026-11-04, bit for bit; builds before it ignore the key)
        sweptTraceCache @!TPF_SWEPT_TRACE_CACHE!@;
        // the four bit-for-bit keys of round 4 (fork davof-swept c5c00c5, opt-in
        // there, default false; builds before it ignore them): the axis-aligned
        // plane clips, the cached cell tetrahedra, the band-only point velocity
        // and the coplanar-side pre-test; and the two round-off opt-ins (the
        // face update from the volume clip, the sliver piece in closed form)
        sweptAxisPlanes @!TPF_SWEPT_AXIS_PLANES!@;
        sweptTetCache   @!TPF_SWEPT_TET_CACHE!@;
        sweptPointVelocityLazy @!TPF_SWEPT_POINT_VELOCITY_LAZY!@;
        sweptPreTestCoplanarSide @!TPF_SWEPT_PRE_TEST_COPLANAR_SIDE!@;@!TPF_ENRIGHT_KEYS!@
        sweptFaceUpdateFromVolume @!TPF_SWEPT_FACE_UPDATE_FROM_VOLUME!@;
        sweptSliverClosedForm @!TPF_SWEPT_SLIVER_CLOSED_FORM!@;
        // the volume flux of a face (fork branch davof-fluxint): prism (the
        // prism volume) | trapezoidal | simpson (a quadrature in time of the
        // face fractions; ignored by the builds before it)
        fluxIntegration @!TPF_FLUX_INTEGRATION!@;
        // the kinematic consistency of the swept fluxes (sweptScaleToPhi, fork
        // davof-swept; added here 2026-11-02, default false = the fork's
        // default, so the studies before it render the same dictionary values)
        sweptScaleToPhi @!TPF_SWEPT_SCALE!@;
        // the volume correction of the swept fluxes (2026-11-03): auto (the
        // mode of sweptScaleToPhi, the fork's default) | none | scale | pyramid
        sweptVolumeCorrection @!TPF_SWEPT_VOLUME_CORRECTION!@;
        // sweptFaceCells: the surface of a wisp's pieces (a cell without a
        // surface and with 1e-8 < alpha < 1 - 1e-8): none (0/1 by alpha, the
        // fork's default) | neighbour (the plane of its closest face neighbour
        // with a surface); fork davof-swept 2026-11-02, builds before it ignore it
        sweptWispSurface @!TPF_SWEPT_WISP_SURFACE!@;
        // the band of the wisp class (2026-11-03): full for alpha >= 1 - tol, empty
        // for alpha <= tol (1e-8 the fork's default; 0: every partial cell)
        sweptWispTol @!TPF_SWEPT_WISP_TOL!@;
        // sweptWispSurface matched: the match tolerance of V (2026-11-03)
        sweptWispMatchTol @!TPF_SWEPT_WISP_MATCH_TOL!@;
        // sweptFaceCells: the vertex-ring candidates (fork default false)
        sweptConsistent @!TPF_SWEPT_CONSISTENT!@;
        defectEvery     10;
        curvedDebug     @!TPF_CURVED_DEBUG!@;
        defectLevels    3;
        writeCurvedFields @!TPF_WRITE_TENSOR!@;
        exactNormal
        {
            functionType sphere;
            origin      (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
            radius      @!TPF_SPHERE_RADIUS!@;
            U0          (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        }
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         0;
        nAlphaBounds    3;
        clip            false;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

// advectorVoF reads period/reverseTime/spirallingFlow here (none: uniform
// translation) and the abort guard (fork commit a5901fd, 2026-10-13): the run
// ends with "advectorVoF: ABORT at step ..." and the normal "End" when alpha
// leaves [abortMinAlpha, abortMaxAlpha] or the interface-cell count exceeds
// abortInterfaceCellFactor times its count at the first step; the leia
// converter tpf_advection_metrics.py records the row as status diverged.
isoAdvector
{
    abortEnabled    true;
    abortMinAlpha   -0.5;
    abortMaxAlpha   1.5;
    abortInterfaceCellFactor 10;
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

// ************************************************************************* //
