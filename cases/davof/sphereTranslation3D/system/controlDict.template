FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The sphere-translation benchmark of the DAVOF face update: the dictionaries
// of TwoPhaseFlow run/benchmark/advection/sphereTranslation3D with the values
// from the study tokens (cases/davof/sphereTranslation3D.parameter).

application     advectorVoF;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         @!END_TIME!@;

// Fixed time step generated by workflow/scripts/materialize.py.
//   mode=@!TIME_STEP_CONTROL!@
//   target advective Co=@!TARGET_ADVECTIVE_CO!@
//   reference domain length=@!DOMAIN_LENGTH!@ m
//   reference speed=@!REFERENCE_SPEED!@ m/s
// dt = Co h / |U| with h = DOMAIN_LENGTH/N_CELLS (the box height 1 over N) and
// |U| = REFERENCE_SPEED = 1; END_TIME 1 carries the sphere by one unit
// (3.3 diameters) in N / Co steps.
deltaT          @!MAX_DELTA_T!@;

writeControl    adjustableRunTime;
writeInterval   @!TPF_WRITE_INTERVAL!@;

purgeWrite      0;

writeFormat     ascii;
writePrecision  12;
writeCompression off;

timeFormat      general;
timePrecision   10;

graphFormat     raw;

runTimeModifiable no;

// The step is fixed above; the Courant limits are required by the solver and inert.
adjustTimeStep  no;
maxCo           1e6;
maxAlphaCo      1e6;
maxDeltaT       1e6;

functions
{
    // The transported face fractions against the EXACT DAVOF state
    // (exactSphere) of the sphere translated by U0 t, every step (the davof
    // rows; -1 for the comparators), and the reconstruction error of the
    // scheme (normal, centre) at the end time:
    // postProcessing/areaFractionError/0/areaFractionError.dat and
    // postProcessing/reconstructionError/0/error.dat.
    areaFractionError
    {
        type            areaFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    sphere;
        origin          (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        radius          @!TPF_SPHERE_RADIUS!@;
        U0              (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
        davofMethod     @!TPF_REF_METHOD!@;   // exactSphere on axis-aligned hexahedra, quadraticFaces on perturbed meshes
        wispTol         @!TPF_WISP_TOL!@;
        reconstructionError true;
        reconstructionErrorEveryStep false;
        writeControl    timeStep;
        writeInterval   1;
        writePrecision  12;
    }
    // Eshape = sum |alpha - alpha_exact| V against the translated sphere (the
    // linear interpolant at the mesh points cut by cutCellIso), the mass
    // error and the boundedness error, every step:
    // postProcessing/volumeFractionError/0/volumeFractionError.dat.
    volumeFractionError
    {
        type            volumeFractionError;
        libs            ("libpostProcess.so");
        field           alpha.water;
        functionType    sphere;
        origin          (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        radius          @!TPF_SPHERE_RADIUS!@;
        writeControl    timeStep;
        writeInterval   1;
        writePrecision  12;
    }
}

