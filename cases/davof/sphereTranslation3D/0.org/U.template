FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The uniform velocity of the arm TPF_VELOCITY_ARM (tpf_rows.velocity_tokens):
// axial = (1 0 0), the sphere carried along the 2 x 1 x 1 box.
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
}

