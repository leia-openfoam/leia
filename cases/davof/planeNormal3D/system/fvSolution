FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}

levelSet
{
    profile
    {
        type            signedDistance;
    }
    implicitSurface
    {
        type            implicitPlane;
        position        ( 0.00213 0.00171 0.00197 );
        normal          ( 0.3 0.5 0.8124 );
    }
    narrowBand
    {
        type            signChange;
    }
    phaseIndicator
    {
        type            detrixheAslam;
        geometrySource  levelSetField;
    }
}

davof
{
    alphaSource     linearInterpolant;
    wispTol         0.001;
    crossCheck
    {
        set             geometricVoF;
        models          ( plicRDF gradAlpha isoAlpha );
        plicRDF
        {
            reconstructionScheme plicRDF;
            iterations      10;
            interpolateNormal false;
            tol             1e-08;
            relTol          0.1;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
        gradAlpha
        {
            reconstructionScheme gradAlpha;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
        isoAlpha
        {
            reconstructionScheme isoAlpha;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
    }
}


