FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The fixed time step (materialize._with_derived_tokens, the tokens below are
// named here so that the workflow carries them into the case):
//   mode=@!TIME_STEP_CONTROL!@
//   target advective Co=@!TARGET_ADVECTIVE_CO!@
//   reference domain length=@!DOMAIN_LENGTH!@ m
//   reference speed=@!REFERENCE_SPEED!@ m/s
// dt = Co h / REFERENCE_SPEED with h = DOMAIN_LENGTH/N_CELLS.
// the route (DAVOF_SOLVER -> the Snakefile): advectorVoF (the fork) or davofAdvectorFoam (leia)
application     @!DAVOF_APP!@;
// the repetition of the standing matrix (TPF_REPETITION): @!TPF_REPETITION!@

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         @!END_TIME!@;
deltaT          @!MAX_DELTA_T!@;
writeControl    adjustableRunTime;
writeInterval   @!TPF_WRITE_INTERVAL!@;
purgeWrite      0;
writeFormat     ascii;
writePrecision  @!TPF_WRITE_PRECISION!@;
writeCompression off;
timeFormat      general;
timePrecision   10;
graphFormat     raw;
runTimeModifiable no;
adjustTimeStep  no;
maxCo           1e6;
maxAlphaCo      1e6;
maxDeltaT       1e6;

// OpenFOAM's profiling (uniform/profiling at the writes): the time in
// reconstruct() and advect() (addProfilingInFunction geometricVoF), the
// reconstruction's share of the step; off in the timed runs
profiling
{
    active          @!TPF_PROFILING!@;
}

functions
{
    // the contact points and angles of every step's reconstruction (M. Fricke, T. Maric, D. Bothe,
    // J. Comput. Phys. 407 (2020) 109221, doi:10.1016/j.jcp.2019.109221, arXiv:1907.01785)
    contactLineError
    {
        type            contactLineError;
        libs            (@!DAVOF_FO_LIBS!@);
        field           alpha.water;
        wallPatch       wall;
        dumpCandidates  @!TPF_CL_DUMP!@;
        executeControl  timeStep;
        executeInterval 1;
        writePrecision  17;
    }
}
