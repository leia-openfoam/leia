FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}

levelSet
{
    profile
    {
        type            signedDistance;
    }
    implicitSurface
    {
        type            implicitPlane;
        position        ( 0.00213 0.00171 0.00197 );
        normal          ( 0.3 0.5 0.8124 );
    }
    narrowBand
    {
        type            signChange;
    }
    phaseIndicator
    {
        type            detrixheAslam;
        geometrySource  levelSetField;
    }
}

davof
{
    alphaSource     @!DAVOF_ALPHA_SOURCE!@;
    wispTol         @!DAVOF_WISP_TOL!@;

    // Curvature of the DAVOF state (libleiaDavof curvature/): none by default
    // (default.parameter); the mesh-class ladders of 2026-10-12 switch
    // normalsOnly on, because the curvature of a plane must be at round-off
    // on every mesh class (prediction P11). "none" entries are skipped.
    curvature
    {
        models      (@!DAVOF_CURV_MODEL_1!@ @!DAVOF_CURV_MODEL_2!@);

        normalsOnly
        {
            type            quadricFit;
            positionWeight  0;
            weighting       area;
            minNeighbours   5;
            alignTol        0.2;
        }
        hermite
        {
            type            quadricFit;
            positionWeight  1;
            weighting       area;
            minNeighbours   5;
            alignTol        0.2;
        }
    }

    crossCheck
    {
        set             @!DAVOF_CROSS_CHECK!@;
        models          ( plicRDF gradAlpha isoAlpha );
        plicRDF
        {
            reconstructionScheme plicRDF;
            iterations      10;
            interpolateNormal false;
            tol             1e-08;
            relTol          0.1;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
        gradAlpha
        {
            reconstructionScheme gradAlpha;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
        isoAlpha
        {
            reconstructionScheme isoAlpha;
            surfCellTol     1e-08;
            isoFaceTol      1e-08;
        }
    }
}


