FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The alpha dictionary of the isoAdvector package's verification (fork branch
// davof-isoAdvector, 2026-11-06): the keys the package reads and nothing else.
// The row TPF_ROW (workflow/scripts/tpf_rows.py) sets the reconstruction
// scheme, the davof normal model and the plane positioning.
solvers
{
    "alpha.water.*"
    {
        // the route (DAVOF_SOLVER -> the Snakefile): isoAdvection on the fork
        // route; davofSwept (the davof rows) | isoAdvector (the comparators,
        // OpenFOAM's isoAdvection) on the leia route (materialize.py, 2026-11-06)
        advectionScheme      @!DAVOF_ADVECTION_SCHEME!@;
        reconstructionScheme @!TPF_RECON_SCHEME!@;
        // the plane positioning of the row: vofCutCell (surfaceIteratorPLIC's
        // cubic fit and secant to isoFaceTol in alpha; the classical plicRDF
        // setting) or ccs (Consecutive Cubic Spline positioning on the same
        // cutCellPLIC cut to positioningTol of V or the round-off floor, at
        // most positioningMaxIter cuts); read by davof, plicRDF and gradAlpha,
        // inert for isoAlpha (an iso-value positioning)
        positioning     @!TPF_POSITIONING!@;
        positioningTol  @!TPF_POSITIONING_TOL!@;
        positioningMaxIter @!TPF_POSITIONING_MAX_ITER!@;
        // the grazing-cut rule of the cell cut (leia 2026-11-06, PORT-DESIGN 1.2):
        // openfoam (v2606's cutCellPLIC, the default) | fork (the TwoPhaseFlow
        // threshold 10*SMALL, the opt-in copy); the fork's binary ignores the key
        grazingCut      @!TPF_GRAZING_CUT!@;
        // the CCS positioning (T. Maric, J. Comput. Phys.: X 11 (2021) 100093, doi:10.1016/j.jcpx.2021.100093,
        // arXiv:2012.02227): ccsEndInterval none | cubic, ccsTolerance absolute | relative (leia 2026-11-14)
        ccsEndInterval  @!TPF_CCS_END_INTERVAL!@;
        ccsTolerance    @!TPF_CCS_TOLERANCE!@;
        isoFaceTol      1e-8;
        surfCellTol     1e-8;
        // plicRDF: the initial guess from the previous normals (the library's
        // default true)
        interpolateNormal @!TPF_INTERPOLATE_NORMAL!@;
        // davof: interface cell |m_c| > wispTol V^(2/3); the normal model
        // (davofNormalModel.H) and where it replaces m_c (applyTo all, or
        // check: the slivers |m_c| < sliverTol h^2 and the cells deviating by
        // more than maxAngle degrees); exactNormal is the exact body of the
        // exact control
        wispTol         @!TPF_WISP_TOL!@;
        normalModel     @!TPF_NORMAL_MODEL!@;
        applyTo         @!TPF_APPLY_TO!@;
        sliverTol       @!TPF_SLIVER_TOL!@;
        maxAngle        @!TPF_MAX_ANGLE!@;
        noNormalFallback @!TPF_NO_NORMAL_FALLBACK!@;
        // The swept-face advection of leia's davofSwept scheme (the reference
        // setting of fork davof-swept 407f969 with the four round-4 keys on, as
        // cases/davof/sphereDeformation3D; the tokens' defaults in the parameter
        // file state it); the fork route's isoAdvection does not read these keys
        // (2026-11-07, the standing matrix: one template per case on both tracks)
        faceClipping    @!TPF_FACE_CLIPPING!@;
        sagittaMinCos   0.2;
        sagittaMinChord 0.05;
        sagittaMaxFraction 0.25;
        sagittaForm     full;
        tensorSource    ring;
        writeCurvatureTensor @!TPF_WRITE_TENSOR!@;
        writeSagittaCorrection @!TPF_WRITE_TENSOR!@;
        clippingSurface @!TPF_CLIPPING_SURFACE!@;
        curvedTolRel    @!TPF_CURVED_TOL_REL!@;
        curvedMaxDepth  @!TPF_CURVED_MAX_DEPTH!@;
        volumeRule      @!TPF_VOLUME_RULE!@;
        volumeRuleDebug @!TPF_CURVED_DEBUG!@;
        kromerBotheMinSplit @!TPF_KB_MIN_SPLIT!@;
        kromerBotheFan  @!TPF_KB_FAN!@;
        faceState       @!TPF_FACE_STATE!@;
        tensorCentroid  @!TPF_TENSOR_CENTROID!@;
        kromerBothePrismApex @!TPF_KB_PRISM_APEX!@;
        fitPriorWeight  1e-2;
        fitTol          1e-10;
        fitMaxIter      50;
        fitAnchor       @!TPF_FIT_ANCHOR!@;
        fitDof          @!TPF_FIT_DOF!@;
        anchorTolRel    1e-11;
        anchorMethod    @!TPF_ANCHOR_METHOD!@;
        anchorSkipConverged @!TPF_ANCHOR_SKIP_CONVERGED!@;
        sweptPreTest    @!TPF_SWEPT_PRE_TEST!@;
        sweptStateShortcut @!TPF_SWEPT_STATE_SHORTCUT!@;
        sweptTraceCache @!TPF_SWEPT_TRACE_CACHE!@;
        fluxIntegration @!TPF_FLUX_INTEGRATION!@;
        sweptClassify   @!TPF_SWEPT_CLASSIFY!@;
        sweptScaleToPhi @!TPF_SWEPT_SCALE!@;
        sweptVolumeCorrection @!TPF_SWEPT_VOLUME_CORRECTION!@;
        sweptWispSurface @!TPF_SWEPT_WISP_SURFACE!@;
        sweptWispTol @!TPF_SWEPT_WISP_TOL!@;
        sweptWispMatchTol @!TPF_SWEPT_WISP_MATCH_TOL!@;
        sweptCellsFaceUpdate @!TPF_SWEPT_FACE_UPDATE!@;
        sweptCoplanar   @!TPF_SWEPT_COPLANAR!@;
        sweptFaceDump   @!TPF_SWEPT_DUMP!@;
        planeSource     @!TPF_PLANE_SOURCE!@;
        sweptFaceLog    @!TPF_SWEPT_FACE_LOG!@;
        sweptCapSet     @!TPF_SWEPT_CAP_SET!@;
        sweptConsistencyLog @!TPF_SWEPT_CONSISTENCY_LOG!@;
        sweptConsistent @!TPF_SWEPT_CONSISTENT!@;
        // the four bit-for-bit keys of round 4 (fork davof-swept c5c00c5)
        sweptAxisPlanes @!TPF_SWEPT_AXIS_PLANES!@;
        sweptTetCache   @!TPF_SWEPT_TET_CACHE!@;
        sweptPointVelocityLazy @!TPF_SWEPT_POINT_VELOCITY_LAZY!@;
        sweptPreTestCoplanarSide @!TPF_SWEPT_PRE_TEST_COPLANAR_SIDE!@;@!TPF_ENRIGHT_KEYS!@
        defectEvery     10;
        curvedDebug     @!TPF_CURVED_DEBUG!@;
        defectLevels    3;
        writeCurvedFields @!TPF_WRITE_TENSOR!@;
        exactNormal
        {
            functionType sphere;
            origin      (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
            radius      @!TPF_SPHERE_RADIUS!@;
            U0          (@!TPF_UX!@ @!TPF_UY!@ @!TPF_UZ!@);
            omega       (0 0 0);
            axisPoint   (@!TPF_SPHERE_CX!@ @!TPF_SPHERE_CY!@ @!TPF_SPHERE_CZ!@);
        }
        // isoAdvection's bounding: the same for every row
        vof2IsoTol      1e-8;
        writeVTK        false;
        snapTol         @!TPF_SNAP_TOL!@;
        nAlphaBounds    @!TPF_N_ALPHA_BOUNDS!@;
        clip            @!TPF_CLIP!@;
        nAlphaCorr      1;
        nAlphaSubCycles 1;
        cAlpha          1;
    }
}

setFlow
{
    // the 3D deformation field of LeVeque (1996) / Enright et al. (2002):
    // OpenFOAM's functionObjects::setFlow mode vortex3D on the cell and face
    // centres, the time factor cos(pi t / T) through the cosine scale of period
    // 2 T, evaluated by advectorVoF at the half time of the step (leia branch
    // davof-swept-enright, cases/davof/sphereDeformation3D)
    mode        vortex3D;
    origin      (0 0 0);
    refDir      (1 0 0);
    axis        (0 1 0);
    scale       cosine;
    scaleCoeffs
    {
        period      #eval{ 2*@!TPF_PERIOD!@ };
        amplitude   1;
        scale       1;
        level       0;
    }
}

// advectorVoF: the abort guard (fork etc/README-davof.md "Abort guard"): the
// run ends with a normal End after an ABORT line when alpha leaves
// [abortMinAlpha, abortMaxAlpha] or the interface-cell count exceeds
// abortInterfaceCellFactor times its count at the first step
isoAdvector
{
    abortEnabled    true;
    abortMinAlpha   -0.5;
    abortMaxAlpha   1.5;
    abortInterfaceCellFactor @!TPF_ABORT_INTERFACE_FACTOR!@;
}

PIMPLE
{
    momentumPredictor no;
    nCorrectors     -1;
    nNonOrthogonalCorrectors -1;
    nAlphaCorr      1;
    nAlphaSubCycles 1;
    cAlpha          1;
    pRefCell        0;
    pRefValue       0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

