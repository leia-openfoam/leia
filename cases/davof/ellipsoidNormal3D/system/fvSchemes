FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

// The geometricVoF cross-check schemes (gradAlpha, plicRDF's initial normal)
// take grad(alpha.davof) with the point-cell least-squares gradient, the
// setting of the DLR reconstruction benchmark.
gradSchemes
{
    default         pointCellsLeastSquares;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

