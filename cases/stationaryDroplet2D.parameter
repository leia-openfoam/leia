// Stationary-droplet parasitic-current study (arXiv:2212.02904, Sec. 3.3.1).
// One swept axis: the mesh resolution N_CELLS. maxDeltaT is NOT swept -- it is a
// derived token, MAX_DELTA_T = CAPILLARY_DT_COEFF / N_CELLS^1.5 (dt ~ dx^1.5,
// the capillary stability limit), computed per case by materialize.
values
{
    solver (leiaSemiLagrangianLevelSetTwoPhaseFoam);

    // Mesh refinement ladder (cells double each level): the convergence axis.
    N_CELLS
    (
        32
        64
        128
        256
    );

    // ---- Domain size (the far field), [m] --------------------------------
    // DOMAIN_LENGTH is the box side; the droplet R = 1 mm is centred in it
    // (blockMeshDict reads it directly, implicitSurface via the derived
    // DOMAIN_HALF_LENGTH = DOMAIN_LENGTH/2). 0.01 is the reference box that
    // every published run of this case used, so leaving it here keeps all
    // existing studies bit-identical.
    //
    // CAPILLARY_REF_LENGTH is the box size at which CAPILLARY_DT_COEFF was
    // calibrated. materialize evaluates the capillary step at the
    // reference-EQUIVALENT cell count nRef = CAPILLARY_REF_LENGTH/h with
    // h = DOMAIN_LENGTH/N_CELLS, because the capillary limit
    // dt < sqrt(rho h^3/2 pi sigma) is set by the CELL SIZE and not by the
    // cell count. With DOMAIN_LENGTH = CAPILLARY_REF_LENGTH the two are the
    // same number and MAX_DELTA_T = CAPILLARY_DT_COEFF/N_CELLS^1.5 as before;
    // a truncated domain then gets the dt its h deserves rather than one that
    // is (0.01/L)^1.5 too large.
    DOMAIN_LENGTH ( 0.01 );
    CAPILLARY_REF_LENGTH ( 0.01 );

    // End time of the benchmark [s].
    END_TIME ( 0.1 );

    // Advective + interface Courant ceiling (adjustTimeStep). Low, because the
    // capillary limit -- not advection -- binds the step for this static droplet.
    MAX_CO ( 0.1 );

    // Capillary time-step coefficient [s]: maxDeltaT = CAPILLARY_DT_COEFF/nRef^1.5
    // with nRef = CAPILLARY_REF_LENGTH/h, i.e. the step tracks the CELL SIZE as
    // h^1.5, which is the correct capillary scaling in any dimension.
    //
    // SET TO POPINET'S EXPLICIT LIMIT (2026-08-23, at the user's direction).
    // Popinet, JCP 228:5838 Eq. (18), gives the stability bound for an explicitly
    // integrated surface-tension term as the period of the shortest capillary wave
    //     dt <= sqrt(rho h^3/(pi sigma)).
    // Writing h = L_ref/nRef makes the bound separable, so the coefficient is a
    // pure property of the fluids and the reference box:
    //     CAPILLARY_DT_COEFF = sqrt((rho1 + rho2) L_ref^3/(pi sigma))
    //                        = sqrt(999.39 * 1e-6/(pi * 0.07274)) = 0.0661311 s
    // for water/air (rho1 = 998.2, rho2 = 1.19, sigma = 0.07274) and L_ref = 0.01 m.
    // The sum of the densities is the one that enters the capillary dispersion
    // relation; for water/air it differs from Popinet's literal single rho by 0.06%.
    //
    // The previous value was 0.010861 = 6e-5 * 32^1.5, i.e. maxDeltaT(N=32) = 6e-5 s
    // ~ dt_sigma/4 -- a factor 6.089 BELOW the stability limit, which cost a factor
    // 6.089 in step count for no accuracy that was ever measured. Restore it to
    // reproduce any run recorded before this change; every completed study carries
    // its own value in case_params.json, so old results stay self-documenting.
    //
    // CONSEQUENCE TO EXPECT, not a regression: the m = 8 capillary mode of the
    // stationary droplet is anti-damped by an explicitly evaluated capillary force
    // at a rate +omega^2 dt/2 (omega = 4021 rad/s measured), so a 6.089x larger step
    // multiplies that anti-damping by 6.089 -- from +22..88 1/s to +135..535 1/s
    // against the physical viscous -128 1/s. Growth on the stationary droplet will
    // therefore get WORSE until the force is centred at n+1/2. That linear scaling
    // is itself a test of the mechanism.
    CAPILLARY_DT_COEFF ( 0.010861 );

    // Departure-foot reconstruction of the psi transport. Pinned HERE (not left
    // to default.parameter, whose value is the CACHED quadratic) so that every
    // existing stationaryDroplet2D study stays byte-identical now that the case
    // template reads the token instead of hardcoding the type.
    //
    // This is the swept axis of the TRANSPORT-ORDER arm: the measured SL orders
    // (docs/semi-lagrangian-level-set/.../sl_convergence_orders.csv) are
    // shape 2.97 / volume 2.98 but gradientHalf -0.03 -- third order in the zero
    // set, ZERO order in the foliation, and the CSF force reads only the
    // foliation. Dropping to the linear fit trades the third-order zero set for
    // a dissipative transport that damps the grid-scale |grad psi| error the
    // curvature operator amplifies as 1/h.
    SL_RECONSTRUCTION ( uncachedQuadraticWeightedLeastSquares );
}
