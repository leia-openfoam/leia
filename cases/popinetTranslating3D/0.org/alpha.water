FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Placeholder: overwritten by leiaSetFields (phase indicator from psi).
dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet   { type fixedValue; value uniform 0; }   // incoming ambient (air)
    outlet  { type zeroGradient; }
    walls   { type zeroGradient; }
}

// ************************************************************************* //
