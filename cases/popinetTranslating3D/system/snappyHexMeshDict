FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// LAYER ADDITION ONLY, on the blockMesh background of this case.
//
// WHY THIS FORM. The question is whether a HEXAHEDRAL mesh WITH BOUNDARY LAYERS produces
// cells that amplify the semi-Lagrangian fit -- the amplification bound Lambda > 1. The
// box geometry needs no castellation and no snapping: the background blockMesh already IS
// the box, exactly. So castellatedMesh and snap are off and only addLayers runs. That
// isolates the layers as the single difference from the plain hexahedral mesh, which is
// what makes the comparison readable.
//
// The layers are the geometric signature under suspicion: THIN, high-aspect-ratio,
// ONE-SIDED cells against a wall. On the polyhedral pMesh the worst amplifiers are cells of
// 0.32-0.33 h, and Lambda falls monotonically with cell size, so a wall layer of comparable
// relative thickness is the fair test of whether the hexahedral family inherits the defect.
//
// MEASURED for reference at d = -U dt on the same box at the same nominal cell size:
//   blockMesh      Lambda max 1.0527, 0 cells demoted, no cells below 0.8 h
//   cartesianMesh  Lambda max 1.0549, 0 cells demoted, 8 cells below 0.8 h
//   pMesh          Lambda max 1.2608, 47622 cells demoted, 27191 cells below 0.4 h
// Used by workflow/scripts/fit_amplification_probe.sh with the snappyHexMesh mesher.

castellatedMesh false;
snap            false;
addLayers       true;

geometry {}

castellatedMeshControls
{
    maxLocalCells   1000000;
    maxGlobalCells  10000000;
    minRefinementCells 0;
    nCellsBetweenLevels 1;
    features        ();
    refinementSurfaces {}
    refinementRegions {}
    resolveFeatureAngle 30;
    locationInMesh  (0.00125 0.00125 0.00125);
    allowFreeStandingZoneFaces false;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      30;
    nRelaxIter      5;
}

addLayersControls
{
    // relativeSizes true: the thicknesses below are fractions of the LOCAL cell size, so
    // the layer structure scales with the mesh and the comparison stays at matched h.
    relativeSizes   true;

    layers
    {
        // Only the solid walls carry layers. The inlet and the outlet are `patch` and the
        // level set is transported through them, so a layer there would confound this
        // measurement with the boundary-stencil question (stencilBoundaryFaces).
        walls
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio      1.3;
    finalLayerThickness 0.5;
    minThickness        0.1;

    nGrow               0;
    // 180 = extrude across sharp features too. At 60 the twelve box edges froze 512
    // feature-edge points, and on a closed box every wall face is within reach of one.
    featureAngle        180;
    slipFeatureAngle    60;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    // 0.3 reduced the thickness at 3354 nodes on this mesh; 0.6 leaves the requested
    // layers intact and the box is far thicker than the layer stack anyway.
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    // ABSOLUTE VOLUME IN CUBIC METRES, and this is the trap that made the first attempt
    // vacuous. The OpenFOAM tutorial default 1e-13 is sized for a metre-scale mesh. This
    // case is millimetre-scale: at h = 3.9e-05 m a cell holds 5.9e-14 m^3, BELOW that
    // default. snappyHexMesh then flagged ALL 1 593 344 faces as illegal ("Detected
    // 1593344 illegal faces"), removed every extrusion, and reported "Added 0 out of
    // 98304 cells (0%)" while EXITING 0 -- and the probe read the untouched background
    // blockMesh, reproducing its Lambda to eight digits. Verify the ARTEFACT: the layer
    // log must say cells were added, and the cell count must rise.
    // Same family as the absolute-length metric thresholds this repository documents.
    minVol              1e-30;
    minTetQuality       -1e30;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags ();
mergeTolerance 1e-6;

