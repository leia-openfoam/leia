values
{
    // The prescribed face flux U(x_f) & S_f is far from discretely divergence-free on
    // polyhedra; project it (velocityModel.fluxProjection, STATUS 11.25).
    FLUX_PROJECTION ( helmholtz );

    PHASE_INDICATOR ( geometric detrixheAslam );
    solver (leiaLevelSetFoam);

    END_TIME (6.283185307179586);

    MAX_CELL_SIZE // cfmesh pMesh 
    (
        0.021 // ~270kCells

        0.015 // ~700kCells

        0.008 // ~1.7MCells
    );

    SURFACE_FILE
    (
        box-edges.stl
    );

    CFL
    ( 0.3 );
        
    SOURCE_SCHEME
    (
        explicit 
        simpleLinearImplicit 
        strictNegativeSpLinearImplicit
    );

    SDPLS_SOURCE
    (
        noSource
        R
        beta
    );
    
    BC
    (
        zeroGradient
    );
    
    DIV
    (
        linear
        $LinearUpwind
        vanLeer
        $Gamma1
        MUSCL 
        Minmod
        OSPRE 
        SFCD
        SuperBee
        UMIST
        vanAlbada 
        upwind
    );
    
    TANH_LIMIT
    (
        0.1
    );

    PROFILE
    (
        signedDistance 
        tanh
    );    
}
