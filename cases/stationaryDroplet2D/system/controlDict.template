FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     leiaSemiLagrangianLevelSetTwoPhaseFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         @!END_TIME!@;

// FIXED time step: the per-resolution capillary step (derived token,
// MAX_DELTA_T = CAPILLARY_DT_COEFF / nRef^1.5 with the reference-equivalent
// cell count nRef = CAPILLARY_REF_LENGTH/h, h = DOMAIN_LENGTH/N_CELLS -- the
// capillary limit is set by the CELL SIZE, so a truncated domain gets the step
// its h deserves and not one (0.01/L)^1.5 too large; equal to
// CAPILLARY_DT_COEFF/N_CELLS^1.5 on the reference box). Time-step adaptivity is a
// potential instability source of its own, so it is DISABLED for this test:
// dt is constant for the entire run by construction, not by observation.
// FIXED_DELTA_T = @!FIXED_DELTA_T!@ s overrides the derived step when > 0;
// this reference is LOAD-BEARING (foam_param drops unreferenced tokens).
deltaT          @!MAX_DELTA_T!@;

// runTime (not adjustableRunTime): with a fixed dt, adjustableRunTime would
// still let Time trim deltaT to land on write instants -- a residual
// adaptivity. runTime writes at the first step past each instant instead.
writeControl    runTime;
writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable no;

// Explicit surface tension => capillary time-step limit
//   dt_sigma = sqrt((rho1+rho2) dx^3 / (4 pi sigma)) = 0.033066/N^1.5 s here;
//   deltaT = MAX_DELTA_T = coeff/nRef^1.5, coeff = @!CAPILLARY_DT_COEFF!@ s
//   (baseline 0.010861 = dt_sigma/3.05 at EVERY N), calibrated on the
//   L = @!CAPILLARY_REF_LENGTH!@ m reference box. NOTE: both token references in
//   this comment are LOAD-BEARING -- foam_param drops tokens no template
//   references, and materialize derives MAX_DELTA_T only when CAPILLARY_DT_COEFF
//   and CAPILLARY_REF_LENGTH survive into the token grid. Dropping the latter
//   silently falls back to nRef = N_CELLS, which on a truncated domain is a dt
//   (0.01/L)^1.5 too large -- measured: L=4e-3, N=40 gave 4.29e-5 instead of
//   1.0861e-5 before this reference was added.
// ADAPTIVITY DISABLED (was: adjustTimeStep yes, maxCo 0.1). Measured before the
// switch: dt sat at maxDeltaT with <0.01% variation inside every growth window
// anyway (the Courant bound only engaged past U~1, i.e. after blow-up), so the
// fixed step changes the METHOD, and any change in the measured growth rates
// falsifies the assumption that the adaptivity machinery was inert.
adjustTimeStep  no;
maxCo           @!MAX_CO!@;      // inert with adjustTimeStep no (kept for reference)
maxAlphaCo      @!MAX_CO!@;      // inert
maxDeltaT       @!MAX_DELTA_T!@; // inert; deltaT above IS this value

// Parasitic-current metrics (max|U|, mean|U|) + the Laplace jump are written every
// step to leiaSemiLagrangianLevelSetTwoPhaseFoam.csv by the solver (probe-free,
// mesh-robust); that CSV is what the study aggregates. It needs no function
// object; the entry below is a separate, default-OFF conservation diagnostic.

// int(psi dV) CONSERVATION DRIFT DIAGNOSTIC -- OFF BY DEFAULT.
//
// `enabled @!PSI_CONSERVATION_CSV!@` with PSI_CONSERVATION_CSV defaulting to `false` in
// cases/default.parameter makes this entry byte-identical to not having it:
// functionObjectList::read() reads `enabled` BEFORE it selects the type
// (OpenFOAM-v2512 db/functionObjects/functionObjectList/functionObjectList.C:1047,
// 1100, 1108), so for a disabled entry functionObject::New is never called --
// and the per-entry `libs` is opened inside New (functionObject.C:91-105), so
// libleiaFunctionObjects is not even dlopened. No CSV is created, no field is
// looked up, no MPI reduction is executed.
//
// GATED rather than simply switched on, because this ONE case directory is
// shared by 29 study configs: 2 Eulerian arms (config/sdplsDropletNS2D.yaml,
// config/sdplsDropletMechanism2D.yaml, solver leiaLevelSetTwoPhaseFoam) and 27
// semi-Lagrangian ones, and workflow/Snakefile runs config["solver"] rather than
// the `application` entry above. The BUDGET_* columns decompose
//   fvm::ddt(psi) + fvm::div(phi, psi) - fvm::Sp(divPhi, psi) == S,
// which only the Eulerian solver assembles (applications/solvers/
// leiaLevelSetTwoPhaseFoam/alphaEqn.H:20-29). Under the SL solver PSI_INT,
// D_PSI_INT, VOL_PSI_NEG and the DIVPHI_* columns remain honest measurements
// while BUDGET_FLUX/BUDGET_DIVPHI/BUDGET_SOURCE/BUDGET_RESIDUAL describe an
// equation that solver never assembles -- switch it on per study
// (axes_override: PSI_CONSERVATION_CSV: [true]) and read those rows knowing that.
//
// The object writes psiConservation.csv; workflow/Snakefile rule preprocess
// deletes it (APPEND mode would stack a second time series onto a re-run) and
// workflow/scripts/aggregate.py PER_CASE_CSVS lifts it into the study database
// under the psiConservation.<COLUMN> prefix.
functions
{
    psiConservationCSV
    {
        type            psiConservationCSV;
        libs            ( leiaFunctionObjects );
        enabled         @!PSI_CONSERVATION_CSV!@;
        writeControl    timeStep;
        writeInterval   1;

        // Defaults, shown for reference -- all three inputs are looked up by
        // name and NaN their columns instead of aborting when absent:
        // psi     psi;
        // phi     phi;          // no flux registered => flux/divPhi columns NaN
        // alpha   alpha.water;  // VOL_PSI_NEG = gSum(alpha V)
    }
}


