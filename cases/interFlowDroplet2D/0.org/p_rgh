FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        // Closed box, no gravity: Neumann wall pressure + a reference cell
        // (PIMPLE pRefCell/pRefValue). IDENTICAL to the level-set case, so the
        // pressure boundary treatment cannot differ between the two solvers.
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

