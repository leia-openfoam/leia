FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      psi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Both x patches are OUTFLOW for v = a(x - x0) e_x, so no data is required.
    left     { type zeroGradient; }
    right    { type zeroGradient; }
    // One-dimensional: every transverse face is empty.
    empties  { type empty; }
}

