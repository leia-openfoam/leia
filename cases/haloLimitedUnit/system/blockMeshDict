FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// 40 x 40 cells on [-1, 1]^2, one cell thick: h = 0.05. The planar interface
// x = x0 = 0.01 lies off every cell centre and face, next to the processor
// boundary x = 0 of the 4-rank decomposition.
vertices
(
    (-1 -1 -0.025)
    ( 1 -1 -0.025)
    ( 1  1 -0.025)
    (-1  1 -0.025)
    (-1 -1  0.025)
    ( 1 -1  0.025)
    ( 1  1  0.025)
    (-1  1  0.025)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 40 1) simpleGrading (1 1 1)
);

boundary
(
    walls
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (2 6 5 1)
            (1 5 4 0)
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

