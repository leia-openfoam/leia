FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // GEOMETRIC VOF: isoAdvector transport with plicRDF interface reconstruction,
    // i.e. a piecewise-linear interface whose orientation comes from a
    // reconstructed distance function. Values are the DLR reference case's
    // (run/velocityStaticCircle), unmodified, so this arm is interFlow as its
    // authors configure it.
    "alpha.*"
    {
        advectionScheme      isoAdvection;
        reconstructionScheme plicRDF;
        vof2IsoTol           1e-8;
        surfCellTol          1e-8;
        isoFaceTol           1e-8;
        nAlphaBounds         3;
        snapTol              1e-12;
        clip                 true;
        nAlphaSubCycles      2;
        nAlphaCorr           1;
        cAlpha               @!C_ALPHA!@;
        writeVTK             false;
        writeIsoFaces        false;
    }

    "pcorr.*"
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-10;
        relTol          0;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-10;
        relTol          1e-05;
        maxIter         20;
        minIter         5;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance       1e-12;
        relTol          0;
        maxIter         40;
        minIter         5;
    }

    "U.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-20;
        relTol          0;
        minIter         10;
    }
}

// Read ONLY by leiaSetFields, which initialises this case so that its initial
// alpha.water is bit-identical to the level-set and interFoam cases. interFlow
// itself never looks at this dictionary.
levelSet
{
    profile
    {
        type    signedDistance;
        limit   0.1;
    }

    implicitSurface
    {
        type    implicitSphere;
        center  (@!DOMAIN_HALF_LENGTH!@ @!DOMAIN_HALF_LENGTH!@ @!DOMAIN_HALF_LENGTH!@);
        radius  1e-3;
    }

    phaseIndicator
    {
        type    detrixheAslam;
    }

    narrowBand
    {
        type    signChange;
    }
}

PIMPLE
{
    momentumPredictor   no;
    nCorrectors         4;
    nNonOrthogonalCorrectors 0;
    correctPhi          yes;

    // Closed box, zeroGradient wall pressure: the level needs a reference cell.
    // Same treatment as the other two solvers' cases, so the comparison cannot be
    // confounded by the pressure boundary condition. (The DLR reference case uses
    // fixedFluxPressure walls instead; with no through-flow and U = 0 the two are
    // equivalent, and consistency across the three solvers is worth more here.)
    pRefCell            0;
    pRefValue           0;
}

