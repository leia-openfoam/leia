MAX_CELL_SIZE -1.0; // cfmesh pMesh (polyhedral mesh) not used
N_CELLS       -1.0; // blockMesh not used
CFL           0.3;
SURFACE_FILE  none; // cfmesh pMesh (polyhedral mesh) not used
PHASE_INDICATOR geometric;
VELOCITY_EXTENSION none; // levelSet.velocityExtension.type for the LEVEL-SET
                     // transport only (momentum velocity untouched):
                     // none | closestPoint | meshWaveExt | pseudoTime |
                     // steadyUpwind | steadyUpwindLinear |
                     // anisotropicDiffusion. none = original path.
ANCHOR_LAYERS 0;    // velocityExtension: extra foot-pointed Dirichlet layers
UEXT_DIV UpwindUext; // steadyUpwind div scheme alias; MEASURED: the linearUpwind
                     // deferred correction DIVERGES on the steady extension
                     // equation (no ddt damping) -> upwind is the safe default.
OSCILLATION on;      // velocityModel: on = reversed test (cos(pi t/tau) factor),
                     // off = steady non-reversing vortex (sustained strain).
SL_RECONSTRUCTION quadraticWeightedLeastSquares; // leiaSemiLagrangeLevelSetFoam foot reconstruction;
                     // single value here (constant for velocity-extension studies,
                     // which ignore it) -> the SL configs axes_override the sweep
                     // [linearTaylor linearWeightedLeastSquares quadraticTaylor quadraticWeightedLeastSquares].
SL_CORRECTION direct; // leiaSemiLagrangeLevelSetFoam slCorrector: how psi^n is
                     // assembled at the feet. direct = one reconstruction pass
                     // (default); deferredCorrection = fixed-point iteration
                     // (nDefCorr/defCorrRelax/defCorrTol). Sweepable per SL config.
SL_STENCIL point;    // leiaSemiLagrangeLevelSetFoam departure-foot reconstruction
                     // stencil: point = cell-point-cell (REQUIRED on hex: 6 face-
                     // neighbours < 9 for a 3D quadratic). face = cell-face-cell
                     // (polyhedra only: ~12-16 faces suffice, ~3-4x smaller/faster
                     // + better conditioned). Sweepable per SL config.
REDISTANCER noRedistancing; // leiaRedistancedLevelSetFoam levelSet.redistancer.type:
                     // noRedistancing | PDE | planeFootWave | anchoredEikonal.
                     // Default keeps every non-redistancing study byte-identical;
                     // the GRL configs axes_override the sweep.
REDIST_TRIGGER interval; // redistancer trigger: interval (every REDIST_INTERVAL
                     // steps, original behaviour) | gradPsiThreshold (band L1 of
                     // ||grad psi|-1| > threshold; Abu-Al-Saud et al. 2018 --
                     // keeps redistance events rare).
REDIST_THRESHOLD -1; // gradPsiThreshold criterion threshold; -1 = auto (h/L)^2.
REDIST_INTERVAL 1;   // interval-trigger period (timeIndex % interval == 0).
REDIST_GRADBOUND 2.0; // signedDistanceBounds trigger: redistance when band
                     // |grad psi| leaves [1/g, g] -- case- and resolution-
                     // independent usability bounds of the signed distance
                     // (|grad|->0: zero crossing unlocatable; |grad|->1/h:
                     // one-cell Heaviside jump = algebraic VOF).
SL_CLIP false;       // leiaSemiLagrangeLevelSetFoam clipToStencilBounds: tight
                     // monotone clamp of the reconstructed psi^n to the stencil
                     // [min,max]. false = default (structured hex is well-
                     // conditioned). true = REQUIRED on general polyhedra, where a
                     // near-singular per-cell fit can otherwise let psi run away
                     // geometrically; the clamp is inactive in smooth regions so
                     // it preserves the 2nd-order convergence.
REDIST_VIOLFRAC 0;   // signedDistanceBounds robust variant: fire only when more
                     // than this fraction of band cells violates [1/g, g]
                     // (0 = strict min/max). Localized under-resolved tails
                     // (kappa*h ~ 1) cannot be repaired by redistancing and
                     // must not re-trigger it.
// SDPLS source selection. noSource = OFF, which keeps every study that does
// not set these tokens byte-identical in behaviour -- both two-phase solvers
// construct an sdplsSource, and noSource is inert by construction.
SDPLS_SOURCE  noSource;

// Level-set time scheme for the coupled droplet cases, via
// cases/stationaryDroplet2D/system/aliasDict. EulerDdt renders `Euler`, which
// is exactly what the bare `default Euler` gave before the token existed, so
// every pre-existing study renders a behaviourally identical fvSchemes.
// CrankNicolsonDdt renders `CrankNicolson 1` for ddt(psi) ONLY -- momentum
// stays on Euler, whose L-stability is what keeps this capillary problem stable
// at the calibrated step.
PSI_DDT       EulerDdt;

// int(psi dV) conservation drift diagnostic (psiConservationCSV function object,
// cases/stationaryDroplet2D/system/controlDict.template). `false` = the entry is
// present but `enabled false`, for which functionObjectList::read() never calls
// functionObject::New and never dlopens libleiaFunctionObjects -- so every study
// that does not set this token runs and renders exactly as before the object
// existed, the same inert-by-default contract as SDPLS_SOURCE noSource above.
// `true` writes psiConservation.csv, one row per time step: int(psi dV) and its
// drift, the flux/divPhi/source decomposition of the assembled psi equation, the
// discrete solenoidality of phi, and -- deliberately in the same row -- the phase
// volume vol{psi < 0}, which is a DIFFERENT invariant (conflating the two is what
// the sdplsRdiv "fluxes cannot drain" claim did, before N=64 drained and N=128
// diverged at relative volume error +16.9).
PSI_CONSERVATION_CSV false;

// Per-time-step phase-volume correction (levelSet.volumeCorrection.type).
// noVolumeCorrection is the base class itself and a true no-op -- an unset
// token leaves psi untouched for the whole run, so every existing study is
// bit-unchanged. newtonShift applies the distance-preserving uniform shift
// psi <- psi + eps of Song et al. (2025). Read the block in the case
// fvSolution.template before using it: it conserves TOTAL volume only, is
// ill-posed for disconnected bodies, trades local shape for global volume, and
// must never be used to mask the coupled-drain instability.
VOLUME_CORRECTION noVolumeCorrection;

// Exact circle curvature 1/R for constantCurvatureSurfaceTension (R = 1e-3 m).
// Unread by every other surface-tension model.
CONST_CURVATURE 1000;
SOURCE_SCHEME simpleLinearImplicit;
SDPLS_BETA 1.0;      // sdplsBeta target gradient: f_nl = beta - |grad psi|
// SDPLS cut-off (mollifier), eq. (24) of arXiv:2208.01269. `none` disables it
// and reproduces every study run before 2026-08. mollifier1 forces the source
// to zero away from the interface: G = 1 for |psi| <= w1, decaying to 1e-3 at
// |psi| = w2. w1/w2 are PHYSICAL lengths -- scaling them with h would make the
// modified PDE mesh-dependent and its convergence order meaningless.
MOLLIFIER  none;
SDPLS_W1   0.05;     // preprint value (initial radius R0 = 0.3)
SDPLS_W2   0.15;     // preprint value; MUST be > w1
// `band` cut-off only: cells either side of the interface that the
// source acts over. Topological -- no |grad psi| assumption.
SDPLS_NLAYERS 3;
// SDPLS source gradients, as aliasDict names. The NORMAL that the strain
// cancellation is built from is only as good as GRAD_PSI_SDPLS; it was
// hardcoded to the most compact stencil in the file until 2026-08-15.
// GRAD_PSI selects the strategy: `fvc` (fvc::grad with the scheme below) or
// `narrowLS` (LLSQ plane-fit normals in the band). gradPsiMetric is NOT a
// token on purpose -- it is the measurement and must not move with the source.
GRAD_PSI_SDPLS SdplsLSQ;
GRAD_U_SDPLS   SdplsUGauss;
GRAD_PSI       fvc;
                     // (drives |grad psi| -> beta; beta = 1 = signed distance).
ADVECTION eulerian;  // unified leiaLevelSetFoam advection method:
                     // eulerian (implicit FV, advective form, nDefCorr
                     // deferred correction) | semiLagrangian (backward foot
                     // point + levelSet.semiLagrangian reconstruction).
REPORT_WRITE_ONLY false; // unified solver: compute the phase indicator and
                     // error rows only at write times ({0, T/2, T}). true in
                     // the decision-benchmark configs so every method pays
                     // the same reporting cost (fair ELAPSED_CLOCK_TIME).
SL_LIMITER none;     // slReconstruction slope limiter: none | barthJespersen |
                     // venkatakrishnan (order-preserving smooth cap).
SL_VENKK 5;          // venkatakrishnan threshold K (eps^2 = (K*h)^3).
SL_FIT normalEquations; // uncachedQuadratic least-squares solver:
                     // normalEquations (Cholesky) | householderQR (better conditioned).
SL_SCHEME pointValue; // semiLagrangian scheme: pointValue (non-conservative) |
                     // fluxForm (conservative swept-face flux, CFL<=1) |
                     // normalProjected (geometric nSL update along (u.n)n with
                     // per-step distance renormalization).
SL_OFFSET_CORRECTION none; // parallel-curve curvature offset correction:
                     // none | psi | psiOverGradPsi | quadraticRoot.
SL_RENORMALIZATION strain; // normalProjected in-band renormalization:
                     // geometric | strain | none.
SL_OFFSET_ENGINE rayRoot; // normalProjected geometric offset engine:
                     // rayRoot | footPoint (stabilized foot-point, Variant a).
GEOMETRY_FIT none;   // levelSet.geometryFit.type: a SECOND slReconstruction
                     // serving the GEOMETRY path (curvature, fitDerivatives,
                     // footPointDistance) while SL_RECONSTRUCTION serves
                     // TRANSPORT. none = one object for both (the historical
                     // behaviour, byte-identical: no second fit is built and no
                     // second stencil is gathered).
                     //
                     // WHY: the symbolic curvature path is implemented ONLY by
                     // uncachedQuadraticWeightedLeastSquares -- the base class
                     // throws NotImplemented -- so lowering the TRANSPORT order
                     // previously removed the curvature model with it. Setting
                     // GEOMETRY_FIT uncachedQuadraticWeightedLeastSquares keeps
                     // the quadratic kappa while SL_RECONSTRUCTION varies.
                     //
                     // CAVEAT when the two differ: the two objects hold
                     // different fits of the same psi, so the foot-point
                     // distance feeding the curvature inverse is consistent
                     // with the interface motion only to the TRANSPORT's order.
// Gaussian-curvature term of the cellCentreInverse parallel-surface inverse.
// yes (default) = the K-aware, dimension-seamless form every previous run used;
// K is identically zero in 2D and active only in 3D, so `no` runs a 3D case
// through the 2D algebra. That is the only available control isolating a
// dimension-specific term of the delivery, and the 3D ladder needs it: the
// coupled run is stable at R/h = 10.0 and 12.7 and destabilises at 15.8 with a
// growth rate rising 40.5 -> 52.3 -> 90.6 1/s, while the WP0 normal-direction
// band spectrum stays pinned -- so the driver is not the corrugation the psi
// filter damps. Static cost if K is innocent: the 3D sphere gate scores the
// K-aware inverse h^1.95 and the K-less control h^1.02.
CURVATURE_INVERSE_GAUSSIAN yes;

// Explicit fixed time step, overriding the h-derived capillary step. 0 = derive
// (the default, so every existing study is unchanged). Set > 0 only for the
// fixed-dt experiment: because the capillary law ties dt to h as dt ~ h^1.5, a
// refinement ladder moves the mesh and the step together and cannot tell a
// spatial effect from a per-step one. Measured on the 3D ladder, r*dt is constant
// to 24% while r itself rises 2.2x, so running one fixed dt across the ladder is
// what separates the two.
PSI_SURFACE signedDistanceEllipse; // implicitSurface.type for the ellipse/ellipsoid gate cases
WRITE_INTERVAL 0.02;    // controlDict writeInterval [s] (runTime write control)
FIXED_DELTA_T 0;

// Momentum ddt(rho,U) scheme. Euler is the default and what every validated result
// uses, so nothing changes unless a study sweeps it. backward is BDF2;
// CrankNicolson takes a blending coefficient. Raising this ALONE does not make the
// scheme 2nd order in time: the capillary force is evaluated once per step from the
// interface at t^n, which is 1st order whatever ddt does, and making it implicit
// instead (psiOuterCorrectors) is also 1st order and was measured inert. Genuine
// 2nd order needs a MIDPOINT capillary force as well.
// BDF2 IS NOW THE DEFAULT (2026-08-20, at the user's direction). It is formally the
// right choice: the semi-Lagrangian departure point is a second-order Taylor
// expansion and Euler was feeding it a first-order velocity. Measured in the 2x2
// (config/ddtOrderGain3D.yaml) at 3D R/h = 15.8: backward no longer diverges -- the
// 2026-07-14 peak of ~48 m/s is gone and its peak here is 6% BELOW Euler's -- and it
// improves the volume error by 20% (1.092e-05 -> 8.744e-06) and the shape error by
// 0.8%. It does NOT change the per-step gain (+1.1%), so it is an accuracy choice,
// not a stability fix. Every result predating this line used Euler.
// Time level the capillary force is evaluated at: endStep (force from psi^{n+1},
// symplectic Euler -- the historical path, byte-identical) or midpoint (force
// from psi^{n+1/2}, Stormer-Verlet, Popinet's staggering). For the linearised
// capillary oscillator the two are SPECTRALLY IDENTICAL -- both have det(M) = 1
// and trace 2 - omega^2 dt^2 -- so this changes the accuracy of the coupling and
// matches Popinet's arrangement, but it does not change linear stability or the
// step limit. midpoint runs the interface pipeline twice per step.
CAPILLARY_FORCE_CENTRING endStep;

MOMENTUM_DDT_SCHEME backward;

// Momentum convection. `linearUpwind gradU` reproduces the historical
// `linearUpwind grad(U)` exactly (both gradSchemes entries are Gauss linear); the
// alternative is `upwind`. Paren-free so the .parameter scalar parser accepts it.
// Momentum convection. DEFAULT IS NOW `upwind` (2026-08-20, at the user's direction).
// Measured INERT on the stationary droplet: against `linearUpwind gradU` at 3D
// R/h = 12.7 and 15.8 with BDF2, max U agrees to four significant figures
// (8.0915e-05 vs 8.0944e-05; 2.4093e-04 vs 2.4084e-04) and the per-step gain to 0.03%.
// The convective term is negligible at these velocities, so dropping the gradient
// correction costs nothing HERE. It is the default anyway because the exposure it
// removes is real -- U is continuous across Gamma but its GRADIENT is not, and
// linearUpwind extrapolates the face value with that discontinuous cell gradient -- and
// that exposure will matter for the TRANSLATING and OSCILLATING droplet, where the
// convective term is no longer negligible. The alternative remains
// `linearUpwind gradU`, verified bit-identical to the historical `linearUpwind grad(U)`.
MOMENTUM_DIV_SCHEME upwind;



CURVATURE_EXTENSION none; // two-phase levelSet.curvatureExtension.type:
                     // none | harmonicLaplace | footPointHeightFunction |
                     // closestPointNewton | connectedInterface | interfaceMean
                     // | stabilizedFootPointFace (face kappa re-referenced to
                     // the interface at the stabilized foot-point offset)
                     // | cutCellFootPointFace (ONE inverted curvature per cut
                     // cell, assigned to its active faces)
                     // | cellMeanFootPointFace (the PER-FACE inversions,
                     // averaged over each cut cell's active faces -- same
                     // one-value-per-cut-cell structure, but built by
                     // AVERAGING n inversions rather than concentrating on
                     // one, which lowers the psi-to-kappa_f gain)
                     // | footPointEvaluatedFace (each adjacent cell evaluates
                     // its fit curvature AT the foot point of the FACE CENTRE
                     // on its own zero set -- no parallel-surface conversion;
                     // linear interpolation of the two per-cell values;
                     // second order where the level sets are NOT normal
                     // offsets, fit-error-limited where they are) | fvm.
N_OUTER_CORRECTORS 3; // PIMPLE.nOuterCorrectors (historical hardcoded value 3).
PSI_OUTER_CORRECTORS yes; // DEFAULT CHANGED 2026-08-28: the interface is
                     // re-advected on EVERY outer corrector, not only the
                     // first. Advecting once and then running N-1 further
                     // momentum/pressure iterations against a FROZEN interface
                     // makes the outer loop inconsistent with its own force:
                     // if the loop is worth iterating, the interface it is
                     // iterating towards has to move with it.
                     //
                     // The consistency question this settles (asked 2026-08-28):
                     // does re-advecting with the CURRENT iterate wrongly feed
                     // u^{n+1} to a trace that wants u^n? No. The kernel
                     // (pointValueScheme.C) computes
                     //   x_d = x_c - u_new dt + (dt^2/2)[(u_new-u_old)/dt
                     //                                   + (u_new.grad)u_new]
                     //       = x_c - dt/2 (u_new + u_old) + O(dt^2 grad u)
                     // so its LINEAR displacement is the AVERAGE of the two
                     // slots: it is arrival-centred and WANTS (u^{n+1}, u^n),
                     // forming u^{n+1/2} itself. The AB2 extrapolation on pass 1
                     // is the FALLBACK for u^{n+1} not existing yet, so a later
                     // pass carrying the real iterate is strictly more
                     // consistent, not less. The failure mode that WOULD break
                     // it -- refreshing the OLD slot on later passes, leaving
                     // the average between two new-time iterates and collapsing
                     // the trace to backward Euler -- is guarded in
                     // slAlphaEqn.H:121 (UextOld is written only on pass 1).
                     //
                     // MEASURED cost/benefit at N=128, m=2 mode rate, 12 outer
                     // correctors either way: r_2 = 3.906 (yes) vs 3.908 (no)
                     // at dt and -1.267 vs -1.269 at dt/2 -- INERT on stability
                     // to four digits, which is the un-preconditioned-Picard
                     // result (the loop contracts like (dt/dt_cap)^2). It costs
                     // one transport -> band -> indicator -> curvature ->
                     // delivery chain per extra outer pass.
                     //
                     // no = psi advected once
                     // per step on the first outer corrector, capillary force
                     // frozen across the outer loop (historical behaviour,
                     // byte-identical). yes = iterated interface-force
                     // coupling: every outer corrector restores psi^n and
                     // re-advects with the current velocity iterate (pass 1
                     // keeps the AB2 predictor), re-running band/indicator/
                     // curvature/face delivery so sigma*kappa_f*snGrad(alpha)
                     // converges to its t^{n+1} value -- backward-Euler
                     // consistency of the force with the fvm::ddt momentum
                     // LHS. MEASURED motivation: r = r0 + c*dt with the c*dt
                     // (explicit-coupling) term = 90% of the parasitic growth
                     // rate at N=128 (stationaryDropletDtSweep).
PSI_RENORM none;     // levelSet.psiRenormalization.type: none |
                     // footPointGradient (psi <- psi/|grad psi| at the foot
                     // point, on the band, every step). Restores the PARALLEL
                     // FOLIATION the parallel-surface curvature inverse
                     // assumes; a strictly positive rescaling, so the zero set
                     // and every sign are preserved exactly. MEASURED driver
                     // (plan sec. 14.2): beta spreads to [0.72, 1.37] by
                     // blow-up and the inverse's residual grows 600x.
PSI_RENORM_THRESHOLD 5e-3; // gate: fire only when the band L2 of the
                     // dimensionless non-parallelism |P H n|/beta * h exceeds
                     // this (<= 0 = every step). MEASURED over a reference run:
                     // 2e-4 at t=0.02, 1.3e-2 at 0.08, 4.5e-2 at 0.10.
PSI_RENORM_SWEEPS 2; // symmetric smoothing sweeps on the divisor beta_Gamma,
                     // separating the smooth drift from grid-scale fit noise.
PSI_RENORM_RELAX 1.0; // relaxation omega: psi <- psi/beta_Gamma^omega. omega=1
                     // is the one-shot correction, MEASURED 3.4x worse than no
                     // correction (2% psi kick per firing). omega << 1 spreads
                     // the same total correction over many steps, so the smooth
                     // part accumulates coherently and the fit noise does not.
FACE_CURVATURE_SOURCE model; // reconstructedCurvature kappa_f source: model
                     // (its own arithmetic/Kang assembly) | registered (the
                     // solver-registered face field, e.g. kappaStableFootFace).
SURFACE_TENSION_FORCE reconstructedCurvature;
ST_NSMOOTH 2;        // divGradAlphaSnGradAlpha alpha-smoothing sweeps (class default) // levelSet.surfaceTensionForce.type:
                     // reconstructedCurvature (kappa from the quadratic fit,
                     // delivered per-face; the high-order path) |
                     // divGradPsiSnGradAlpha (kappa = div(grad psi/|grad psi|)
                     // from the FVM operators -- ORDER-MATCHED to the 2nd-order
                     // FVM momentum discretization, and curvature-free so it
                     // works with a linear transport fit) | integralSurfaceTension.
                     // Cases that hardcoded a model pin their historical value in
                     // their own <Case>.parameter, so this default only applies
                     // where a template newly reads the token.
PSI_FILTER none;     // grid-scale psi filter (psiFilterEqn.H): none |
                     // biharmonicBand (psi -= theta*L(L(psi)) in band+1 ring).
PSI_FILTER_THETA 0.05; // filter strength theta (biharmonicBand only).
REDIST_REGION band;  // signedDistanceBounds criterion region: band (interface
                     // quality, default) | bulk (frozen-band fill region;
                     // REQUIRES REDIST_VIOLFRAC > 0 -- SDF skeleton has grad 0).
REDIST_FREEZE false; // PDE redistancer frozen-band variant: freeze sign-change
                     // band + REDIST_ANCHOR_LAYERS guard layers (transported
                     // values = Dirichlet anchors, zero interface displacement
                     // BY CONSTRUCTION); fill the bulk only.
REDIST_ANCHOR_LAYERS 2; // guard layers beyond the sign-change band (keeps fill
                     // error out of band-cell reconstruction stencils).
REDIST_HAMILTONIAN central; // PDE reinit |grad psi|: central (fvSchemes grad;
                     // MEASURED divergent, bulk 0.56->59.7) | godunov
                     // (Rouy-Tourin upwind, monotone+causal -- classical cure).
REDIST_NITER 30;     // PDE pseudo-time iterations (reach = niter*deltaTCoeff*h).

// Defect-correction passes of the EULERIAN psi advection loop
// (controlDict nDefCorr; eulerianAdvection.C + leiaRedistancedLevelSetFoam.C).
// >= 3: linearUpwind's second-order part is an explicit RHS source AND the
// SDPLS source is re-linearized every pass. UNRELATED to the semi-Lagrangian
// deferredCorrector's own nDefCorr, which lives in fvSolution.levelSet.
N_DEF_CORR 3;

// linearUpwind reconstruction gradient for div(phi,psi), as an aliasDict name
// (the value has spaces; see cases/2Dvortex/system/aliasDict). CellLimitedLSQ is
// the historical value, so every existing study renders unchanged.
// Swept by config/sdplsOrderAblation.yaml.
DIV_GRAD CellLimitedLSQ;

// ---------------------------------------------------------------------------
// 1D UNIAXIAL STRETCHING GATE (cases/1Dstretch). The only case in this
// repository with a CLOSED-FORM solution for both the interface AND the whole
// psi field, which is what makes it a verification gate rather than a
// convergence study.
//
// v(x) = a (x - x0) e_x with a = STRAIN_RATE [1/s], so d(v_x)/dx = a exactly and
// the strain the SDPLS source must supply, a_strain = nhat . grad(v) . nhat, is
// the EXACT CONSTANT a -- any measured deviation is discretization, never a
// modelling error. NOTE div(v) = a != 0: a one-dimensional flow CANNOT be
// solenoidal, which is intrinsic to the test and stated wherever it is reported.
//
// Exact solutions, along characteristics x(t) = x0 + (x_start - x0) e^{a t}:
//   no source : psi = x0 + (x - x0) e^{-a t} - xi0,  d(psi)/dx = e^{-a t}
//   source R  : psi = x - x_i(t),                    d(psi)/dx = 1 exactly
// with the interface at x_i(t) = x0 + (xi0 - x0) e^{a t} in BOTH arms -- losing
// the distance property does not move the zero contour, which is why a
// shape-only or volume-only metric would score the failed arm as perfect.
STRAIN_RATE   1;        // a [1/s]; 1 gives e^{-1} = 0.36788 at T = 1, a large signal
INTERFACE_POSITION 0.25; // xi0 [m]; x_i(1) = 0.25 e = 0.67957, well inside the box

// Which initial surface the 1D gate starts from.
//   implicitPlane -> ONE interface. The closest-point map is smooth everywhere,
//     every band cell's foot point is the same point, Uext is UNIFORM, and
//     closestPoint extension is EXACT (not merely second order).
//   implicitSlab  -> TWO interfaces at (x-c).d = +/- halfWidth. The medial axis
//     is the plane (x-c).d = 0, where the closest-point map JUMPS and Uext with
//     it, by a (x_R - x_L). This is the arm that reproduces the failure.
IMPLICIT_SURFACE implicitPlane;
SLAB_HALF_WIDTH  0.25;  // W [m]; the medial axis enters the band when nLayers*h > W

// Extension band half-width in cells. TOKENISED because the closestPoint
// diagnosis sweeps it against SLAB_HALF_WIDTH: the controlling parameter is
// W/(nLayers*h), and the jump enters the advected region exactly when it drops
// below one. The static circle gate (radius 0.15, 3 cells) never crosses it,
// which is why that gate reports O(h^1.98) for a model whose advection is poor.
N_LAYERS 3;

// closestPoint foot-point acceptance tolerance in CELLS (|psi(x_fp)| < cpTol*h).
// The shipped default is 0.1; the 1D gate sweeps it to test whether it sets the
// interface velocity error, which the static extension metric is blind to.
CP_TOL 0.1;

// closestPoint (the GEOMETRIC velocity extension) foot-point definition.
// fieldInterpolation is the shipped behaviour and stays the default, so every
// existing study is bit-unchanged. reconstructionFit reuses the quadratic LSQ
// fit of the semi-Lagrangian line, which is what the 1D gate tests.
FOOT_POINT_SOURCE fieldInterpolation;

// levelSet.narrowBand.type. signChange is the historical default and stays
// the default so every existing case is bit-unchanged.
NARROW_BAND signChange;

// velocityExtension fade metric: layer (default) | levelSet (historical |psi|).
FADE_MODE levelSet;

// closestPoint descent psi operator: cellPoint (default) | taylor.
CP_INTERP cellPoint;

// Rdiv assembled convection operator: off (default) | composite | normal.
SDPLS_COMPOSITE_FLUX off;

// Rdiv convecting-flux blend: phi_lambda = lambda*phi + (1-lambda)*phiW.
// lambda = 1 is R's own flux and reproduces the pre-blend assembly to the
// digit (4923800's self-check: at lambda = 1 the two forms are algebraically
// the same matrix), so 1.0 is the inert-by-default value. The token was
// introduced in 4923800 without a default, which broke materialization of
// EVERY study touching cases/2Dvortex (foam_param aborts on valueless tokens).
SDPLS_FLUX_BLEND 1.0;

// Semi-implicit (Hysing/Raessi/SAAMPLE) capillary term, an fvOption rendered
// into system/fvOptions (cases/stationaryDroplet2D/system/fvOptions.template).
// `off` = addSup returns without touching the momentum matrix -- verified
// bit-identical, so every pre-existing study is unchanged. `value` = the
// SAAMPLE arrangement (pairs with PSI_OUTER_CORRECTORS no); `increment` = the
// deferred-Jacobian form that vanishes at outer-loop convergence (pairs with
// PSI_OUTER_CORRECTORS yes + residual-controlled outer iterations). The
// coefficient multiplies sigma*dt (2/3 = the exact BDF2 Jacobian scale).
SEMI_IMPLICIT_CAPILLARY off;
SEMI_IMPLICIT_CAPILLARY_COEFF 1.0;
SEMI_IMPLICIT_LB true;

// PIMPLE.residualControl tolerances for the accuracy-driven outer loop
// (SAAMPLE Algorithm 1 in OpenFOAM vocabulary). 0 = the criterion can never
// be satisfied, so the loop runs the fixed nOuterCorrectors count -- the
// committed behaviour, bit-identical. The semi-implicit `increment` candidate
// raises these together with N_OUTER_CORRECTORS and PSI_OUTER_CORRECTORS yes.
OUTER_U_TOL 0;
OUTER_P_TOL 0;
// Which include the PIMPLE dict pulls: residualControl.off (empty -- the
// byte-identical historical dictionary) or residualControl.on (the block).
// A block with tolerance 0 is NOT equivalent to no block -- measured, see
// cases/*/system/residualControl.off.
PIMPLE_RESIDUAL_CONTROL_FILE residualControl.off;

// Semi-Lagrangian foot-point integrator and trace velocity (levelSet.
// semiLagrangian). Both defaults are the historical behaviour and are verified
// bit-identical; see the fvSolution.template comments for what each does.
//   footIntegrator: taylor | rk2
//   traceVelocity : cellCentred | projectedFlux | reconstructedU
//                 | reconstructedMomentum
// reconstructedU is the CONFOUND CONTROL for projectedFlux: same extension
// field, same reconstruct operator, but an unprojected (non-solenoidal) face
// flux. It exists to decide whether projectedFlux wins because the traced
// field is divergence-free or merely because reconstruct() smooths it.
// Uniform stream speed for the TRANSLATING droplet cases [m/s]. Referenced only
// by cases/translatingDroplet3D/0.org/U; 0.05 matches the committed 2D twin so a
// case that picks the token up by accident gets the intended physics rather than
// a silently stationary droplet.
TRANSLATION_SPEED 0.05;

SL_FOOT_INTEGRATOR taylor;
SL_TRACE_VELOCITY cellCentred;
