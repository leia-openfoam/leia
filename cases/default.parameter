MAX_CELL_SIZE -1.0; // cfmesh pMesh (polyhedral mesh) not used
N_CELLS       -1.0; // blockMesh not used
CFL           0.3;
SURFACE_FILE  none; // cfmesh pMesh (polyhedral mesh) not used
// NOT INERT: geometric -> detrixheAslam, which is what every serious study already
// pinned by hand. The default disagreeing with universal practice is how a
// convergence order once came within one run of being fitted across a mixture of two
// interface reconstructions.
PHASE_INDICATOR detrixheAslam;
VELOCITY_EXTENSION none; // levelSet.velocityExtension.type for the LEVEL-SET
                     // transport only (momentum velocity untouched):
                     // none | closestPoint | meshWaveExt | pseudoTime |
                     // steadyUpwind | steadyUpwindLinear |
                     // anisotropicDiffusion. none = original path.
ANCHOR_LAYERS 0;    // velocityExtension: extra foot-pointed Dirichlet layers
UEXT_DIV UpwindUext; // steadyUpwind div scheme alias; MEASURED: the linearUpwind
                     // deferred correction DIVERGES on the steady extension
                     // equation (no ddt damping) -> upwind is the safe default.
OSCILLATION on;      // velocityModel: on = reversed test (cos(pi t/tau) factor),
                     // off = steady non-reversing vortex (sustained strain).
SL_RECONSTRUCTION quadraticWeightedLeastSquares; // leiaSemiLagrangeLevelSetFoam foot reconstruction;
                     // single value here (constant for velocity-extension studies,
                     // which ignore it) -> the SL configs axes_override the sweep
                     // [linearTaylor linearWeightedLeastSquares quadraticTaylor quadraticWeightedLeastSquares].
SL_CORRECTION direct; // leiaSemiLagrangeLevelSetFoam slCorrector: how psi^n is
                     // assembled at the feet. direct = one reconstruction pass
                     // (default); deferredCorrection = fixed-point iteration
                     // (nDefCorr/defCorrRelax/defCorrTol). Sweepable per SL config.
SL_STENCIL point;    // leiaSemiLagrangeLevelSetFoam departure-foot reconstruction
                     // stencil: point = cell-point-cell (REQUIRED on hex: 6 face-
                     // neighbours < 9 for a 3D quadratic). face = cell-face-cell
                     // (polyhedra only: ~12-16 faces suffice, ~3-4x smaller/faster
                     // + better conditioned). Sweepable per SL config.
REDISTANCER noRedistancing; // leiaRedistancedLevelSetFoam levelSet.redistancer.type:
                     // noRedistancing | PDE | planeFootWave | anchoredEikonal.
                     // Default keeps every non-redistancing study byte-identical;
                     // the GRL configs axes_override the sweep.
REDIST_TRIGGER interval; // redistancer trigger: interval (every REDIST_INTERVAL
                     // steps, original behaviour) | gradPsiThreshold (band L1 of
                     // ||grad psi|-1| > threshold; Abu-Al-Saud et al. 2018 --
                     // keeps redistance events rare).
REDIST_THRESHOLD -1; // gradPsiThreshold criterion threshold; -1 = auto (h/L)^2.
REDIST_INTERVAL 1;   // interval-trigger period (timeIndex % interval == 0).
REDIST_GRADBOUND 2.0; // signedDistanceBounds trigger: redistance when band
                     // |grad psi| leaves [1/g, g] -- case- and resolution-
                     // independent usability bounds of the signed distance
                     // (|grad|->0: zero crossing unlocatable; |grad|->1/h:
                     // one-cell Heaviside jump = algebraic VOF).
SL_CLIP false;       // leiaSemiLagrangeLevelSetFoam clipToStencilBounds: tight
                     // monotone clamp of the reconstructed psi^n to the stencil
                     // [min,max]. false = default (structured hex is well-
                     // conditioned). true = REQUIRED on general polyhedra, where a
                     // near-singular per-cell fit can otherwise let psi run away
                     // geometrically; the clamp is inactive in smooth regions so
                     // it preserves the 2nd-order convergence.
REDIST_VIOLFRAC 0;   // signedDistanceBounds robust variant: fire only when more
                     // than this fraction of band cells violates [1/g, g]
                     // (0 = strict min/max). Localized under-resolved tails
                     // (kappa*h ~ 1) cannot be repaired by redistancing and
                     // must not re-trigger it.
// SDPLS source selection. noSource = OFF, which keeps every study that does
// not set these tokens byte-identical in behaviour -- both two-phase solvers
// construct an sdplsSource, and noSource is inert by construction.
SDPLS_SOURCE  noSource;

// Level-set time scheme for the coupled droplet cases, via
// cases/stationaryDroplet2D/system/aliasDict. EulerDdt renders `Euler`, which
// is exactly what the bare `default Euler` gave before the token existed, so
// every pre-existing study renders a behaviourally identical fvSchemes.
// CrankNicolsonDdt renders `CrankNicolson 1` for ddt(psi) ONLY -- momentum
// stays on Euler, whose L-stability is what keeps this capillary problem stable
// at the calibrated step.
PSI_DDT       EulerDdt;

// int(psi dV) conservation drift diagnostic (psiConservationCSV function object,
// cases/stationaryDroplet2D/system/controlDict.template). `false` = the entry is
// present but `enabled false`, for which functionObjectList::read() never calls
// functionObject::New and never dlopens libleiaFunctionObjects -- so every study
// that does not set this token runs and renders exactly as before the object
// existed, the same inert-by-default contract as SDPLS_SOURCE noSource above.
// `true` writes psiConservation.csv, one row per time step: int(psi dV) and its
// drift, the flux/divPhi/source decomposition of the assembled psi equation, the
// discrete solenoidality of phi, and -- deliberately in the same row -- the phase
// volume vol{psi < 0}, which is a DIFFERENT invariant (conflating the two is what
// the sdplsRdiv "fluxes cannot drain" claim did, before N=64 drained and N=128
// diverged at relative volume error +16.9).
PSI_CONSERVATION_CSV false;

// Per-time-step phase-volume correction (levelSet.volumeCorrection.type).
// noVolumeCorrection is the base class itself and a true no-op -- an unset
// token leaves psi untouched for the whole run, so every existing study is
// bit-unchanged. newtonShift applies the distance-preserving uniform shift
// psi <- psi + eps of Song et al. (2025). Read the block in the case
// fvSolution.template before using it: it conserves TOTAL volume only, is
// ill-posed for disconnected bodies, trades local shape for global volume, and
// must never be used to mask the coupled-drain instability.
VOLUME_CORRECTION noVolumeCorrection;

// Exact circle curvature 1/R for constantCurvatureSurfaceTension (R = 1e-3 m).
// Unread by every other surface-tension model.
CONST_CURVATURE 1000;
SOURCE_SCHEME simpleLinearImplicit;
SDPLS_BETA 1.0;      // sdplsBeta target gradient: f_nl = beta - |grad psi|
// SDPLS cut-off (mollifier), eq. (24) of arXiv:2208.01269. `none` disables it
// and reproduces every study run before 2026-08. mollifier1 forces the source
// to zero away from the interface: G = 1 for |psi| <= w1, decaying to 1e-3 at
// |psi| = w2. w1/w2 are PHYSICAL lengths -- scaling them with h would make the
// modified PDE mesh-dependent and its convergence order meaningless.
MOLLIFIER  none;
SDPLS_W1   0.05;     // preprint value (initial radius R0 = 0.3)
SDPLS_W2   0.15;     // preprint value; MUST be > w1
// `band` cut-off only: cells either side of the interface that the
// source acts over. Topological -- no |grad psi| assumption.
SDPLS_NLAYERS 3;
// SDPLS source gradients, as aliasDict names. The NORMAL that the strain
// cancellation is built from is only as good as GRAD_PSI_SDPLS; it was
// hardcoded to the most compact stencil in the file until 2026-08-15.
// GRAD_PSI selects the strategy: `fvc` (fvc::grad with the scheme below) or
// `narrowLS` (LLSQ plane-fit normals in the band). gradPsiMetric is NOT a
// token on purpose -- it is the measurement and must not move with the source.
GRAD_PSI_SDPLS SdplsLSQ;
GRAD_U_SDPLS   SdplsUGauss;
GRAD_PSI       fvc;
                     // (drives |grad psi| -> beta; beta = 1 = signed distance).
ADVECTION eulerian;  // unified leiaLevelSetFoam advection method:
                     // eulerian (implicit FV, advective form, nDefCorr
                     // deferred correction) | semiLagrangian (backward foot
                     // point + levelSet.semiLagrangian reconstruction).
REPORT_WRITE_ONLY false; // unified solver: compute the phase indicator and
                     // error rows only at write times ({0, T/2, T}). true in
                     // the decision-benchmark configs so every method pays
                     // the same reporting cost (fair ELAPSED_CLOCK_TIME).
SL_LIMITER none;     // slReconstruction slope limiter: none | barthJespersen |
                     // venkatakrishnan (order-preserving smooth cap).
SL_VENKK 5;          // venkatakrishnan threshold K (eps^2 = (K*h)^3).
SL_FIT normalEquations; // uncachedQuadratic least-squares solver:
                     // normalEquations (Cholesky) | householderQR (better conditioned).
SL_SCHEME pointValue; // semiLagrangian scheme: pointValue (non-conservative) |
                     // fluxForm (conservative swept-face flux, CFL<=1) |
                     // normalProjected (geometric nSL update along (u.n)n with
                     // per-step distance renormalization).
SL_OFFSET_CORRECTION none; // parallel-curve curvature offset correction:
                     // none | psi | psiOverGradPsi | quadraticRoot.
SL_RENORMALIZATION strain; // normalProjected in-band renormalization:
                     // geometric | strain | none.
SL_OFFSET_ENGINE rayRoot; // normalProjected geometric offset engine:
                     // rayRoot | footPoint (stabilized foot-point, Variant a).
GEOMETRY_FIT none;   // levelSet.geometryFit.type: a SECOND slReconstruction
                     // serving the GEOMETRY path (curvature, fitDerivatives,
                     // footPointDistance) while SL_RECONSTRUCTION serves
                     // TRANSPORT. none = one object for both (the historical
                     // behaviour, byte-identical: no second fit is built and no
                     // second stencil is gathered).
                     //
                     // WHY: the symbolic curvature path is implemented ONLY by
                     // uncachedQuadraticWeightedLeastSquares -- the base class
                     // throws NotImplemented -- so lowering the TRANSPORT order
                     // previously removed the curvature model with it. Setting
                     // GEOMETRY_FIT uncachedQuadraticWeightedLeastSquares keeps
                     // the quadratic kappa while SL_RECONSTRUCTION varies.
                     //
                     // CAVEAT when the two differ: the two objects hold
                     // different fits of the same psi, so the foot-point
                     // distance feeding the curvature inverse is consistent
                     // with the interface motion only to the TRANSPORT's order.
// Gaussian-curvature term of the cellCentreInverse parallel-surface inverse.
// yes (default) = the K-aware, dimension-seamless form every previous run used;
// K is identically zero in 2D and active only in 3D, so `no` runs a 3D case
// through the 2D algebra. That is the only available control isolating a
// dimension-specific term of the delivery, and the 3D ladder needs it: the
// coupled run is stable at R/h = 10.0 and 12.7 and destabilises at 15.8 with a
// growth rate rising 40.5 -> 52.3 -> 90.6 1/s, while the WP0 normal-direction
// band spectrum stays pinned -- so the driver is not the corrugation the psi
// filter damps. Static cost if K is innocent: the 3D sphere gate scores the
// K-aware inverse h^1.95 and the K-less control h^1.02.
CURVATURE_INVERSE_GAUSSIAN yes;

// Explicit fixed time step, overriding the h-derived capillary step. 0 = derive
// (the default, so every existing study is unchanged). Set > 0 only for the
// fixed-dt experiment: because the capillary law ties dt to h as dt ~ h^1.5, a
// refinement ladder moves the mesh and the step together and cannot tell a
// spatial effect from a per-step one. Measured on the 3D ladder, r*dt is constant
// to 24% while r itself rises 2.2x, so running one fixed dt across the ladder is
// what separates the two.
PSI_SURFACE signedDistanceEllipse; // implicitSurface.type for the ellipse/ellipsoid gate cases
WRITE_INTERVAL 0.02;    // controlDict writeInterval [s] (runTime write control)
FIXED_DELTA_T 0;

// Momentum ddt(rho,U) scheme. Euler is the default and what every validated result
// uses, so nothing changes unless a study sweeps it. backward is BDF2;
// CrankNicolson takes a blending coefficient. Raising this ALONE does not make the
// scheme 2nd order in time: the capillary force is evaluated once per step from the
// interface at t^n, which is 1st order whatever ddt does, and making it implicit
// instead (psiOuterCorrectors) is also 1st order and was measured inert. Genuine
// 2nd order needs a MIDPOINT capillary force as well.
// BDF2 IS NOW THE DEFAULT (2026-08-20, at the user's direction). It is formally the
// right choice: the semi-Lagrangian departure point is a second-order Taylor
// expansion and Euler was feeding it a first-order velocity. Measured in the 2x2
// (config/ddtOrderGain3D.yaml) at 3D R/h = 15.8: backward no longer diverges -- the
// 2026-07-14 peak of ~48 m/s is gone and its peak here is 6% BELOW Euler's -- and it
// improves the volume error by 20% (1.092e-05 -> 8.744e-06) and the shape error by
// 0.8%. It does NOT change the per-step gain (+1.1%), so it is an accuracy choice,
// not a stability fix. Every result predating this line used Euler.
// Time level the capillary force is evaluated at: endStep (force from psi^{n+1},
// symplectic Euler -- the historical path, byte-identical) or midpoint (force
// from psi^{n+1/2}, Stormer-Verlet, Popinet's staggering). For the linearised
// capillary oscillator the two are SPECTRALLY IDENTICAL -- both have det(M) = 1
// and trace 2 - omega^2 dt^2 -- so this changes the accuracy of the coupling and
// matches Popinet's arrangement, but it does not change linear stability or the
// step limit. midpoint runs the interface pipeline twice per step.
CAPILLARY_FORCE_CENTRING endStep;

MOMENTUM_DDT_SCHEME backward;

// Momentum convection. `linearUpwind gradU` reproduces the historical
// `linearUpwind grad(U)` exactly (both gradSchemes entries are Gauss linear); the
// alternative is `upwind`. Paren-free so the .parameter scalar parser accepts it.
// Momentum convection. DEFAULT IS NOW `upwind` (2026-08-20, at the user's direction).
// Measured INERT on the stationary droplet: against `linearUpwind gradU` at 3D
// R/h = 12.7 and 15.8 with BDF2, max U agrees to four significant figures
// (8.0915e-05 vs 8.0944e-05; 2.4093e-04 vs 2.4084e-04) and the per-step gain to 0.03%.
// The convective term is negligible at these velocities, so dropping the gradient
// correction costs nothing HERE. It is the default anyway because the exposure it
// removes is real -- U is continuous across Gamma but its GRADIENT is not, and
// linearUpwind extrapolates the face value with that discontinuous cell gradient -- and
// that exposure will matter for the TRANSLATING and OSCILLATING droplet, where the
// convective term is no longer negligible. The alternative remains
// `linearUpwind gradU`, verified bit-identical to the historical `linearUpwind grad(U)`.
MOMENTUM_DIV_SCHEME upwind;



// ===================== THE SHARED METHOD CONFIGURATION =====================
// Set 2026-09-01 on the author's instruction: every test uses ONE configuration of
// the method, and it is the best one on record. Until now the DEFAULTS were not
// that configuration -- studies pinned the good values case by case and whatever
// was left unpinned silently ran something worse. The translating droplet is the
// case that exposed it: every 2D translating run used curvatureExtension none
// while the 3D translating config set cellCentreInverse, so the two dimensions
// were not running the same method.
//
// Each change below is NOT INERT and is flagged where it sits. Results produced
// before this commit are not comparable to results produced after it unless the
// study pinned the token itself -- most of the recent ones did.
// ===========================================================================
// NOT INERT: none -> cellCentreInverse. REQUIRED BY THEORY, not preference. The
// balanced-force discretisation needs kappa CONSTANT over the CSF support, because
// the force is assembled as kappa_f*snGrad(alpha)_f and only a constant kappa makes
// that the snGrad of something the pressure can absorb. Without extension each cell
// centre carries the parallel-surface value at its OWN offset d, kappa(d) =
// kappa0/(1 + d kappa0), so the band varies in the interface-NORMAL direction and
// the force stops being a discrete gradient. Measured (cellCentreInverseCurvature.H,
// createSLFields.H): the non-gradient content alpha_f*snGrad(kappa_c) converges at
// order +2.01 over the full CSF support against +0.09 for every other cell curvature
// model, and is 3200x smaller at N=512 -- the only cell field that makes the
// UNBALANCEABLE part of the force converge under refinement. Its prerequisite, the
// uncached quadratic reconstruction, is already declared by every two-phase droplet
// case; kinematic cases do not reference this token at all.
CURVATURE_EXTENSION cellCentreInverse; // two-phase levelSet.curvatureExtension.type:
                     // none | harmonicLaplace | footPointHeightFunction |
                     // closestPointNewton | connectedInterface | interfaceMean
                     // | stabilizedFootPointFace (face kappa re-referenced to
                     // the interface at the stabilized foot-point offset)
                     // | cutCellFootPointFace (ONE inverted curvature per cut
                     // cell, assigned to its active faces)
                     // | cellMeanFootPointFace (the PER-FACE inversions,
                     // averaged over each cut cell's active faces -- same
                     // one-value-per-cut-cell structure, but built by
                     // AVERAGING n inversions rather than concentrating on
                     // one, which lowers the psi-to-kappa_f gain)
                     // | footPointEvaluatedFace (each adjacent cell evaluates
                     // its fit curvature AT the foot point of the FACE CENTRE
                     // on its own zero set -- no parallel-surface conversion;
                     // linear interpolation of the two per-cell values;
                     // second order where the level sets are NOT normal
                     // offsets, fit-error-limited where they are) | fvm.
N_OUTER_CORRECTORS 3; // PIMPLE.nOuterCorrectors (historical hardcoded value 3).
PSI_OUTER_CORRECTORS yes; // DEFAULT CHANGED 2026-08-28: the interface is
                     // re-advected on EVERY outer corrector, not only the
                     // first. Advecting once and then running N-1 further
                     // momentum/pressure iterations against a FROZEN interface
                     // makes the outer loop inconsistent with its own force:
                     // if the loop is worth iterating, the interface it is
                     // iterating towards has to move with it.
                     //
                     // The consistency question this settles (asked 2026-08-28):
                     // does re-advecting with the CURRENT iterate wrongly feed
                     // u^{n+1} to a trace that wants u^n? No. The kernel
                     // (pointValueScheme.C) computes
                     //   x_d = x_c - u_new dt + (dt^2/2)[(u_new-u_old)/dt
                     //                                   + (u_new.grad)u_new]
                     //       = x_c - dt/2 (u_new + u_old) + O(dt^2 grad u)
                     // so its LINEAR displacement is the AVERAGE of the two
                     // slots: it is arrival-centred and WANTS (u^{n+1}, u^n),
                     // forming u^{n+1/2} itself. The AB2 extrapolation on pass 1
                     // is the FALLBACK for u^{n+1} not existing yet, so a later
                     // pass carrying the real iterate is strictly more
                     // consistent, not less. The failure mode that WOULD break
                     // it -- refreshing the OLD slot on later passes, leaving
                     // the average between two new-time iterates and collapsing
                     // the trace to backward Euler -- is guarded in
                     // slAlphaEqn.H:121 (UextOld is written only on pass 1).
                     //
                     // MEASURED cost/benefit at N=128, m=2 mode rate, 12 outer
                     // correctors either way: r_2 = 3.906 (yes) vs 3.908 (no)
                     // at dt and -1.267 vs -1.269 at dt/2 -- INERT on stability
                     // to four digits, which is the un-preconditioned-Picard
                     // result (the loop contracts like (dt/dt_cap)^2). It costs
                     // one transport -> band -> indicator -> curvature ->
                     // delivery chain per extra outer pass.
                     //
                     // no = psi advected once
                     // per step on the first outer corrector, capillary force
                     // frozen across the outer loop (historical behaviour,
                     // byte-identical). yes = iterated interface-force
                     // coupling: every outer corrector restores psi^n and
                     // re-advects with the current velocity iterate (pass 1
                     // keeps the AB2 predictor), re-running band/indicator/
                     // curvature/face delivery so sigma*kappa_f*snGrad(alpha)
                     // converges to its t^{n+1} value -- backward-Euler
                     // consistency of the force with the fvm::ddt momentum
                     // LHS. MEASURED motivation: r = r0 + c*dt with the c*dt
                     // (explicit-coupling) term = 90% of the parasitic growth
                     // rate at N=128 (stationaryDropletDtSweep).
PSI_RENORM none;     // levelSet.psiRenormalization.type: none |
                     // footPointGradient (psi <- psi/|grad psi| at the foot
                     // point, on the band, every step). Restores the PARALLEL
                     // FOLIATION the parallel-surface curvature inverse
                     // assumes; a strictly positive rescaling, so the zero set
                     // and every sign are preserved exactly. MEASURED driver
                     // (plan sec. 14.2): beta spreads to [0.72, 1.37] by
                     // blow-up and the inverse's residual grows 600x.
PSI_RENORM_THRESHOLD 5e-3; // gate: fire only when the band L2 of the
                     // dimensionless non-parallelism |P H n|/beta * h exceeds
                     // this (<= 0 = every step). MEASURED over a reference run:
                     // 2e-4 at t=0.02, 1.3e-2 at 0.08, 4.5e-2 at 0.10.
PSI_RENORM_SWEEPS 2; // symmetric smoothing sweeps on the divisor beta_Gamma,
                     // separating the smooth drift from grid-scale fit noise.
PSI_RENORM_RELAX 1.0; // relaxation omega: psi <- psi/beta_Gamma^omega. omega=1
                     // is the one-shot correction, MEASURED 3.4x worse than no
                     // correction (2% psi kick per firing). omega << 1 spreads
                     // the same total correction over many steps, so the smooth
                     // part accumulates coherently and the fit noise does not.
FACE_CURVATURE_SOURCE model; // reconstructedCurvature kappa_f source: model
                     // (its own arithmetic/Kang assembly) | registered (the
                     // solver-registered face field, e.g. kappaStableFootFace).
SURFACE_TENSION_FORCE reconstructedCurvature;
ST_NSMOOTH 2;        // divGradAlphaSnGradAlpha alpha-smoothing sweeps (class default) // levelSet.surfaceTensionForce.type:
                     // reconstructedCurvature (kappa from the quadratic fit,
                     // delivered per-face; the high-order path) |
                     // divGradPsiSnGradAlpha (kappa = div(grad psi/|grad psi|)
                     // from the FVM operators -- ORDER-MATCHED to the 2nd-order
                     // FVM momentum discretization, and curvature-free so it
                     // works with a linear transport fit) | integralSurfaceTension.
                     // Cases that hardcoded a model pin their historical value in
                     // their own <Case>.parameter, so this default only applies
                     // where a template newly reads the token.
PSI_FILTER none;     // grid-scale psi filter (psiFilterEqn.H): none |
                     // biharmonicBand (psi -= theta*L(L(psi)) in band+1 ring).
PSI_FILTER_THETA 0.05; // filter strength theta (biharmonicBand only).
REDIST_REGION band;  // signedDistanceBounds criterion region: band (interface
                     // quality, default) | bulk (frozen-band fill region;
                     // REQUIRES REDIST_VIOLFRAC > 0 -- SDF skeleton has grad 0).
REDIST_FREEZE false; // PDE redistancer frozen-band variant: freeze sign-change
                     // band + REDIST_ANCHOR_LAYERS guard layers (transported
                     // values = Dirichlet anchors, zero interface displacement
                     // BY CONSTRUCTION); fill the bulk only.
REDIST_ANCHOR_LAYERS 2; // guard layers beyond the sign-change band (keeps fill
                     // error out of band-cell reconstruction stencils).
REDIST_HAMILTONIAN central; // PDE reinit |grad psi|: central (fvSchemes grad;
                     // MEASURED divergent, bulk 0.56->59.7) | godunov
                     // (Rouy-Tourin upwind, monotone+causal -- classical cure).
REDIST_NITER 30;     // PDE pseudo-time iterations (reach = niter*deltaTCoeff*h).

// Defect-correction passes of the EULERIAN psi advection loop
// (controlDict nDefCorr; eulerianAdvection.C + leiaRedistancedLevelSetFoam.C).
// >= 3: linearUpwind's second-order part is an explicit RHS source AND the
// SDPLS source is re-linearized every pass. UNRELATED to the semi-Lagrangian
// deferredCorrector's own nDefCorr, which lives in fvSolution.levelSet.
N_DEF_CORR 3;

// linearUpwind reconstruction gradient for div(phi,psi), as an aliasDict name
// (the value has spaces; see cases/2Dvortex/system/aliasDict). CellLimitedLSQ is
// the historical value, so every existing study renders unchanged.
// Swept by config/sdplsOrderAblation.yaml.
DIV_GRAD CellLimitedLSQ;

// ---------------------------------------------------------------------------
// 1D UNIAXIAL STRETCHING GATE (cases/1Dstretch). The only case in this
// repository with a CLOSED-FORM solution for both the interface AND the whole
// psi field, which is what makes it a verification gate rather than a
// convergence study.
//
// v(x) = a (x - x0) e_x with a = STRAIN_RATE [1/s], so d(v_x)/dx = a exactly and
// the strain the SDPLS source must supply, a_strain = nhat . grad(v) . nhat, is
// the EXACT CONSTANT a -- any measured deviation is discretization, never a
// modelling error. NOTE div(v) = a != 0: a one-dimensional flow CANNOT be
// solenoidal, which is intrinsic to the test and stated wherever it is reported.
//
// Exact solutions, along characteristics x(t) = x0 + (x_start - x0) e^{a t}:
//   no source : psi = x0 + (x - x0) e^{-a t} - xi0,  d(psi)/dx = e^{-a t}
//   source R  : psi = x - x_i(t),                    d(psi)/dx = 1 exactly
// with the interface at x_i(t) = x0 + (xi0 - x0) e^{a t} in BOTH arms -- losing
// the distance property does not move the zero contour, which is why a
// shape-only or volume-only metric would score the failed arm as perfect.
STRAIN_RATE   1;        // a [1/s]; 1 gives e^{-1} = 0.36788 at T = 1, a large signal
INTERFACE_POSITION 0.25; // xi0 [m]; x_i(1) = 0.25 e = 0.67957, well inside the box

// Which initial surface the 1D gate starts from.
//   implicitPlane -> ONE interface. The closest-point map is smooth everywhere,
//     every band cell's foot point is the same point, Uext is UNIFORM, and
//     closestPoint extension is EXACT (not merely second order).
//   implicitSlab  -> TWO interfaces at (x-c).d = +/- halfWidth. The medial axis
//     is the plane (x-c).d = 0, where the closest-point map JUMPS and Uext with
//     it, by a (x_R - x_L). This is the arm that reproduces the failure.
IMPLICIT_SURFACE implicitPlane;
SLAB_HALF_WIDTH  0.25;  // W [m]; the medial axis enters the band when nLayers*h > W

// Extension band half-width in cells. TOKENISED because the closestPoint
// diagnosis sweeps it against SLAB_HALF_WIDTH: the controlling parameter is
// W/(nLayers*h), and the jump enters the advected region exactly when it drops
// below one. The static circle gate (radius 0.15, 3 cells) never crosses it,
// which is why that gate reports O(h^1.98) for a model whose advection is poor.
N_LAYERS 3;

// closestPoint foot-point acceptance tolerance in CELLS (|psi(x_fp)| < cpTol*h).
// The shipped default is 0.1; the 1D gate sweeps it to test whether it sets the
// interface velocity error, which the static extension metric is blind to.
CP_TOL 0.1;

// closestPoint (the GEOMETRIC velocity extension) foot-point definition.
// fieldInterpolation is the shipped behaviour and stays the default, so every
// existing study is bit-unchanged. reconstructionFit reuses the quadratic LSQ
// fit of the semi-Lagrangian line, which is what the 1D gate tests.
FOOT_POINT_SOURCE fieldInterpolation;

// levelSet.narrowBand.type. signChange is the historical default and stays
// the default so every existing case is bit-unchanged.
NARROW_BAND signChange;

// velocityExtension fade metric: layer (default) | levelSet (historical |psi|).
FADE_MODE levelSet;

// closestPoint descent psi operator: cellPoint (default) | taylor.
CP_INTERP cellPoint;

// Rdiv assembled convection operator: off (default) | composite | normal.
SDPLS_COMPOSITE_FLUX off;

// Rdiv convecting-flux blend: phi_lambda = lambda*phi + (1-lambda)*phiW.
// lambda = 1 is R's own flux and reproduces the pre-blend assembly to the
// digit (4923800's self-check: at lambda = 1 the two forms are algebraically
// the same matrix), so 1.0 is the inert-by-default value. The token was
// introduced in 4923800 without a default, which broke materialization of
// EVERY study touching cases/2Dvortex (foam_param aborts on valueless tokens).
SDPLS_FLUX_BLEND 1.0;

// Semi-implicit (Hysing/Raessi/SAAMPLE) capillary term, an fvOption rendered
// into system/fvOptions (cases/stationaryDroplet2D/system/fvOptions.template).
// `off` = addSup returns without touching the momentum matrix -- verified
// bit-identical, so every pre-existing study is unchanged. `value` = the
// SAAMPLE arrangement (pairs with PSI_OUTER_CORRECTORS no); `increment` = the
// deferred-Jacobian form that vanishes at outer-loop convergence (pairs with
// PSI_OUTER_CORRECTORS yes + residual-controlled outer iterations). The
// coefficient multiplies sigma*dt (2/3 = the exact BDF2 Jacobian scale).
SEMI_IMPLICIT_CAPILLARY off;
SEMI_IMPLICIT_CAPILLARY_COEFF 1.0;
SEMI_IMPLICIT_LB true;

// PIMPLE.residualControl tolerances for the accuracy-driven outer loop
// (SAAMPLE Algorithm 1 in OpenFOAM vocabulary). 0 = the criterion can never
// be satisfied, so the loop runs the fixed nOuterCorrectors count -- the
// committed behaviour, bit-identical. The semi-implicit `increment` candidate
// raises these together with N_OUTER_CORRECTORS and PSI_OUTER_CORRECTORS yes.
OUTER_U_TOL 0;
OUTER_P_TOL 0;
// Which include the PIMPLE dict pulls: residualControl.off (empty -- the
// byte-identical historical dictionary) or residualControl.on (the block).
// A block with tolerance 0 is NOT equivalent to no block -- measured, see
// cases/*/system/residualControl.off.
PIMPLE_RESIDUAL_CONTROL_FILE residualControl.off;

// Semi-Lagrangian foot-point integrator and trace velocity (levelSet.
// semiLagrangian). Both defaults are the historical behaviour and are verified
// bit-identical; see the fvSolution.template comments for what each does.
//   footIntegrator: taylor | rk2
//   traceVelocity : cellCentred | projectedFlux | reconstructedU
//                 | reconstructedMomentum
// reconstructedU is the CONFOUND CONTROL for projectedFlux: same extension
// field, same reconstruct operator, but an unprojected (non-solenoidal) face
// flux. It exists to decide whether projectedFlux wins because the traced
// field is divergence-free or merely because reconstruct() smooths it.
// Uniform stream speed for the TRANSLATING droplet cases [m/s]. Referenced only
// by cases/translatingDroplet3D/0.org/U; 0.05 matches the committed 2D twin so a
// case that picks the token up by accident gets the intended physics rather than
// a silently stationary droplet.
TRANSLATION_SPEED 0.05;

// Two-phase mass flux for div(rhoPhi,U). CHANGED TO rhoLENT 2026-09-01 -- and
// this default is NOT INERT: it changes the momentum flux of every two-phase
// study that picks it up, so results before and after this commit are NOT
// comparable.
//
// WHY. interpolatedDensity and geometricFaceDensity build rho_f geometrically
// but solve NO density equation, so the mass actually transported and the mass
// used in div(rhoPhi,U) need not agree. At the water/air density ratio used
// here -- 998.2/1.19 = 839 -- that inconsistency is largest exactly where the
// interface MOVES through the mesh, which is the translating and oscillating
// droplet. rhoLENT (Liu et al., JCP 493:112426, 2023, Eq. 40 / Algorithm 1)
// adds the auxiliary conservative equation ddt(rho) + div(rhof^{n+1} phi^o) = 0
// on every PIMPLE outer iteration, making the mass flux in the density and
// momentum equations identical, and resets rho_c from the Detrixhe-Aslam alpha
// after convergence.
//
// Requires `"rho.*" { solver diagonal; }` in the case's solvers dict -- the
// equation is diagonal but fvMatrix::solve() still needs an entry.
// NOT INERT: rhoLENT -> geometricFaceDensity, agreed 2026-09-01. rho is then
// alpha1*rho1 + alpha2*rho2 and is bounded in [rho2, rho1] BY CONSTRUCTION -- there
// is no density equation to go unbounded. Measured: rhoLENT changes the translating
// outcome by 0.06% (8066 steps against 8061) while driving its auxiliary rho
// negative, which turns 1/rho in the pressure Laplacian indefinite and ends runs in
// a GAMG blow-up to 6.6e+70 rather than in anything readable.
//
// KNOWN TENSION, recorded rather than hidden: rhoLENT is BETTER on oscillating 2D at
// N=128 -- it completes the horizon where geometricFaceDensity reaches 98.2%, with
// shape error 1.26e-5 against 2.51e-4. Its PURPOSE, consistent mass-momentum
// transport at high density ratio, is sound; our implementation does not achieve it,
// because psi is advected by the semi-Lagrangian trace velocity while rho is
// transported by the face flux phi -- two different transport operators, which is
// exactly the consistency rhoLENT requires. Revisit when that is fixed.
// CHANGED TO rhoLENT 2026-09-02, on the author's decision. NOT INERT: results before
// and after are not comparable unless the study pinned the token itself.
//
// THE EVIDENCE. On the STATIONARY droplet rhoLENT is neutral-to-better and damages
// nothing (config/rhoLENTStationary2D, all 6 arms to the horizon, the control
// reproducing the shared ladder to five digits): the unabsorbed capillary residual
// moves +1.0% / -22% / +0.1% at N = 32/64/128, with volume and shape matching to three
// digits. On the TRANSLATING droplet at the only admissible resolution (N=128, R/h =
// 12.8) it is the best arm measured on every transport metric
// (config/massFluxComparison2D): travelled fraction 0.874 against 0.725, centroid error
// 6.3e-04 against 1.4e-03, phase-volume error 0.0024 against 0.0598.
//
// WHY IT WORKS, in one line: geometricFaceDensity solves no density equation, so
// ddt(rho) + div(rhoPhi) is whatever the geometry leaves it -- 4.8e-02 relative --
// and a droplet translating at U0 inherits a momentum source U0 times that residual,
// which is not a gradient and which vanishes identically at U0 = 0. That is the entire
// stationary/translating asymmetry, and rhoLENT drives the residual to ~1e-11.
//
// WHAT IT COSTS, recorded rather than buried: rhoLENT's auxiliary density is NOT the
// geometric one and is unbounded on its own -- it is usable only because
// MASS_FLUX_BOUND_RHO clips it, and that clip breaks the identity being enforced. It
// also carries the WORST velocity excess of the four arms compared, max|U-U0| = 2.12
// against 0.14. Whatever transports the droplet correctly currently carries a large
// max|U-U0|; that anti-correlation is unresolved and is the open problem.
MASS_FLUX rhoLENT;
// donorPlane, on the author's instruction (2026-09-01): "only Gauss upwind worked in
// rhoLENT". This is deliberately NOT the solver's own preference -- createTransport
// Fields.H defaults rhoLENT to `central`, and the committed IST cases set central
// explicitly -- so the disagreement is recorded rather than hidden.
//
// It also restores what the eight droplet cases actually had: every one of them
// hardcoded `faceInterpolation upwind` before this token existed, so upwind is
// the setting they were developed and validated with. Defaulting the new token
// to `central` would have silently changed the momentum flux of every one of
// them.
//
// The momentum divergence scheme is separately already Gauss upwind
// (MOMENTUM_DIV_SCHEME), so div(rhoPhi,U) and the face fraction now agree.
MASS_FLUX_ALPHAF_SOURCE donorPlane;

// FACE DYNAMIC VISCOSITY for the momentum viscous term.
//   interpolated  OpenFOAM's default: mu is a CELL field from the cell alpha, and
//                 fvm::laplacian interpolates it linearly to the faces.
//   geometric     mu_f = alpha_f mu1 + (1 - alpha_f) mu2 with the SAME geometric face
//                 area fraction that builds rho_f for the mass flux, so both face
//                 coefficients of the momentum equation descend from one discrete object.
// FACE DYNAMIC VISCOSITY for the one-field DNS viscous term. ONE token, SIX values, each
// naming both halves of the choice:
//
//              alpha_f from <alpha_c>_f      alpha_f geometric (the one that builds rho_f)
//   linear     alg_lin                       geo_lin
//   harmonic   alg_harm                      geo_harm
//   blended    alg_blend                     geo_blend
//
//   *_lin    mu_f   = alpha_f mu1 + (1-alpha_f) mu2
//   *_harm   1/mu_f = alpha_f/mu1 + (1-alpha_f)/mu2
//   *_blend  w mu_harm + (1-w) mu_lin,  w = |n.Sf|/|Sf|, n the interface normal and Sf the
//            FINITE-VOLUME FACE normal
//
// The grid is spelled out because an earlier token with three values silently mixed the two
// halves and left alg_harm untested, so "harmonic is worst" had only been measured on the
// geometric alpha_f. alg_lin IS the framework default: the linear model commutes with
// interpolation, which is exactly why the collapse went unnoticed.
//
// *_blend has NO free parameter: normal to the interface the phases are in SERIES
// (harmonic), tangent to it in PARALLEL (arithmetic), and w is the alignment of the two
// normals. Pure harmonic applies the series formula even on faces lying nearly IN the
// interface plane, where arithmetic is correct -- a candidate reason for its poor showing.
//
// DEFAULT alg_lin, decided 2026-09-03 on a 36-arm ladder: six models x N = 128/256/512 x
// mu1/mu2 in {54.83, 1000}, all with the explicit DNS viscous term (config/mufGrid2D_*).
// Least-squares orders of log(error) against log(h), with correlation coefficients:
//
//   mu1/mu2 = 54.83     L1@512     p(L1)   R      p(L2)   R      p(shape)  R     travel
//     alg_lin          3.494e-03   0.77  0.938    0.70  0.970    +0.37  0.673   1.0064
//     geo_lin          4.953e-03   0.15  0.401    0.50  0.977    -0.60 -0.623   1.0090
//     alg_harm         6.479e-03   0.16  0.316    0.44  0.862    -0.49 -0.557   1.0134
//     geo_harm         6.027e-03   0.08  0.242    0.51  0.996    -0.72 -0.694   1.0119
//     alg_blend        6.247e-03   0.26  0.454    0.36  0.704    -0.21 -0.319   1.0124
//     geo_blend        5.669e-03   0.11  0.298    0.50  0.988    -0.65 -0.656   1.0110
//
//   mu1/mu2 = 1000
//     alg_lin          1.400e-03   1.10  0.998    1.15  0.999    +0.71  0.984   1.0024
//     alg_blend        3.086e-03   0.83  0.965    0.90  0.978    +0.60  0.896   1.0062
//     geo_lin          1.834e-03   0.46  0.955    0.77  0.999    -0.37 -0.604   1.0033
//     geo_harm         4.670e-03   0.15  0.906    0.68  0.980    -0.56 -0.770   1.0105
//
// alg_lin is the ONLY model with a positive order in all three metrics at BOTH jumps, is
// lowest in absolute error at N=512 at both, and has the travelled fraction closest to 1.
// At the large jump it reaches first order with R = 0.998-0.999, the cleanest convergence
// this campaign has measured. Every other model except alg_blend at the large jump has a
// NEGATIVE shape-error order.
//
// RETRACTED. This token was briefly set to geo_lin because alg_lin appeared to destroy the
// droplet at mu1/mu2 = 1000. That divergence was a BUG, not a model property: muf was
// constructed once in createFields and only updated inside an "if (geometric)" branch, so
// the algebraic arms ran with a face viscosity FROZEN at the initial condition while the
// droplet translated away from it. faceViscosity.H now updates muf every step for all six
// models, and alg_lin is the best of them at that jump rather than the one that fails.
//
// harmonic and normalBlend are both worse than linear everywhere here, so the
// series/parallel argument for them does not describe what this discretisation needs.
VISCOSITY_FACE_MODEL alg_lin;

// rhoLENT ONLY (inert for every other mass-flux model, which solve no density
// equation). Clip the auxiliary density to [rho2, rho1] immediately after the
// density solve, BEFORE the momentum and pressure equations see it.
//
// WHY IT IS DEFENSIBLE. rho1 and rho2 are CONSTANTS here, so any rho outside
// [rho2, rho1] is unphysical by construction, and a NEGATIVE one is worse than
// unphysical: it flips the sign of 1/rho in the pressure Laplacian, the Poisson
// operator loses definiteness, and the run ends in a GAMG blow-up to 6.6e+70 with
// an FPE inside GAMGSolver::scale -- no result at all. Measured 2026-09-01 on the
// translating and oscillating droplets.
//
// WHY IT IS NOT FREE, and why the clip is REPORTED rather than silent. Clipping
// introduces a source S_clip, so ddt(rho) + div(rhoPhi) = S_clip instead of 0, and
// the momentum equation inherits U*S_clip -- the very discrete free-stream identity
// rhoLENT exists to enforce. The solver therefore writes rhoClipL1 (mean |clip| per
// unit volume) and rhoClipFraction (fraction of cells clipped) to the metrics CSV,
// so the consistency break is a MEASURED quantity. A run whose clip is at round-off
// has paid nothing; a run clipping heavily is telling you the auxiliary equation is
// inconsistent with its own flux, and the answer is to fix that, not to clip harder.
//
// Default false = every existing study is byte-unchanged.
// DEFAULT CHANGED TO true 2026-09-02, and it is INERT for the shared configuration:
// MASS_FLUX defaults to geometricFaceDensity, which solves no density equation, so
// there is nothing to bound and the solver says so and moves on. It matters only when
// rhoLENT is selected -- where without it the run does not produce a result at all.
//
// It is what makes MATCHED BDF2 viable. BDF2's homogeneous part is an extrapolation,
// rho^{n+1} = (4/3)rho^n - (1/3)rho^{n-1} - ..., so it undershoots by construction and
// drove rho to -72.28 (config/rhoDdtGate2D). Bounded, the matched backward/backward
// pairing runs the full horizon at N=128 with the best volume conservation measured on
// this case, and the clip stays small: clipL1 7.4e-04 against rho2 = 1.19.
MASS_FLUX_BOUND_RHO true;

// Diagnostic only, no effect on the solution: compute and write the discrete mass
// residual ddt(rho) + div(rhoPhi) for EVERY mass-flux model rather than only for
// rhoLENT. It is the quantity the mass-momentum consistency argument turns on --
// for a droplet translating at uniform U0 the spurious momentum source is U0 times
// this residual, and it vanishes identically at U0 = 0, which is exactly the
// stationary/translating asymmetry. geometricFaceDensity solves no density equation
// at all, so its residual is whatever the geometry leaves it and has never been
// measured. Costs one ddt and one div per outer iteration.
//
// Default false = every existing study is byte-unchanged.
MASS_RESIDUAL_DIAGNOSTIC false;

// TIME LEVEL OF THE GEOMETRIC FACE DENSITY (author's proposal, 2026-09-02).
//   new        rho_f from the NEW interface only -- what every run to date used.
//   trapezoid  1/2 (rho_f^n + rho_f^{n+1}), both geometric reconstructions.
//
// WHY IT IS THE RIGHT OBJECT. The density belonging in the mass flux is that of the
// fluid which actually CROSSES the face during the step -- a time average over the
// swept region -- not the plane value at t^{n+1}. The trapezoid of the two endpoint
// reconstructions is a second-order approximation to that swept average. It costs one
// extra plane reconstruction per outer iteration and NO solve, and unlike rhoLENT it
// leaves rho purely geometric, hence bounded in [rho2, rho1] by construction with no
// clipping.
//
// WHAT IT CANNOT DO. It cannot drive ddt(rho)+div(rhoPhi) to zero. That balance is
// ONE CONSTRAINT PER CELL while a two-level blend supplies one value per face from a
// POINTWISE rule; with more faces than cells a satisfying face field exists, but no
// local formula reaches it -- closing it exactly needs a projection (solve
// laplacian(lambda) = residual, then rhoPhi -= snGrad(lambda)). So the expectation is
// a REDUCTION, and its size is what decides whether that projection is worth building.
//
// Default `new` = every existing study is byte-unchanged.
MASS_FLUX_ALPHAF_TIME_LEVEL new;

// MASS-FLUX PROJECTION (author's proposal, 2026-09-02). Correct the geometric mass
// flux so it satisfies the discrete mass balance EXACTLY, instead of solving for an
// auxiliary density as rhoLENT does.
//
//     rhoPhi* = rhoPhi - rhoPhi',   div(rhoPhi') = R = ddt(rho) + div(rhoPhi)
//
// One equation per cell for a face field is underdetermined, so take the curl-free
// member -- the minimal-L2 correction, the smallest change to the flux that fixes the
// balance: rhoPhi' = snGrad(lambda)*magSf with laplacian(lambda) = R. lambda is a
// scalar POTENTIAL for the correction, to the mass flux exactly what pressure is to
// the volumetric flux; it has no physical identity and its dimensions, kg/(m s),
// follow from the equation.
//
// WHY IT MAY BEAT rhoLENT. rhoLENT zeroes R by solving for an auxiliary rho, which is
// then no longer the geometric one and is UNBOUNDED -- it needs MASS_FLUX_BOUND_RHO,
// and that clip breaks the very identity being enforced. The projection zeroes R the
// other way: rho stays purely geometric, hence bounded in [rho2, rho1] BY
// CONSTRUCTION, with no auxiliary equation and no clip. The price is one Poisson solve
// per outer iteration and a rhoPhi that is no longer exactly rho_f*phi.
//
// WHAT IT CANNOT FIX, and this is diagnostic rather than incidental. The problem is
// all-Neumann, so it is solvable only if the volume integral of R vanishes -- and that
// integral is the rate of change of TOTAL MASS, which is nonzero because the droplet
// INFLATES by +5 to +8 percent over the horizon, a semi-Lagrangian transport defect no
// flux redistribution can repair. The mean is subtracted before solving and what is
// subtracted IS that drift; the solver reports it as massProjGlobalDrift. So this
// fixes the DISTRIBUTION of the imbalance and leaves its GLOBAL part alone.
//
// Requires a `massFluxPotential` entry in the case's solvers dict. Default false, so
// every existing study is byte-unchanged.
MASS_FLUX_PROJECT false;

// Time scheme of the rhoLENT AUXILIARY density equation, ddt(rho). IT MUST MATCH
// MOMENTUM_DDT_SCHEME, and `backward` is that match for the repository default.
//
// WHY MATCHING, MEASURED (config/matchedBDF2Translating2D, 2026-09-02). For a droplet
// translating at uniform U0 the exact solution is U == U0 everywhere, and momentum's
// transient plus convection collapses, for constant U, to U0 times the discrete mass
// residual -- but only if ddt(rho,U) expands with the SAME time scheme as ddt(rho).
// Otherwise momentum additionally inherits
//
//     U0 * [ ddt_mom(rho) - ddt_mass(rho) ],
//
// which for a backward/Euler pairing is U0*(1/2)(rho^{n+1} - 2rho^n + rho^{n-1})/dt --
// half the second difference of rho over dt, O(U0*drho/dt) in any cell the interface
// sweeps. The full 2x2 at N=128, droplet clear of the outlet, all on rhoLENT:
//
//   mom ddt   rho ddt   pair        steps  End   travelFrac   volErr
//   Euler     Euler     matched     13334  yes     0.7667     0.0525
//   Euler     backward  MISMATCHED  13334  yes     0.8827     0.0585
//   backward  Euler     MISMATCHED  10431  NO      1.3210     0.7747
//   backward  backward  matched     13334  yes     0.8737     0.0024
//
// backward/backward is the best arm in the study -- matched AND second order, full
// horizon, and a phase-volume error 22x below the next best. The BDF2 rule stands;
// the method does not have to trade time order for consistency.
//
// RETRACTION. This token shipped on 2026-09-01 (f7307b5) defaulting to Euler, on the
// reasoning that BDF2 on the auxiliary density equation is an extrapolation rather
// than a convex combination and drives rho negative. That reasoning was right and the
// default was wrong: before that commit NO case wrote a ddt(rho) entry, so it
// inherited `default` and was AUTOMATICALLY MATCHED to momentum. Defaulting to Euler
// broke the matching and produced backward/Euler -- the ONLY pairing in the 2x2 that
// diverges. The correct fix for the unbounded rho was never the time scheme; it is
// MASS_FLUX_BOUND_RHO below.
//
// If MOMENTUM_DDT_SCHEME is changed, change this with it.
// backward, to MATCH MOMENTUM_DDT_SCHEME. Settled on measurement after I changed this
// token three times in one day; the record of that is below because the flip-flopping
// is itself the lesson.
//
// WHAT THE PAPER SAYS. Liu et al., JCP 493 (2023) 112426, eq. (40) is an EXPLICIT
// two-level update -- "rhoLENT does NOT use an implicit discretization for eq. (40) ...
// it is solved EXACTLY" -- so the method as published uses Euler here. It also says
// consistency "does NOT depend on the implicit or explicit discretization", only on the
// equivalence of the mass flux between the two equations.
//
// WHY WE STILL USE backward. The paper's algorithm is Euler in the MOMENTUM equation
// too (SAAMPLE); this repository mandates BDF2 momentum. The measured fact is that the
// PAIRING must match, and the mismatch is fatal in exactly one direction:
//
//   momentum / ddt(rho)     N=128 translating, admissible rung
//   Euler    / Euler        matched      COMPLETES 13334
//   Euler    / backward     mismatched   COMPLETES 13334
//   backward / Euler        mismatched   DIVERGES  ~10431
//   backward / backward     matched      COMPLETES 13334, best volume error 0.0024
//
// backward/Euler has now diverged in two independent studies at the same step count
// (config/matchedBDF2Translating2D at 10431, and all four arms of
// config/volumeCorrectionTranslating2D at 10084-10437). With momentum on backward, this
// token on Euler is the one configuration that does not run.
//
// MY OWN RECORD ON THIS TOKEN, kept as a caution: it had NO entry originally, so it
// inherited `default` and was automatically MATCHED; f7307b5 set it to Euler for
// boundedness and broke the matching; 28a1383 restored backward; b60e3df set it to
// Euler again on the paper and broke it a second time, which is what those four
// divergences are. Read the pairing table before changing it, and change
// MOMENTUM_DDT_SCHEME with it.
//
// MASS_FLUX_BOUND_RHO REMAINS NECESSARY, and my claim that Euler would remove the need
// is FALSIFIED: with boundRho false the density reached -27.7 and -1786 over the full
// horizon even with ddt(rho) = Euler. The 4-rank gate that suggested otherwise ran 167
// steps.
RHO_DDT_SCHEME backward;

// FLUID PROPERTIES, tokenised 2026-09-02 so the DENSITY RATIO can be swept as a
// control. Defaults are the committed water/air pair, so every existing study renders
// byte-identically.
//
// WHY THE RATIO IS WORTH SWEEPING. With rho1 = rho2 the single-field density is
// CONSTANT, so ddt(rho) = 0 and div(rhoPhi) = rho div(phi) = 0 EXACTLY: the discrete
// mass residual vanishes by construction and rhoLENT's auxiliary equation is trivial.
// Anything that still goes wrong therefore cannot be the mass flux. It is the cleanest
// available isolation of rhoPhi from the rest of the method.
//
// MATCH rho1 + rho2 WHEN SWEEPING THE RATIO. The capillary limit is
// dt_cap = sqrt((rho1+rho2) h^3 / (2 pi sigma)) while the repository's step law
// dt = 10.861 h^1.5 is independent of density, so the SAFETY FACTOR (0.2323) moves with
// the density SUM. Holding the sum fixed at 999.39 keeps every arm at the same fraction
// of the capillary limit; changing it silently changes the effective time-step
// stringency and confounds the comparison. Equal densities at the committed sum are
// therefore 499.695 each, NOT 998.2 or 1.19 each.
RHO1  998.2;
RHO2  1.19;
NU1   1e-06;
NU2   1.53e-05;
SIGMA 0.07274;

// --- popinetTranslating2D ONLY. Inert for every other case: no other case template
// references these tokens, so nothing else renders differently.
//
// Reproduction of Popinet, JCP 228 (2009) 5838-5866, Section 6.2.2 "Translating droplet",
// the test case he introduced for exactly this purpose ("I am not aware of any study using
// a combination of both"). His configuration, read from the paper:
//   circular interface D = 0.4 in the unit square, 64x64 effective  -> R/h = 12.8
//   periodic in x, symmetry top and bottom, uniform background velocity U
//   We = 0.4;  La = sigma D / (rho nu^2) in {120, 1200, 12000, infinity}
//   CONSTANT density and CONSTANT viscosity -- Section 6.2.1 says "rho the constant
//   density" and La carries a single rho and nu, so BOTH ratios are 1. His air/water
//   ratios (850 and 55.72) appear only in the Section 6.3 capillary wave.
//   Properties mixed as c*q1 + (1-c)*q2 with c_f "a simple average of the cell-centred
//   values" -- i.e. our alg_lin, which our own 36-arm ladder also selected.
//
// Non-dimensionalisation chosen here: rho = 1, sigma = 1, D = 0.4, U = 1, so
// We = rho U^2 D / sigma = 0.4 exactly, and nu = sqrt(0.4/La).
DROPLET_RADIUS 1e-3;    // production radius; popinetTranslating2D overrides to 0.2
POPINET_XLEN   2;       // box length in x, in units of the unit height
POPINET_NX     128;     // cells in x = 2*N_CELLS
POPINET_RHO    1;       // both phases
POPINET_NU     5.773503e-03;   // both phases; La = 12000

// Sub-cell displacement of the droplet centre in x, in METRES. The rendered centre
// is the DERIVED token DROPLET_CENTRE_X = DOMAIN_HALF_LENGTH + DROPLET_OFFSET_X,
// so 0 is byte-identical to the old `center (@!DOMAIN_HALF_LENGTH!@ ...)` and every
// existing study renders exactly as before -- INERT, and gated by bit-identity
// rather than asserted.
//
// WHY IT EXISTS (2026-09-01). A droplet centred in the box sits at ONE fixed phase
// relative to the mesh for an entire run, and being centred, the most symmetric
// phase available. A TRANSLATING droplet sweeps through every phase. That is the
// structural reason the stationary droplet can be clean while the translating one
// fails -- measured, same N=128, same trace, same dt, same force model: relL2
// unabsorbed capillary residual 8.53e-07 stationary against 1.24e-03 translating,
// 1450x -- and it means the stationary droplet is a WEAK test that can pass on
// alignment luck.
//
// Sweeping this token across one cell width, with leiaTestMeanCurvature on a frozen
// field, measures the curvature estimator's mesh-phase sensitivity directly and in
// seconds: it is the exact-solution unit rung of the ladder for a defect that has
// so far only been chased in coupled runs costing hours.
DROPLET_OFFSET_X 0;

SL_FOOT_INTEGRATOR taylor;
// NOT INERT: cellCentred -> projectedFlux. Measured this campaign, stationary 2D
// ladder: the unabsorbed capillary residual falls monotonically 2.37e-5 / 3.15e-6 /
// 8.53e-7 / 6.43e-7 at N=32/64/128/256 for projectedFlux, while cellCentred blows up
// at the two finest rungs (5.48e-4, 2.79e-2). Oscillating 2D: projectedFlux reaches
// the full horizon at all three rungs, cellCentred at none of the two finest. And
// config/kinematicTranslation2D showed the two are BIT-IDENTICAL under uniform
// translation, so this default costs nothing where the flow cannot tell them apart.
SL_TRACE_VELOCITY projectedFlux;

// ---- Static local mesh refinement around the interface (pre-processing) ----------
// Consumed by workflow/scripts/leiaRefineHexMesh.py / leiaRefinePolyMesh.py through
// case_params.json (mesh: hexRefined | polyRefined) and by materialize, which derives
// N_CELLS_BASE = N_CELLS / 2^REFINE_LEVELS for blockMesh. N_CELLS stays the capillary
// dt handle and on a refined mesh means the FINE count. INERT: REFINE_LEVELS 0 renders
// N_CELLS_BASE verbatim as N_CELLS, so every existing study is byte-identical.
// ---- Semi-Lagrangian quadratic fit: geometric admissibility (2026-09-05) --------------
// Smallest Cholesky pivot of the Jacobi-scaled (unit-diagonal) weighted normal matrix a
// cell's stencil must reach for the QUADRATIC fit; below it the cell uses the linear fit
// (and a linear stencil below it keeps the cell value). Built from stencil POSITIONS
// alone, so the decision is made once, per mesh. cfMesh's boundary-layer and
// size-transition polyhedra (10 point-neighbours for 9 coefficients) had scaled
// condition numbers > 1e6 and curvature coefficients up to 1e8 -- exact at zero
// displacement, garbage at U dt: the translating polyhedral droplet blew up at step 3.
// 0 = never fall back (the behaviour before the fix, the control arm).
// The value is read off the pivot census of the meshes we run (one-step runs with
// SL_WRITE_FIT_ORDER true, workflow/scripts/sl_fit_pivot_census.py): band cells
// (|psi| < 6h) >= 0.94 on every polyhedral mesh and >= 0.77 on hex; near band (6-12h)
// >= 0.74; hex interior >= 0.64 (hanging-node cells included); polyhedral interior
// >= 0.50. The degenerate boundary-layer / grading-transition stencils form a tail
// from 0 to ~0.3 and the 0.3-0.4 bin is nearly empty on all three polyhedral meshes
// (40 / 32 / 16 cells of 130k / 91k / 147k). Stability requires the admitted
// condition number c to satisfy c (U dt / h)^2 < 1: 1e-2 (c ~ 1e4) diverged at
// step 16 of the Popinet translating droplet (U dt / h = 0.016), so pivots up to
// 3e-2 amplify; 0.3 admits c <~ 100, stable for U dt / h < 0.1, and demotes 7 percent
// of the cells of a uniform cfMesh box, all in the wall boundary layer, none within
// 12h of an interface. Hex meshes are untouched (bit-identical).
SL_QUAD_PIVOT_TOL 0.3;
SL_WRITE_FIT_ORDER false;   // "true": write slFitOrder (2 quadratic / 1 linear / 0 constant) once, a diagnostic field
// ---- Semi-Lagrangian stencil: physical boundary faces as data (2026-09-05) -----------
// OpenFOAM's cell-to-cell stencils count every non-coupled, non-empty boundary FACE as a
// data point. With psi zeroGradient on inlet/outlet/walls each face brings the cell's own
// value at h/2 (0.19 h in cfMesh's boundary cells) at a 1/d^2 weight four to thirty times a
// neighbour's, so the fit's boundary-normal gradient collapses toward zero. MEASURED on
// Popinet's translating droplet (78-step smokes, t = 0.02): the level set moved at 8 % / 24 %
// (polyhedral inlet / outlet) and 20 % / 49 % (hex) of the exact rate normal to the boundary,
// tangential transport exact (1.002); the outlet error then grew exponentially behind cfMesh's
// boundary layer (e-fold ~100 steps), produced a fake zero set at step 865 / 1002 and blew the
// two ladder rungs up. Invisible on every closed-box case and every kinematic gate (u = 0 at
// the walls). `exclude` fits CELL data only -- MEASURED in 2D: the outlet becomes exact but the
// inlet, whose departure foot lies OUTSIDE the domain, extrapolates and blows up (step 716):
// a control, not a fix. `inflowOnly` decides per face by the sign of the flux: an inflow or
// no-flow face is data (the boundary condition speaks there), an outflow face is not (the
// interior determines the value, upwind). Processor patches are remote cells, never boundary
// slots (MPI untouched); empty patches were never included. Default `include` = the former
// behaviour until the inflowOnly gates are recorded in STATUS.
SL_STENCIL_BOUNDARY_FACES include;

// ---- Non-orthogonal correction of the pressure/viscous Laplacians (2026-09-05) -------------
// nNonOrthogonalCorrectors was hardcoded to 1 in every template. blockMesh hex is orthogonal,
// but cfMesh polyhedra reach 54 deg (Popinet-3D N = 64: max 54.4, average 4.2, skewness 1.7,
// 8 concave corner cells) and the polyhedral Popinet runs carried a CONSTANT boundary-cell
// velocity defect max|u'| = 0.0945 U from step 20 (hex twin: 0.0134) -- the signature of an
// under-corrected Laplacian on the strongly non-orthogonal boundary-layer cells. Swept on the
// cluster (popinet3D_La12000_poly_smoke_nonOrth, polyDroplet3D_r13p8_nonOrth: 1 / 3 / 6): the
// stationary polyhedral rung changes by <= 5e-6 relative in the velocity norms and the
// translating smoke not at all -- the correction converges in the first pass. Token name shared
// with the IST 2D templates (materialize.py knows it). INERT default: 1.
N_NON_ORTHOGONAL_CORRECTORS 1;

REFINE_LEVELS     0;          // halvings of the near-interface cell size; >= 1 only with hexRefined | polyRefined
REFINE_BAND_CELLS 6;          // complete fine layers each side, worst case (hex: face dilations are added until psi proves it)
REFINE_SOURCE     interface;  // interface (0 < alpha < 1 seed + dilations) | ball (CONTROL: whole droplet interior)
REFINE_ALLOW_PIN_MISMATCH false; // "true" ONLY to match a twin's N_CELLS on purpose: the band check then reports,
                                  // but does not fail on, an N_CELLS that is not the measured fine spacing
