values
{
    // The interface (problem data, 2026-11-18): implicitSphere (radius SURFACE_R) or
    // signedDistanceEllipsoid (semi-axes SURFACE_A, SURFACE_B, SURFACE_C). Default = the
    // historical sphere of the case (Liovic et al. 2006).
    SURFACE_TYPE ( implicitSphere );
    SURFACE_X0 ( 0.35 );
    SURFACE_Y0 ( 0.75 );
    SURFACE_Z0 ( 0.25 );
    SURFACE_R ( 0.15 );
    SURFACE_A ( 0.15 );
    SURFACE_B ( 0.15 );
    SURFACE_C ( 0.15 );

    // The prescribed face flux U(x_f) & S_f is far from discretely divergence-free on
    // polyhedra; project it (velocityModel.fluxProjection, STATUS 11.25).
    FLUX_PROJECTION ( helmholtz );

    PHASE_INDICATOR ( geometric detrixheAslam );
    solver (leiaLevelSetFoam);

    END_TIME (3.0);

    CFL ( 0.3 );

    MAX_CELL_SIZE // cfmesh
    (
        0.04  // ~

        0.02 // ~600kCells

        0.01 // ~
    );

    SURFACE_FILE
    (
        box-shear-edges.stl
    );
            
    SOURCE_SCHEME
    (
        explicit 
        simpleLinearImplicit 
        strictNegativeSpLinearImplicit
    );

    // Eulerian fvSchemes tokens (shared 3Dshear fvSchemes.template references
    // them); inert for the SL solver but required so the dict renders. Mirror
    // cases/3Dshear.parameter / 3Ddeformation_poly.parameter.
    MOLLIFIER
    (
        none
        m1
    );

    GRAD_PSI
    (
        fvc
        narrowLS
    );

    SDPLS_SOURCE
    (
        noSource
        R
        beta
    );
    
    BC
    (
        zeroGradient
    );
    
    DIV
    (
        linear
        $LinearUpwind
        vanLeer
        $Gamma1
        MUSCL 
        Minmod
        OSPRE 
        SFCD
        SuperBee
        UMIST
        vanAlbada 
        upwind
    );
    
    TANH_LIMIT
    (
        0.1
    );

    PROFILE
    (
        signedDistance 
        tanh
    );
}
