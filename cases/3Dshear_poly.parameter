values
{
    PHASE_INDICATOR ( geometric detrixheAslam );
    solver (leiaLevelSetFoam);

    END_TIME (3.0);

    CFL ( 0.3 );

    MAX_CELL_SIZE // cfmesh
    (
        0.04  // ~

        0.02 // ~600kCells

        0.01 // ~
    );

    SURFACE_FILE
    (
        box-shear-edges.stl
    );
            
    SOURCE_SCHEME
    (
        explicit 
        simpleLinearImplicit 
        strictNegativeSpLinearImplicit
    );

    // Eulerian fvSchemes tokens (shared 3Dshear fvSchemes.template references
    // them); inert for the SL solver but required so the dict renders. Mirror
    // cases/3Dshear.parameter / 3Ddeformation_poly.parameter.
    MOLLIFIER
    (
        none
        m1
    );

    GRAD_PSI
    (
        fvc
        narrowLS
    );

    SDPLS_SOURCE
    (
        noSource
        R
        beta
    );
    
    BC
    (
        zeroGradient
    );
    
    DIV
    (
        linear
        $LinearUpwind
        vanLeer
        $Gamma1
        MUSCL 
        Minmod
        OSPRE 
        SFCD
        SuperBee
        UMIST
        vanAlbada 
        upwind
    );
    
    TANH_LIMIT
    (
        0.1
    );

    PROFILE
    (
        signedDistance 
        tanh
    );
}
