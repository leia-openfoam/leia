FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      psi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

// The static source test (STATUS 11.27): the internal field is written by setExprFields
// (system/setExprFieldsDict, one variant of system/initFields per case). `uniform 0` stays here:
// write_end_reference.py hands 0.org to leiaSetFields for the reference psiEnd/alphaEnd.
// zeroGradient on the four walls, as in every 2D kinematic case of this repository.

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    right
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }
}

