FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    psi 
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0;
    }

    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0.;
    }

    // Velocity-extension solves (copied from 2Dvortex, 2026-09-26).
    pseudoTimeUext
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-3;
    }

    steadyUpwindUext
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-4;
        maxIter         500;
    }

    steadyUpwindLinearUext { $steadyUpwindUext }
    closestPointUext       { $steadyUpwindUext }   // fallback fill solve
    meshWaveUext           { $steadyUpwindUext }   // never solved (wave only)
    noneUext               { $pseudoTimeUext }     // identity model: never solved

    "Uext.*" { $@!VELOCITY_EXTENSION!@Uext; }

    // anchoredEikonal redistancer fill solve (leiaRedistancedLevelSetFoam):
    // ASYMMETRIC advection-diffusion linearization -> PBiCGStab/DILU
    // (never PCG/DIC).
    "psiDist.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-09;
        relTol          1e-4;
        maxIter         500;
    }
}

PISO
{
    nCorrectors     -1; // Disables p-v coupling.
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}

velocityModel
{
    type shear3D; 
    oscillation @!OSCILLATION!@;
}

levelSet
{
    // Advection method: how psi^n becomes psi^{n+1} (unified solver).
    reportAtWriteTimesOnly @!REPORT_WRITE_ONLY!@;

    advection
    {
        type @!ADVECTION!@;   // eulerian | semiLagrangian
    }

    narrowBand  
    {
      type  signChange;
    }


    profile
    {
      type  @!PROFILE!@;
      limit  @!TANH_LIMIT!@;  // tanh profile ONLY -- signedDistance ignores it
    }


    implicitSurface 
    { 
        //Liovic, P., Rudman, M., Liow, J. L., Lakehal, D., & Kothe, D. (2006).
        //A 3D unsplit-advection volume tracking algorithm with
        //planarity-preserving interface reconstruction. Computers and Fluids,
        //35(10), 1011–1032. https://doi.org/10.1016/j.compfluid.2005.09.003
        type implicitSphere; 
        radius 0.15;
        center (0.35 0.75 0.25); 
    }

    phaseIndicator
    {
        type @!PHASE_INDICATOR!@;
    }

    redistancer
    {
        type                @!REDISTANCER!@;
        trigger             @!REDIST_TRIGGER!@;
        threshold           @!REDIST_THRESHOLD!@;
        redistanceInterval  @!REDIST_INTERVAL!@;
        gradBound           @!REDIST_GRADBOUND!@;
        bandViolationFraction @!REDIST_VIOLFRAC!@;
        criterionRegion     @!REDIST_REGION!@;
        freezeBand          @!REDIST_FREEZE!@;
        anchorLayers        @!REDIST_ANCHOR_LAYERS!@;
        // PDE baseline (ignored by the geometric models): mesh-relative
        // pseudo-time step -- the explicit reinit equation is CFL-limited
        // by h, a fixed deltaT stable on one mesh diverges on finer ones
        // (measured: deltaT 0.1 at h = 1/64 -> band error 7.5e6). 30 steps
        // of 0.5h reinitialize the trigger's 6h band.
        deltaTCoeff 0.5;
        hamiltonian @!REDIST_HAMILTONIAN!@;
        niterations @!REDIST_NITER!@;
        write       false;
        // anchoredEikonal fill budget: the frozen-direction Tucker
        // iteration plateaus if stopped early (measured: maxIter 10 left
        // the band WORSE than pre-event).
        epsilon     0.1;
        tolerance   1e-4;
        maxIter     100;
    }

    // Per-time-step phase-volume correction (Song, Long, Cai & Pan,
    // Phys. Fluids 37(9):092109, 2025; preprint arXiv:2202.10275). A single
    // scalar eps is found by Newton-Raphson so that the phase volume is
    // restored, and psi <- psi + eps is applied. Because eps is spatially
    // CONSTANT, grad(psi + eps) = grad(psi), so |grad psi| is untouched: the
    // correction conserves volume WITHOUT spending the signed-distance
    // property SDPLS exists to maintain. That is why it is worth having here
    // and not in a generic level-set code.
    //
    // KNOWN LIMITS, which must be stated wherever a result using it is
    // reported:
    //   * a single global eps conserves TOTAL phase volume only, and is
    //     ILL-POSED for multiple disconnected bodies -- one eps cannot
    //     conserve each body separately. Connected-component labelling with a
    //     per-body eps_i is the documented remedy and is NOT implemented.
    //   * it fixes the total while DISTORTING local interface position, so
    //     shape error must always be reported alongside volume error. An arm
    //     that improves volume while degrading shape is reported as such.
    //   * it must NOT be used to "fix" the coupled Navier-Stokes drain: that
    //     failure is a 260x-amplified mode-4 parasitic current physically
    //     squaring and destroying the droplet, not a bookkeeping error.
    //     Restoring the volume NUMBER would leave a square droplet of correct
    //     area -- worse than a visible failure, because it hides the
    //     instability.
    //
    // Default noVolumeCorrection is the base class itself and is a true no-op,
    // so every study that does not set this token is bit-unchanged.
    volumeCorrection
    {
        type @!VOLUME_CORRECTION!@;
    }

    sdplsSource
    {
        type            @!SDPLS_SOURCE!@;
        beta            @!SDPLS_BETA!@;  // sdplsBeta only: f_nl = beta - |grad psi|
        discretization  @!SOURCE_SCHEME!@;
        gradPsi         @!GRAD_PSI!@;
        // Cut-off: eq. (24) of arXiv:2208.01269. w1/w2 are PHYSICAL lengths and
        // BOTH must be tokens -- w1 was hardcoded here with no w2 at all, so w2
        // fell back to its 1e-3 default, which is smaller than w1 and is now a
        // FatalError. Before that guard existed it silently produced a cut-off
        // whose decay length was |w2 - w1| rather than anything the dictionary
        // stated.
        mollifier
        {
          type    @!MOLLIFIER!@;
          w1      @!SDPLS_W1!@;
          w2      @!SDPLS_W2!@;
          // `band` cut-off only: dilation passes beyond the seed layer.
          // A CELL COUNT -- it needs no assumption about |grad psi|,
          // unlike the w1/w2 lengths above, which only mark a fixed
          // distance while psi is a signed distance function.
          nLayers @!SDPLS_NLAYERS!@;
        }

        // gradientControl only (Phase D2; inert for every other type): the law of F.
        law
        {
            // F = w(q)*a + G(q) in D_t psi = psi*F; q = |grad psi|, a = n.D.n.
            // G(1) = 0 for every law. A law reads only its own entries, and every
            // entry that a law reads is REQUIRED (no code default).
            //   none | linearQ | linearZ | cubicQ | cubicZ | twoThirdsZReg |
            //   saturatedLinearZ | softWall
            type        @!GC_LAW!@;
            mu          @!GC_MU!@;   // [1/s] rate of the q- and z-laws
            eps         @!GC_EPS!@;   // twoThirdsZReg: G = -mu*zeta/(zeta^2 + eps^2)^(1/6)
            c           @!GC_SAT_C!@;   // saturatedLinearZ: G = -mu*zeta/(1 + c*|zeta|)
            // softWall: G = -cKappa*sqrt(D:D + epsD^2)*tanh[gamma*((q - 1)/deltaS)^p]
            cKappa      @!SW_C_KAPPA!@;
            deltaS      @!SW_DELTA_S!@;
            p           @!SW_P!@;   // odd
            gamma       @!SW_GAMMA!@;   // artanh(0.9)
            epsD        @!SW_EPS_D!@;   // [1/s]
            // The weight w(q) of the strain term a:
            //   none (w = 0) | full (w = 1: the SDPLS R source) |
            //   omega (w = 1 - exp[-beta*((q - 1)/deltaS)^(2m)])
            strainWeight
            {
                type    @!GC_STRAIN_WEIGHT!@;
                beta    @!OMEGA_BETA!@;
                m       @!OMEGA_M!@;
                deltaS  @!SW_DELTA_S!@;
            }
        }
    }

    // Runtime-selectable interface-normal velocity extension (2026-09-26: this case
    // had no block, so no extension could be selected in 3D). It enters the
    // semi-Lagrangian trace only with semiLagrangian.traceFlux extension.
    //   none | closestPoint | meshWave | steadyUpwind | steadyUpwindLinear |
    //   pseudoTime | anisotropicDiffusion
    velocityExtension
    {
        type        @!VELOCITY_EXTENSION!@;
        nLayers     3;
        nAnchorLayers @!ANCHOR_LAYERS!@;
        epsilon      1.0;
        epsilonModel cellSize;
        nIterations 10;        // pseudoTime
        deltaTau    0.2;       // pseudoTime
        nDefCorrExt 5;         // steadyUpwind family: relaxed defect-correction passes
        cpHaloReach 1.5;       // closestPoint: trusted halo reach in cell sizes
        projectFlux false;
        maxScale    5;         // clip |Uext| <= maxScale*max|U| in the band
        // haloLimited only (Phase D4; inert for every other type): the halo-limited
        // directional extension u_H = (1 - w)*u(x) + w*u(Y), Y = x - S_R(d)*e.
        radiusCells   @!HL_RADIUS_CELLS!@;   // the travel cap R in cell sizes (at most 1)
        travel        { type capped;          m    @!HL_M!@; }   // S_R = d/(1 + (d/R)^(2m))^(1/(2m))
        weight        { type fractionReached; beta @!HL_BETA!@; }   // w = (S_R/d)^beta
        direction     { type @!HL_DIRECTION!@; }   // levelSet: d = psi/q, e = grad(psi)/q
        sampler       { type @!HL_SAMPLER!@; }   // stencilFit: least-squares fit of U
    }

    // ===================================================================== //
    // Semi-Lagrangian advection (leiaSemiLagrangeLevelSetFoam only; ignored by
    // leiaLevelSetFoam). psi^{n+1}(x_c) = psi^n(x_d): a fixed Taylor backward
    // foot x_d, a runtime-selectable reconstruction of psi^n at x_d, applied by
    // a runtime-selectable correction strategy. All selectable options and their
    // controls are listed below; unset keys fall back to the defaults shown.
    // ===================================================================== //
    semiLagrangian
    {
        // ---- reconstruction of psi^n at the foot (RTS slReconstruction) ----
        //   linearTaylor                      : psi_c + grad_c.(x-x_c). O(h); gradient injected.
        //   quadraticTaylor (was nestedLSQ)   : field-diff Taylor+Hessian. O(h^2), needs clip.
        //   linearWeightedLeastSquares        : linear VALUE fit. O(h); no curvature.
        //   quadraticWeightedLeastSquares     : IDW-weighted quadratic VALUE fit. O(h^2..3),
        //                                       STABLE. PRODUCTION. Memory-bound (per-cell
        //                                       pseudo-inverse cache).
        //   uncachedQuadraticWeightedLeastSquares : SAME fit as quad (identical accuracy +
        //                                       stability, verified cell-for-cell); recomputes
        //                                       the normal-equations Cholesky per step ->
        //                                       CPU-bound, O(1) memory/cell, no large-N ceiling.
        //   bandQuadraticWeightedLeastSquares : quadratic in the band, linear far field.
        //   defectCorrectedIDW                : IDW + iterated gradient/defect correction.
        //                                       Cheap/CPU-bound but UNSTABLE here. Research.
        scheme              @!SL_SCHEME!@;
        slopeLimiter        @!SL_LIMITER!@;
        venkK               @!SL_VENKK!@;
        fit                 @!SL_FIT!@;
        reconstruction      @!SL_RECONSTRUCTION!@;

        // Reconstruction stencil: point = cell-point-cell (default; required on
        // hex), face = cell-face-cell (polyhedra only -- compact, ~3-4x smaller).
        stencil             @!SL_STENCIL!@;

        // ---- correction strategy (RTS slCorrector) ----
        //   direct             : one reconstruction pass. Use with quadraticWeightedLeastSquares. DEFAULT.
        //   deferredCorrection : fixed-point iteration, rebuilding the reconstruction from the
        //                        current iterate. DIVERGES for defectCorrectedIDW (rho > 1). Research.
        correction          @!SL_CORRECTION!@;

        // Foot-point integrator. taylor (default, historical) needs a velocity
        // GRADIENT for its dt^2 term; rk2 is the classical midpoint using only
        // velocity SAMPLES along the trajectory.
        footIntegrator      @!SL_FOOT_INTEGRATOR!@;

        // Velocity the trajectory is traced with. cellCentred (default,
        // historical) traces the prescribed cell velocity; projectedFlux traces
        // fvc::reconstruct(phi) of the prescribed FLUX. In a kinematic test the
        // prescribed flux is exactly divergence-free, so the solenoidality
        // benefit is zero by construction and this axis measures ONLY what the
        // reconstruct operator costs in transport accuracy -- the question the
        // coupled droplet cases cannot answer. PORTED FROM 2Dvortex 2026-08-31:
        // without this entry the case silently ran the solver default whatever
        // the study config asked for.
        traceVelocity       @!SL_TRACE_VELOCITY!@;
        // Which face flux the projectedFlux trace reconstructs (2026-09-26):
        //   physical  : reconstruct(phi); the default, byte-identical to every earlier run.
        //   extension : reconstruct(phiExt) of the velocityExtension model, so the
        //               extension enters the trace. Needs traceVelocity projectedFlux.
        traceFlux           @!SL_TRACE_FLUX!@;
        CFLmax              @!CFL!@;   // foot-radius guard (operational CFL<=1)
        analyticVelocity    true;      // prescribed velocityModel IS the cell velocity
                                       // (no velocity extension for the prescribed-flow tests)

        // ---- reconstruction safeguards (slReconstruction base; every reconstruction) ----
        limitSlope          false;     // Barth-Jespersen limiter; MEASURED to cost order -> off
        clipToStencilBounds @!SL_CLIP!@;   // tight monotone clip to stencil [min,max];
        clipRegion @!SL_CLIP_REGION!@;   // all | outsideBand -- WHERE the clip may act (see default.parameter)
        clipKeepExtrema @!SL_CLIP_KEEP_EXTREMA!@;   // exempt a cell whose psi is already its stencil's extremum (see default.parameter)
        // The bound on the reconstructed value is a runtime-selected model.
        // fromClipSwitch (the default) follows clipToStencilBounds, so this
        // block is inert until a study overrides SL_VALUE_BOUND. The three
        // cone entries are read by valueBound lipschitzCone only.
        // See cases/default.parameter and workflow/README.md.
        valueBound          @!SL_VALUE_BOUND!@;
        lipschitzMode       @!SL_CONE_L_MODE!@;
        lipschitzConstant   @!SL_CONE_L!@;
        onInadmissible      @!SL_CONE_INADMISSIBLE!@;
                                       // false on hex, true on polyhedra (REQUIRED: bounds a
                                       // near-singular per-cell fit that would else run away)

        // ---- uncachedQuadraticWeightedLeastSquares control ----
        ridgeEps            0;         // Tikhonov ridge on the normal-equations diagonal
                                       // (0 = off; raise on distorted/polyhedral meshes)

        // ---- bandQuadraticWeightedLeastSquares controls ----
        nLayersBand         3;         // quadratic where |psi| <= (nLayersBand+bandGuard)*h
        bandGuard           2;         // guard so band cells' stencils stay inside the band

        // ---- defectCorrectedIDW controls (iterative nodal-defect correction) ----
        idwPower            2;         // final-blend weight = |x_d - x_C|^{-idwPower}
        dcIters             3;         // Gauss-Seidel nodal-defect sweeps
        dcMaxIters          10;        // hard cap on sweeps
        dcTol               1e-3;      // range-relative residual early-out
        dcRelax             0.8;       // under-relaxation of the sweep (<= 1)
        dcRegEps            0.1;       // nugget: wreg = (h^2/(|r|^2 + dcRegEps^2 h^2))^(idwPower/2)

        // ---- deferredCorrection controls (correction = deferredCorrection) ----
        nDefCorr            3;         // deferred-correction passes
        nDefCorrMax         10;        // hard cap on passes
        defCorrRelax        1.0;       // under-relaxation of the fixed-point update (<= 1)
        defCorrTol          0.0;       // range-relative early-out (0 = run all passes)

        // ---- scalar source after the characteristic step (RTS slSource) ----
        // D_t psi = psi*F, applied as psi <- psi*exp(dt*F) in the band
        // |psi|/|grad psi| <= bandCells*h; F = 0 outside the band.
        //   none            : no source (the default; the step is not called).
        //   gradientControl : F from the law below (Phase D3).
        source
        {
            type        @!SL_SOURCE!@;
            bandCells   @!SL_SOURCE_BAND_CELLS!@;
            law
            {
                // F = w(q)*a + G(q) in D_t psi = psi*F; q = |grad psi|, a = n.D.n.
                // G(1) = 0 for every law. A law reads only its own entries, and every
                // entry that a law reads is REQUIRED (no code default).
                //   none | linearQ | linearZ | cubicQ | cubicZ | twoThirdsZReg |
                //   saturatedLinearZ | softWall
                type        @!GC_LAW!@;
                mu          @!GC_MU!@;   // [1/s] rate of the q- and z-laws
                eps         @!GC_EPS!@;   // twoThirdsZReg: G = -mu*zeta/(zeta^2 + eps^2)^(1/6)
                c           @!GC_SAT_C!@;   // saturatedLinearZ: G = -mu*zeta/(1 + c*|zeta|)
                // softWall: G = -cKappa*sqrt(D:D + epsD^2)*tanh[gamma*((q - 1)/deltaS)^p]
                cKappa      @!SW_C_KAPPA!@;
                deltaS      @!SW_DELTA_S!@;
                p           @!SW_P!@;   // odd
                gamma       @!SW_GAMMA!@;   // artanh(0.9)
                epsD        @!SW_EPS_D!@;   // [1/s]
                // The weight w(q) of the strain term a:
                //   none (w = 0) | full (w = 1: the SDPLS R source) |
                //   omega (w = 1 - exp[-beta*((q - 1)/deltaS)^(2m)])
                strainWeight
                {
                    type    @!GC_STRAIN_WEIGHT!@;
                    beta    @!OMEGA_BETA!@;
                    m       @!OMEGA_M!@;
                    deltaS  @!SW_DELTA_S!@;
                }
            }
        }
    }
}


