FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "aliasDict"

ddtSchemes
{
    default         CrankNicolson 1; 
}

gradSchemes
{
    // Metric-only gradient for the gradPsiError / gradPsiErrorCSV function
    // objects. MUST stay UNLIMITED and MUST NOT be the advection scheme's
    // grad(psi): a cell-limited gradient returns exactly 0 at a local
    // extremum, which the metric then reports as |grad psi| = 0.
    gradPsiMetric   leastSquares;
    // SDPLS source-term gradients: dedicated keywords, decoupled from the
    // psi advection gradient (grad(psi)) and the unnamed grad(U) fallback.
    gradPsiSdpls    leastSquares;
    gradUSdpls      Gauss linear;
    // signedDistanceBounds redistancing criterion gradient (decoupled from
    // the psi advection scheme's limiter)
    redistGradPsi   leastSquares;
    default         Gauss linear;
    grad(p)         Gauss linear;
    // Semi-Lagrangian reconstruction (leiaSemiLagrangeLevelSetFoam): dedicated
    // point-cell-point least-squares gradient keys for the foot reconstruction,
    // so the SL sub-steps never share the grad(psi) advection scheme.
    gradPsi         pointCellsLeastSquares;   // g_c = grad(psi^n)
    gradGradPsi     pointCellsLeastSquares;   // H_c = grad(g_c) (quadraticTaylor)
    gradU           Gauss linear;   // grad(u^{n+1}) for the SL foot (Gauss linear: no run-long LSQ cache)
}

divSchemes
{
    default         none;
    div(phi,psi)    Gauss @!DIV!@;
    // anchoredEikonal redistancer: steady-Eikonal fill transport along nHat.
    div(yPhi,psiDist) Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

fluxRequired
{
    p;
}

