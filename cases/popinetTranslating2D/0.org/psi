dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet   { type zeroGradient; }   // interior droplet stays far from boundaries
    outlet  { type zeroGradient; }
    walls   { type zeroGradient; }

    frontAndBack
    {
        type            empty;
    }
}

