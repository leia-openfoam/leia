FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Popinet (JCP 228, 2009, Sec. 6.2.2) translating droplet, 2D. The box is
// POPINET_XLEN box heights long and one cell thick (empty front and back).
//
// SI UNITS (2026-09-08). DOMAIN_LENGTH is the box HEIGHT in metres, 2.5e-3 m.
// The droplet diameter is 0.4 of that height, D = 1 mm, as in Popinet. The cell
// size is h = DOMAIN_LENGTH/N_CELLS, and the capillary time step follows
// materialize.py at nRef = CAPILLARY_REF_LENGTH/h. See workflow/scripts/popinet_si.py
// for the full parameter set and for the dimensionless groups it holds fixed.
//
// POPINET_XLEN is an ASPECT RATIO, not a length: the box length is
// POPINET_XLEN * DOMAIN_LENGTH. POPINET_NX is the cell count in x, so
// POPINET_NX = POPINET_XLEN * N_CELLS keeps the cells cubic.
//
// The empty direction is 2 % of the box height. It is inert with empty
// front and back patches, but it must scale with the box, or the cell volume
// V and every V-derived quantity changes with the unit system.

scale   1;

n_cells @!N_CELLS!@;          // cells across the box HEIGHT -> h = ylen/n_cells
n_cells_x @!POPINET_NX!@;     // = POPINET_XLEN*n_cells; keeps the cells cubic
ylen    @!DOMAIN_LENGTH!@;    // box height [m]; Popinet's unit-square height
xlen    #eval{ @!POPINET_XLEN!@ * $ylen };   // aspect ratio x height [m]
zneg    #eval{ -0.01 * $ylen };              // empty direction, 2 % of the height
zpos    #eval{  0.01 * $ylen };

vertices
(
    (0      0      $zneg)
    ($xlen  0      $zneg)
    ($xlen  $ylen  $zneg)
    (0      $ylen  $zneg)
    (0      0       $zpos)
    ($xlen  0       $zpos)
    ($xlen  $ylen   $zpos)
    (0      $ylen   $zpos)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($n_cells_x $n_cells 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    // INFLOW / OUTFLOW, split 2026-09-02. Until this commit all four sides were
    // one `walls` patch of type `wall`, so the mesh had NO inlet and NO outlet --
    // while every field in 0.org has always declared both. OpenFOAM errors when a
    // MESH patch is missing from a field but silently ignores a FIELD entry that
    // matches no mesh patch, so `inlet { fixedValue (U0 0 0); }` was read, parsed
    // and discarded on every run this case has ever done.
    //
    // The case was therefore a CLOSED BOX with slip walls. Slip imposes U.n = 0,
    // and on the x-normal faces the normal IS x, so the uniform stream the case is
    // initialised with is incompatible with its own boundaries: the pressure
    // projection annihilated it on step 1 (first-step local continuity error
    // 1.0e-05 against 1.6e-12 by step 3), leaving the ambient at rest
    // (mean Ux = -2.0e-03) and the droplet coasting through still air at
    // Ux = +6.1e-02, with a domain mean of -7.3e-07 as a closed box must have.
    // maxMagUPrime = max|U - (U0,0,0)| then measured the ANNIHILATED FREE STREAM,
    // not a spurious current, and read ~2*U0 from the first step onwards.
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)   // left,  x = 0
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)   // right, x = domain
        );
    }

    // Free-slip top and bottom: a uniform stream with no wall shear, which is what
    // the translation gate needs. These two are the ONLY sides that stay `wall`.
    walls
    {
        type wall;
        faces
        (
            (3 7 6 2)   // top,    y = domain
            (1 5 4 0)   // bottom, y = 0
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)   // back
            (4 5 6 7)   // front
        );
    }
);

mergePatchPairs
(
);

