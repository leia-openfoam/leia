FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue psi 1
);

regions
(
    cylinderToCell
    {
        radius   0.25;
         p1      (0.5 -1 0.5);
         p2      (0.5 1 0.5);

        fieldValues
        (
            volScalarFieldValue psi -1
        );
    }
);
