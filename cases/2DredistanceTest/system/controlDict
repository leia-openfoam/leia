FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     leiaTestRedistance;

startFrom       startTime;

startTime       0;

stopAt          writeNow;

endTime         2; 

maxCo           0.5;

deltaT          2;

adjustTimeStep  yes;

writeControl    runTime;

writeInterval   2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  14;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs ("libleiafiniteVolume.so");


