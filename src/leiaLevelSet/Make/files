/* libleiaCore -- what every leia binary needs: the level-set profile, the narrow
   band, the phase indicator, the prescribed velocity models and the version
   registry. The method libraries (sdplsSource, semiLagrangian, velocityExtension,
   redistancer, volumeCorrection, surfaceTensionForce, advection) each have their
   own Make/ in their directory below this one and link this library; the graph is
   in docs/plan-library-split-and-build-policy.md (WP3) and is checked by
   etc/leia-check-deps.py before every build. schemes/levelSetBlended is not
   compiled (it was not in the monolith either). */

phaseIndicator/phaseIndicator.C
phaseIndicator/heavisidePhaseIndicator.C
phaseIndicator/sharpJumpPhaseIndicator.C
phaseIndicator/levelSetPlaneReconstruction.C
phaseIndicator/geometricPhaseIndicator.C
phaseIndicator/detrixheAslamPhaseIndicator.C

narrowBand/narrowBand.C
narrowBand/emptyNarrowBand.C
narrowBand/signChangeNarrowBand.C
narrowBand/neighbourNarrowBand.C
narrowBand/phaseIndicatorNarrowBand.C
narrowBand/distanceNarrowBand.C

profile/profile.C
profile/signedDistance.C
profile/tanh.C

velocityModel/velocityModel.C
velocityModel/prescribedVelocityModels.C
velocityModel/fluxCorrection.C

leiaVersionRegistry.C
leiaStamp_leiaCore.C

LIB = $(FOAM_USER_LIBBIN)/libleiaCore
