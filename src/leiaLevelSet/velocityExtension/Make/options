EXE_INC = \
    -std=c++17 \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/surfMesh/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/fvOptions/lnInclude \
    -I../../vof \
    -I../lnInclude \
    -I../../levelSetImplicitSurfaces/lnInclude

/* --no-undefined: a symbol used from a library that is not in LIB_LIBS fails THIS
   link instead of surfacing when a solver loads the library (WP3 gate). */
LIB_LIBS = \
    -Wl,--no-undefined \
    -L$(FOAM_USER_LIBBIN) \
    -lOpenFOAM \
    -lfiniteVolume \
    -lsurfMesh \
    -lmeshTools \
    -lfvOptions \
    -llevelSetImplicitSurfaces \
    -lleiaCore \
    -lleiaSemiLagrangian
