EXE_INC = \
    -std=c++17 \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/surfMesh/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/transportModels/geometricVoF/lnInclude \
    -I../lnInclude

/* OpenFOAM's own libgeometricVoF for cutCellPLIC (the polygon of a plane in a
   cell); libsampling for the sampledSurface base. --no-undefined as in every
   leia library. */
LIB_LIBS = \
    -Wl,--no-undefined \
    -L$(FOAM_USER_LIBBIN) \
    -lOpenFOAM \
    -lfiniteVolume \
    -lmeshTools \
    -lsurfMesh \
    -lsampling \
    -lgeometricVoF \
    -lleiaCore
